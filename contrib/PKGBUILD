# Maintainer: Martin Trojer <martin.trojer@gmail.com>
#
# Reference PKGBUILD for the AUR package. Build and lint it with an Arch
# container before publishing:
#
#   distrobox create --name arch-pkg --image docker.io/library/archlinux:latest
#   distrobox enter arch-pkg -- bash -lc 'sudo pacman -S --needed base-devel namcap'
#   cd contrib && makepkg -s && namcap PKGBUILD *.pkg.tar.zst
#
# Publishing needs an AUR account with an SSH key; see
# https://wiki.archlinux.org/title/AUR_submission_guidelines

pkgname=swayward
pkgver=26.10.0beta1
_tagver=26.10.0-beta.1
pkgrel=1
pkgdesc="An i3/sway-compatible Wayland compositor, built in Rust on Smithay"
arch=('x86_64' 'aarch64')
url="https://github.com/swayward-wm/swayward"
license=('GPL-3.0-or-later')

# Arch enables LTO by default. libspa-sys generates a C shim for SPA's static
# inline functions (wrap_static_fns), and LTO discards those objects before
# the Rust side links against them, so the build fails with
# "undefined symbol: spa_format_parse_libspa_rs" and friends. Reproduced on a
# clean archlinux:latest container; unrelated to the libpipewire version.
options=('!lto')

depends=(
  'bash'          # swayward-session is a shell script
  'cairo'
  'libdisplay-info'
  'libinput'
  'libxkbcommon'
  'mesa'          # libgbm.so.1, libEGL
  'pango'
  'python'        # swayward-sway-to-kdl
  'libpipewire'   # libspa-0.2.pc and libpipewire-0.3.so; the `pipewire`
                  # package is the daemon and does not carry them
  'seatd'         # libseat.so.1
  'systemd-libs'
  # namcap reports wayland as possibly unneeded because nothing links it at
  # build time: src/main.rs dlopens libwayland-server.so.0 with RTLD_NOLOAD
  # to set the max buffer size. It is required at runtime.
  'wayland'
)

makedepends=(
  'cargo'
  'clang'
  'git'
)

# The Rust fixture suite compiles real XKB keymaps. libxkbcommon is the
# library; the keymap data is a separate Arch package. Titlebar tests measure
# text, so they need a font.
checkdepends=(
  'xkeyboard-config'
  'ttf-dejavu'
)

optdepends=(
  'xwayland-satellite: Xwayland support'
  'xdg-desktop-portal-gtk: default backend for general desktop portals'
  'xdg-desktop-portal-gnome: integrated window and monitor capture backend'
  'xdg-desktop-portal-wlr: optional ScreenCast and Screenshot fallback'
  'gnome-keyring: Secret portal'
  'waybar: status bar, works unmodified against swayward IPC'
  'fuzzel: application launcher bound in the default config'
  'foot: terminal bound in the default config'
  'swaylock: screen locker'
  'swayidle: idle management'
  'swaybg: wallpaper'
  'mako: notifications'
  'sway: provides swaymsg; swayward ships swaywardmsg, so this is optional'
)

source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/swayward-v$_tagver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Exclude swayward-visual-tests: it is a GTK4 developer tool, not part of
  # the compositor, and building it would drag gtk4 and gdk-pixbuf into the
  # package's build dependencies for no runtime benefit.
  cargo build --frozen --release \
    --workspace --exclude swayward-visual-tests
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # The i3 conformance suite needs Perl modules that are not build
  # dependencies, so run the Rust tests only.
  # makepkg's unprivileged user defaults to 1024 open files even when the
  # container's hard limit is much higher. The Wayland fixture suite exceeds
  # that over its lifetime and then cascades into misleading BadKeymap and
  # allocation failures. CI already runs the parallel gate; package validation
  # uses a modest raised soft limit and runs serially.
  ulimit -n 8192
  # Tests that read the network-fetched sway-ipc-oracle checkout cannot run
  # from a release tarball; CI and the Ubuntu release job run them.
  cargo test --frozen --release --lib \
    -p swayward -p swayward-ipc -p swayward-config -- --test-threads=1 --exact \
    --skip tests::i3_conformance::docs_checks::coverage_data_validates_completely \
    --skip tests::i3_conformance::harness_tests::harness_does_not_convert_wrong_named_assertions_into_skips \
    --skip tests::i3_conformance::harness_tests::harness_skips_only_i3_invalid_criteria_wording \
    --skip tests::i3_conformance::harness_tests::harness_xcb_xkb_guard_does_not_depend_on_the_host \
    --skip tests::i3_conformance::manifest::passing_manifest_is_sorted_and_unique \
    --skip tests::i3_conformance::runner::i3_conformance_runner \
    --skip tests::ipc::binding_modes_switch_binds_emit_events_and_list_over_ipc \
    --skip tests::ipc::captured_window_map_sequences_pin_focus_order_and_multiplicity \
    --skip tests::ipc::captured_workspace_event_sequences_pin_order_and_multiplicity \
    --skip tests::ipc::close_event_matches_captured_sway_schema_before_removal \
    --skip tests::ipc::closing_last_window_removes_inactive_named_workspace_from_ipc \
    --skip tests::ipc::directional_move_emits_one_settled_sway_move_event \
    --skip tests::ipc::floating_stacking_and_focus_match_sway_before_and_after_raise \
    --skip tests::ipc::get_inputs_and_seats_return_sway_schema_and_values \
    --skip tests::ipc::get_tree_node_keys_all_appear_in_sway_fixtures \
    --skip tests::ipc::libinput_object_has_every_sway_field_for_touchpads_and_mice \
    --skip tests::ipc::live_floating_tree_matches_sway_roles \
    --skip tests::ipc::live_get_tree_matches_sway_schema_and_values \
    --skip tests::ipc::live_ipc_focus_matches_sway_mru_arrays \
    --skip tests::ipc::live_ipc_percent_matches_sway_parent_shares \
    --skip tests::ipc::live_ipc_rectangle_roles_match_sway_relationships \
    --skip tests::ipc::live_workspace_output_and_marks_match_sway \
    --skip tests::ipc::mark_event_matches_captured_sway_schema \
    --skip tests::ipc::marks_round_trip_through_commands_get_marks_and_tree \
    --skip tests::ipc::normalized_fixture_comparison_rejects_every_retained_value \
    --skip tests::ipc::oracle_fixture_contents_are_owned \
    --skip tests::ipc::reloaded_gap_defaults_do_not_change_an_existing_workspace \
    --skip tests::ipc::reload_rereads_config_and_emits_the_sway_workspace_event \
    --skip tests::ipc::tree_fixture_comparators_reject_a_missing_or_extra_child \
    --skip tests::ipc::tree_fixture_comparison_rejects_every_rectangle_coordinate \
    --skip tests::ipc::workspace_focus_spans_tiled_and_floating_children \
    --skip tests::ipc::workspace_move_event_matches_sway_shape \
    --skip tests::ipc::workspace_rename_event_matches_sway_shape \
    --skip tests::ipc::workspace_urgency_event_matches_sway_shape \
    --skip tests::ipc::workspace_window_and_mode_events_match_sway_shapes \
    --skip tree::tests::a_view_missing_a_view_field_does_not_decode_as_a_plain_node \
    --skip tree::tests::round_trips_all_real_sway_fixtures_without_schema_drift
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 target/release/swayward "$pkgdir/usr/bin/swayward"
  install -Dm755 target/release/swaywardmsg "$pkgdir/usr/bin/swaywardmsg"
  install -Dm755 resources/swayward-session "$pkgdir/usr/bin/swayward-session"
  # The config translator is useless from a source checkout nobody has after
  # installing a package, so ship it on PATH under a namespaced name.
  install -Dm755 contrib/sway-to-kdl "$pkgdir/usr/bin/swayward-sway-to-kdl"

  install -Dm644 resources/swayward.desktop \
    "$pkgdir/usr/share/wayland-sessions/swayward.desktop"
  install -Dm644 resources/swayward-portals.conf \
    "$pkgdir/usr/share/xdg-desktop-portal/swayward-portals.conf"
  install -Dm644 resources/swayward.service \
    "$pkgdir/usr/lib/systemd/user/swayward.service"
  install -Dm644 resources/swayward-shutdown.target \
    "$pkgdir/usr/lib/systemd/user/swayward-shutdown.target"

  install -Dm644 resources/default-config.kdl \
    "$pkgdir/usr/share/swayward/default-config.kdl"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
