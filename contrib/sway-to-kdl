# ---------------------------------------------------------------------------
# Reader
#
# read_config segments a file into logical lines and blocks by sway 1.12's
# rules (sway/config.c:666-869). It expands no variables and runs no
# includes: sway runs both as directives, in source order, so the front end
# does. Nothing calls read_config yet. The front end reads with LegacyReader,
# today's segmentation, which the goldens record; C3 switches it over.
# ---------------------------------------------------------------------------


@dataclass(frozen=True)
class Pos:
    path: Path
    line: int  # first physical line; 0 = whole file (as warn() reports it)


@dataclass(frozen=True)
class Line:
    text: str  # logical line: continuation joined, stripped
    raw: tuple[str, ...]  # the physical lines it came from, unstripped
    pos: Pos


@dataclass
class Block:
    header: Line  # text without the trailing "{"
    body: list[Line | Block]
    raw: tuple[str, ...]  # header through closing line
    end: Line | None = None  # the closing line; None if the file ended first


def _physical_lines(data: str) -> list[str]:
    """getline's view of a file: split after each "\\n", which stays."""
    lines = data.split("\n")
    physical = [line + "\n" for line in lines[:-1]]
    if lines[-1]:
        physical.append(lines[-1])
    return physical


def read_config(path: Path) -> list[Line | Block]:
    r"""Sway's line and block rules (`read_config`, sway/config.c:732-869).

    - A physical line ending in `\` and a newline is joined with the next,
      whose leading whitespace stays, unless its first byte is `#`
      (`getline_with_cont`, :666-694). The result is cut at a NUL, stripped,
      and skipped when blank or starting with `#`; a later `#` is text.
    - A line opens a block when the last `split_args` token of the line as
      config_command sees it is `{` and there are at least two tokens
      (sway/commands.c:355-360). Inside a block the header prefix supplies
      the first token (`expand_line`, config.c:719-729), so a lone `{`
      opens one.
    - A line whose last character is neither `{` nor `}` takes " {" from the
      next nonblank physical line when that line is exactly `{`
      (`detect_brace`, :696-717). Blank lines before it are consumed; a
      comment stops the search. The " {" joins the line before it is split,
      so `x "abc` swallows the `{` into its open quote and opens nothing.
    - A last token of `}` closes the innermost block
      (sway/commands.c:362-366), whatever precedes it: `X { a }` closes the enclosing block,
      and at top level it is an unmatched `}` (config.c:842-846) that this
      returns as a Line. A block still open at the end of the file ends
      there with no `end`, as sway's stack is dropped silently.

    The `<commands>` dispatch at config.c:805-807 is unreachable in sway 1.12:
    no handler returns CMD_BLOCK_COMMANDS, so it is not modelled.

    Bytes are decoded as UTF-8 with surrogateescape and only "\n" ends a line,
    as with getline. A header's text drops the `{` token and the whitespace
    before it, unless escaped (`\ {`); join_args over its split_args tokens
    is sway's block name. A header's raw includes the blank and `{` lines
    detect_brace consumed, and Block.raw every physical line from the header
    through the closing line, comments included.
    """
    physical = _physical_lines(path.read_bytes().decode("utf-8", "surrogateescape"))
    raw = [line[:-1] if line.endswith("\n") else line for line in physical]
    top: list[Line | Block] = []
    stack: list[tuple[Block, int]] = []  # open blocks, with their first index
    index = 0
    while index < len(physical):
        start = index
        buffer = physical[index]
        index += 1
        while (
            buffer.endswith("\\\n")
            and not buffer.startswith("#")
            and index < len(physical)
        ):
            buffer = buffer[:-2] + physical[index]
            index += 1
        text = _c_string(buffer).strip(SWAY_WHITESPACE)
        if not text or text.startswith("#"):
            continue
        if text[-1] not in "{}":
            probe = index
            while probe < len(physical):
                candidate = _c_string(physical[probe]).strip(SWAY_WHITESPACE)
                probe += 1
                if candidate:
                    if candidate == "{":
                        text += " {"
                        index = probe
                    break
        line = Line(text, tuple(raw[start:index]), Pos(path, start + 1))
        parent = stack[-1][0].body if stack else top
        tokens = split_args(text)
        if tokens and tokens[-1] == "{" and (len(tokens) > 1 or stack):
            name = text[:-1].rstrip(SWAY_WHITESPACE)
            if (len(name) - len(name.rstrip("\\"))) % 2:
                name = text[: len(name) + 1]  # `\ {`: the space is escaped
            block = Block(Line(name, line.raw, line.pos), [], ())
            parent.append(block)
            stack.append((block, start))
        elif tokens and tokens[-1] == "}" and stack:
            block, first = stack.pop()
            block.end = line
            block.raw = tuple(raw[first:index])
        else:
            parent.append(line)
    for block, first in stack:
        block.raw = tuple(raw[first:])
    return top


def expand_line(block: str | None, line: str, add_brace: bool) -> str:
    """Sway's `expand_line` (sway/config.c:719-729)."""
    prefix = f"{block} " if block is not None else ""
    return prefix + line + (" {" if add_brace else "")


def flatten(
    nodes: list[Line | Block], block: str | None = None
) -> Iterator[tuple[Line, str]]:
    """The lines read_config hands config_command, with sway's prefix.

    Yields (line, expanded) for every node in read order: a block's header
    (with " {"), its body, and its closing line. Inside a block the prefix is
    the block name, join_args over the header's tokens, and it accumulates:
    `bar {` + `colors {` + `a` runs `bar colors a`. Tokens match sway's;
    whitespace inside an explicit header line is collapsed.
    """
    for node in nodes:
        if isinstance(node, Line):
            yield node, expand_line(block, node.text, False)
            continue
        yield node.header, expand_line(block, node.header.text, True)
        name = join_args(split_args(expand_line(block, node.header.text, False)))
        yield from flatten(node.body, name)
        if node.end is not None:
            yield node.end, expand_line(name, node.end.text, False)


class LegacyReader:
    """Today's segmentation, which the goldens record; C2 only.

    next_line is the loop that opened Translator.parse and scan_block its
    block() helper, both moved verbatim behind a cursor over the file's
    physical lines. A continuation is joined as `text[:-1] + " " +
    next.strip()`, and never inside a block body. A block's extent is a raw
    count of `{` and `}` on physical lines, quoted or commented ones
    included. take_block builds a Block whose raw is today's block list: the
    expanded header first, then stripped physical lines, blanks and comments
    kept. As today, the last line taken counts as the closing line even when
    the file ended first.
    """

    def __init__(self, path: Path, lines: list[str]) -> None:
        self.path = path
        self.lines = lines
        self.index = 0
        self.last: Line | None = None

    @classmethod
    def open(cls, path: Path) -> LegacyReader:
        return cls(path, path.read_text().splitlines())

    def next_line(self) -> Line | None:
        lines = self.lines
        index = self.index
        self.last = None
        while index < len(lines):
            line_no = index + 1
            text = lines[index].strip()
            index += 1
            if not text or text.startswith("#"):
                continue
            while text.endswith("\\") and index < len(lines):
                text = text[:-1] + " " + lines[index].strip()
                index += 1
            self.last = Line(
                text, tuple(lines[line_no - 1 : index]), Pos(self.path, line_no)
            )
            break
        self.index = index
        return self.last

    def take_block(self, first: str) -> Block:
        """The block opened by the line next_line just returned.

        `first` is that line as the caller matched it, variables expanded.
        """
        assert self.last is not None, "take_block follows next_line"
        start = self.index
        block, self.index = self.scan_block(self.lines, start, first)
        lines = [
            Line(text, (self.lines[index],), Pos(self.path, index + 1))
            for index, text in enumerate(block[1:], start)
        ]
        header = first[:-1].rstrip() if first.endswith("{") else first
        return Block(
            Line(header, self.last.raw, self.last.pos),
            list(lines[:-1]),
            tuple(block),
            lines[-1] if lines else None,
        )

    def block(self, first: str) -> list[str]:
        """Stand-in for Translator.block in S2: today's block list."""
        return list(self.take_block(first).raw)

    @staticmethod
    def scan_block(lines: list[str], index: int, first: str) -> tuple[list[str], int]:
        block = [first]
        depth = first.count("{") - first.count("}")
        while depth > 0 and index < len(lines):
            line = lines[index]
            block.append(line.strip())
            depth += line.count("{") - line.count("}")
            index += 1
        return block, index


# ---------------------------------------------------------------------------
# Lexer
#
# Ports of sway 1.12's argument primitives, one function per C function, with
# their quirks kept: a backslash toggles the escape state, brackets nest one
# level deep, and unescape_string's "\0" truncates. The C functions work on
# NUL-terminated bytes, so every port first cuts its input at the first NUL.
# Python strings hold code points rather than bytes; every character sway
# treats specially is ASCII, so the two agree except where noted.
# ---------------------------------------------------------------------------

# `whitespace` in common/stringop.c:13, and isspace() in the C locale.
SWAY_WHITESPACE = " \f\n\r\t\v"


def _c_string(s: str) -> str:
    return s.split("\0", 1)[0]


def split_args(s: str) -> list[str]:
    """Sway's `split_args` (common/stringop.c:92-143).

    Splits on runs of whitespace outside '...', "..." and one level of [...].
    Quote characters and backslashes stay in the tokens, and a backslash makes
    the next character literal, including whitespace.
    """
    s = _c_string(s)
    argv: list[str] = []
    in_token = in_string = in_char = in_brackets = escaped = False
    start = end = 0
    while start < len(s):
        if not in_token:
            while end < len(s) and s[end] in SWAY_WHITESPACE:
                end += 1
            start = end
            in_token = True
        ch = s[end] if end < len(s) else ""
        if ch == '"' and not in_char and not escaped:
            in_string = not in_string
        elif ch == "'" and not in_string and not escaped:
            in_char = not in_char
        elif (
            ch == "["
            and not in_string
            and not in_char
            and not in_brackets
            and not escaped
        ):
            in_brackets = True
        elif (
            ch == "]" and not in_string and not in_char and in_brackets and not escaped
        ):
            in_brackets = False
        elif ch == "\\":
            escaped = not escaped
        elif ch == "" or (
            not in_string
            and not in_char
            and not in_brackets
            and not escaped
            and ch in SWAY_WHITESPACE
        ):
            if end > start:
                argv.append(s[start:end])
            in_token = False
            escaped = False
            continue
        if ch != "\\":
            escaped = False
        end += 1
    return argv


def strip_quotes(s: str) -> str:
    """Sway's `strip_quotes` (common/stringop.c:26-50).

    Deletes every unescaped quote character that opens or closes a quoted
    run, wherever it is; a ' inside "..." stays, and so do backslashes.
    """
    out: list[str] = []
    in_str = in_chr = escaped = False
    for ch in _c_string(s):
        if ch == "'" and not in_str and not escaped:
            in_chr = not in_chr
            continue
        if ch == '"' and not in_chr and not escaped:
            in_str = not in_str
            continue
        if ch == "\\":
            escaped = not escaped
        else:
            escaped = False
        out.append(ch)
    return "".join(out)


def argsep(s: str, delims: str) -> tuple[str, str, str | None]:
    r"""Sway's `argsep` (common/stringop.c:267-312), without the in-place edit.

    Returns (segment, matched, rest): the text before the first delimiter
    outside quotes, that delimiter ("" at the end of input), and the text
    after it (None at the end of input, where C sets *stringp to NULL).
    Delimiters before any other character are skipped. An escape lasts while
    the characters sway inspects are adjacent, so in `\";` the ';' is
    escaped too.
    """
    s = _c_string(s)
    start = end = 0
    in_string = in_char = escaped = False
    while True:
        # argsep_next_interesting (:255-265): the first quote, backslash or
        # delimiter at or after end.
        interesting = next(
            (i for i in range(end, len(s)) if s[i] in "\"'\\" or s[i] in delims),
            None,
        )
        if interesting is None:
            return s[start:], "", None
        if escaped and interesting != end:
            escaped = False
        ch = s[interesting]
        if ch == '"' and not in_char and not escaped:
            in_string = not in_string
            end = interesting + 1
        elif ch == "'" and not in_string and not escaped:
            in_char = not in_char
            end = interesting + 1
        elif ch == "\\":
            escaped = not escaped
            end = interesting + 1
        elif not in_string and not in_char and not escaped:
            end = interesting
            if end - start:
                return s[start:end], ch, s[end + 1 :]
            start += 1
            end = start
        else:
            end += 1


_UNESCAPES = {
    "a": "\a",
    "b": "\b",
    "f": "\f",
    "n": "\n",
    "r": "\r",
    "t": "\t",
    "v": "\v",
    "'": "'",
    '"': '"',
    "?": "?",
}


def unescape_string(s: str) -> str:
    r"""Sway's `unescape_string` (common/stringop.c:152-234).

    C overwrites each escape with NUL holes and shifts them out at the end,
    which this port mirrors with "\0" in a list. Hence the quirks:

    - `\0` returns at once, before the shift, so the result ends at the first
      hole: `a\tb\0` gives "a\t".
    - `\x` reads at most two decimal digits as hex. A digit leaves a hole
      where the scan continues, so no escape after it is processed.
    - An unknown escape stays as written, and `\\` becomes one backslash.

    A trailing backslash makes C read past the terminator (undefined); the
    port keeps the backslash. `\x80` to `\x99` yield one byte in C and the
    code point of that value here.
    """
    buf = list(_c_string(s))
    n = len(buf)
    i = 0
    while i < n and buf[i] != "\0":
        if buf[i] == "\\":
            i += 1
            if i == n:
                break
            ch = buf[i]
            if ch == "0":
                buf[i - 1] = "\0"
                return "".join(buf).split("\0", 1)[0]
            if ch in _UNESCAPES:
                buf[i - 1] = _UNESCAPES[ch]
                buf[i] = "\0"
            elif ch == "\\":
                buf[i] = "\0"
            elif ch == "x":
                value = 0
                if i + 1 < n and "0" <= buf[i + 1] <= "9":
                    value = ord(buf[i + 1]) - ord("0")
                    if i + 2 < n and "0" <= buf[i + 2] <= "9":
                        value = value * 0x10 + ord(buf[i + 2]) - ord("0")
                        buf[i + 2] = "\0"
                    buf[i + 1] = "\0"
                buf[i] = "\0"
                buf[i - 1] = chr(value)
        i += 1
    return "".join(ch for ch in buf if ch != "\0")


def join_args(args: list[str]) -> str:
    """Sway's `join_args` (common/stringop.c:236-253).

    C asserts argc > 0 and returns NULL; this raises ValueError instead.
    """
    if not args:
        raise ValueError("argc should be positive")
    return " ".join(args)


@dataclass
class Command:
    criteria: str | None  # raw "[...]" token, valid for its ';' segment
    argv: list[str]  # split_args tokens, quotes kept


class CriteriaError(ValueError):
    """A criteria block sway's criteria_parse rejects; sway runs nothing."""


def criteria_length(s: str) -> int:
    """Length of the raw "[...]" at the start of s, as criteria_parse scans it
    (sway/criteria.c:780-871).

    Only the extent is ported. Token names and values are not validated, so
    `[foo=bar]` passes here while sway rejects it; an empty name stops the scan
    with sway's error, since C would make no progress on it either.
    """
    head = 0

    def skip_spaces() -> None:  # :746-750, spaces only
        nonlocal head
        while head < len(s) and s[head] == " ":
            head += 1

    skip_spaces()
    if not s.startswith("[", head):
        raise CriteriaError("No criteria")
    head += 1
    tokens = 0
    while head < len(s) and s[head] != "]":
        skip_spaces()
        name_start = head
        while head < len(s) and ("a" <= s[head] <= "z" or s[head] == "_"):
            head += 1
        name = s[name_start:head]
        skip_spaces()
        if s.startswith("=", head):
            head += 1
            skip_spaces()
            in_quotes = s.startswith('"', head)
            if in_quotes:
                head += 1
                while head < len(s) and (s[head] != '"' or s[head - 1] == "\\"):
                    head += 1
                if head == len(s):
                    raise CriteriaError("Quote mismatch in criteria")
                head += 1
            else:
                while head < len(s) and s[head] not in " ]":
                    head += 1
        if not name:
            raise CriteriaError(f"Token '{name}' is not recognized")
        tokens += 1
        skip_spaces()
    if head == len(s):
        raise CriteriaError("No closing brace found in criteria")
    if not tokens:
        raise CriteriaError("Criteria is empty")
    return head + 1


def split_command_list(s: str) -> list[Command]:
    """The command-list loop of sway's `execute_command`
    (sway/commands.c:205-335).

    Criteria are parsed only at the start of a ';' segment and apply to every
    ',' command in it. Segments are cut with argsep(";,") and empty ones are
    skipped. Quotes are not stripped: sway does that per command, after
    looking at argv[0] (:264-272).
    """
    commands: list[Command] = []
    head: str | None = _c_string(s)
    matched = ";"
    criteria: str | None = None
    while head is not None:
        head = head.lstrip(SWAY_WHITESPACE)
        if matched == ";":
            criteria = None
            if head.startswith("["):
                length = criteria_length(head)
                criteria = head[:length]
                head = head[length:].lstrip(SWAY_WHITESPACE)
        segment, matched, head = argsep(head, ";,")
        segment = segment.lstrip(SWAY_WHITESPACE)
        if not segment:
            continue
        commands.append(Command(criteria, split_args(segment)))
    return commands


# ---------------------------------------------------------------------------
# Front end
#
# Variables, includes and the set of files already read, handled in source
# order as sway does. run() reads each file with LegacyReader, handles set
# and include itself, and yields a Directive for every other logical line,
# expanded, with the reader, so a block handler can take the block the line
# opens.
# ---------------------------------------------------------------------------

# config_command keeps quotes in these handlers' arguments
# (sway/commands.c:409-423).
QUOTED_ARGUMENT_COMMANDS = frozenset(
    {
        "exec",
        "exec_always",
        "mode",
        "bindsym",
        "bindcode",
        "bindswitch",
        "bindgesture",
        "set",
        "for_window",
    }
)


@dataclass
class Directive:
    name: str  # argv[0] as written
    argv: list[str]  # split_args after expansion, quotes kept
    # config_command's view of argv[1:]: unescaped, with quotes stripped
    # except under QUOTED_ARGUMENT_COMMANDS; set's variable name is left alone.
    args: list[str]
    text: str  # expanded logical text: today's string, used in messages
    pos: Pos
    # Always None until the front end reads blocks itself: the block handlers
    # still take theirs from the LegacyReader.
    block: Block | None = None

    @classmethod
    def from_line(cls, text: str, pos: Pos) -> Directive:
        argv = split_args(text)
        name = argv[0] if argv else ""
        command = name.lower()  # find_core_handler ignores case
        first = 2 if command == "set" else 1
        args = argv[1:first]
        for arg in argv[first:]:
            if command not in QUOTED_ARGUMENT_COMMANDS and arg.startswith(
                ('"', "'")
            ):
                arg = strip_quotes(arg)
            args.append(unescape_string(arg))
        return cls(name, argv, args, text, pos)


class Frontend:
    def __init__(self) -> None:
        self.variables: dict[str, str] = {}
        self.visited: set[Path] = set()

    def expand(self, text: str) -> str:
        variables = sorted(self.variables, key=len, reverse=True)
        output: list[str] = []
        index = 0
        while index < len(text):
            if text[index : index + 2] == "$$":
                output.append(r"\$")
                index += 2
                continue
            if text[index : index + 2] == r"\$":
                output.append(r"\$")
                index += 2
                continue
            name = next(
                (name for name in variables if text.startswith(name, index)), None
            )
            if name is not None:
                output.append(self.variables[name])
                index += len(name)
                continue
            output.append(text[index])
            index += 1
        return "".join(output)

    def run(
        self, path: Path, doc: Translator
    ) -> Iterator[tuple[Directive, LegacyReader]]:
        path = path.expanduser().resolve()
        if path in self.visited:
            return
        try:
            reader = LegacyReader.open(path)
        except OSError as error:
            doc.warn(path, 0, "include", f"cannot read include: {error}")
            return
        self.visited.add(path)

        while (line := reader.next_line()) is not None:
            line_no = line.pos.line
            text = line.text

            if re.fullmatch(r"set\s*\{", text):
                block = reader.block(text)
                self.translate_set_block(doc, path, line_no, block[1:-1])
                continue
            if match := re.fullmatch(r"set\s+(\$+[^\s]+)\s+(.+)", text):
                value = self.expand(match.group(2).strip())
                self.variables[match.group(1)] = value.replace(r"\$", "$")
                continue
            text = self.expand(text).replace(r"\$", "$")

            if text.startswith("include "):
                yield from self.translate_include(doc, path, line_no, text)
                continue
            yield Directive.from_line(text, line.pos), reader

    def translate_set_block(
        self, doc: Translator, source: Path, line: int, body: list[str]
    ) -> None:
        for offset, item in enumerate(body, 1):
            item = item.strip()
            if not item or item.startswith("#"):
                continue
            if match := re.fullmatch(r"(\$+[^\s]+)\s+(.+)", item):
                value = self.expand(match.group(2).strip())
                self.variables[match.group(1)] = value.replace(r"\$", "$")
            else:
                doc.warn(source, line + offset, item, "malformed directive in set block")

    def translate_include(
        self, doc: Translator, source: Path, line: int, text: str
    ) -> Iterator[tuple[Directive, LegacyReader]]:
        pattern = text.removeprefix("include ").strip().strip('"\'')
        if "`" in pattern or "$(" in pattern:
            doc.warn(source, line, text, "include command substitution is refused")
            return
        pattern_path = Path(pattern).expanduser()
        if not pattern_path.is_absolute():
            pattern_path = source.parent / pattern_path
        matches = sorted(glob.glob(str(pattern_path)))
        if not matches:
            doc.warn(source, line, text, "include matched no files")
        for included in matches:
            yield from self.run(Path(included), doc)


# ---------------------------------------------------------------------------
# Translator: dispatch, one handler per branch of the old elif chain (in
# its order), the translate_* helpers they call, the state they write, and
# render(). The handler tables follow the class.
# ---------------------------------------------------------------------------


class Translator:
    def __init__(self) -> None:
        self.frontend = Frontend()
        self.binds: dict[str, str] = {}
        self.binding_modes: list[tuple[str, bool, list[str]]] = []
        # Sway defaults focus_follows_mouse to yes; swayward defaults it off.
        self.inputs: dict[str, list[str]] = {"": ["focus-follows-mouse"]}
        self.sections: list[str] = []
        self.blur_settings: dict[str, str] = {}
        self.layout_settings: list[str] = []
        self.workspace_layout_settings: dict[str, list[str]] = {}
        self.workspace_assignments: dict[str, list[str]] = {}
        self.titlebar_font: str | None = None
        self.titlebar_pango_markup = False
        self.titlebar_show_marks: bool | None = None
        self.titlebar_alignment: str | None = None
        self.titlebar_colors: dict[str, tuple[str, str, str]] = {}
        self.titlebar_padding: tuple[int, int] | None = None
        self.titlebar_border_thickness: int | None = None
        self.urgent_timeout_ms: int | None = None
        self.manual: list[str] = []

    @staticmethod
    def quote(value: str) -> str:
        return json.dumps(value, ensure_ascii=False)

    def warn(self, source: Path, line: int, text: str, reason: str) -> None:
        location = f"{source}:{line}" if line else str(source)
        item = f"{location}: {reason}: {text.strip()}"
        self.manual.append(item)
        self.sections.append(f"// sway-to-kdl: {item}")

    def satisfied(self, text: str) -> None:
        self.sections.append(
            f"// sway-to-kdl: satisfied by swayward defaults: {text.strip()}"
        )

    def parse(self, path: Path) -> None:
        for directive, reader in self.frontend.run(path, self):
            self.dispatch(directive, reader)

    def dispatch(self, d: Directive, reader: LegacyReader) -> None:
        """Today's elif chain, as two lookups keyed by directive name.

        For every name, the chain tried each branch that opens a block before
        any that does not, so the block handler goes first; either returns
        False when none of its patterns matches. The SwayFX names were tried
        only after every sway branch failed; none is a sway name, so they
        share the table.
        """
        key = legacy_handler_key(d.text)
        block_handler = BLOCK_HANDLERS.get(key)
        if block_handler is not None and block_handler(self, d, reader):
            return
        handler = HANDLERS.get(key)
        if handler is None or not handler(self, d):
            self.warn(d.pos.path, d.pos.line, d.text, "unhandled")

    def h_bar_block(self, d: Directive, reader: LegacyReader) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if re.match(r"bar\s*\{", text):
            block = reader.block(text)
            self.warn(
                path,
                line_no,
                " | ".join(block),
                "bar blocks are unsupported; use waybar "
                "(docs/SWAY_CONFIG_MIGRATION.md#replace-swaybar)",
            )
        else:
            return False
        return True

    def h_mode_block(self, d: Directive, reader: LegacyReader) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.match(
            r'mode\s+(--pango_markup\s+)?("[^"]+"|\S+)\s*\{', text
        ):
            block = reader.block(text)
            self.translate_mode(
                path,
                line_no,
                match.group(2).strip('"'),
                block[1:-1],
                match.group(1) is not None,
            )
        else:
            return False
        return True

    def h_bind_block(self, d: Directive, reader: LegacyReader) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"(bindsym|bindcode)(.*?)\s*\{", text):
            block = reader.block(text)
            self.translate_bind_block(
                path, line_no, match.group(1), match.group(2), block[1:-1]
            )
        else:
            return False
        return True

    def h_exec_block(self, d: Directive, reader: LegacyReader) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"(exec|exec_always)\s*\{", text):
            block = reader.block(text)
            self.translate_exec_block(
                path, line_no, match.group(1), block[1:-1]
            )
        else:
            return False
        return True

    def h_for_window_block(self, d: Directive, reader: LegacyReader) -> bool:
        # The chain tried `for_window {` well before `for_window [..] {`;
        # nothing between them matches a line starting with for_window.
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if re.fullmatch(r"for_window\s*\{", text):
            block = reader.block(text)
            self.translate_for_window_block(path, line_no, block[1:-1])
        elif match := re.fullmatch(
            r'for_window\s*(\[(?:[^"\]]|"(?:\\.|[^"])*")+\])\s*\{', text
        ):
            block = reader.block(text)
            self.translate_for_window_commands(
                path, line_no, match.group(1), block[1:-1]
            )
        else:
            return False
        return True

    def h_device_block(self, d: Directive, reader: LegacyReader) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.match(r"(input|output)\s+(.+?)\s*\{", text):
            block = reader.block(text)
            self.translate_device_block(
                path, line_no, match.group(1), match.group(2), block[1:-1]
            )
        else:
            return False
        return True

    def h_input(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.match(r"input\s+(\S+)\s+(.+)", text):
            self.translate_device_block(
                path, line_no, "input", match.group(1), [match.group(2)]
            )
        else:
            return False
        return True

    def h_output(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.match(r"output\s+(\S+)\s+(.+)", text):
            self.translate_device_block(
                path, line_no, "output", match.group(1), [match.group(2)]
            )
        else:
            return False
        return True

    def h_bind(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.match(r"(bindsym|bindcode)\s+(.+)", text):
            self.translate_bind(path, line_no, match.group(1), match.group(2))
        else:
            return False
        return True

    def h_exec(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"(exec|exec_always)(?:\s+(.*))?", text):
            self.translate_exec(
                path, line_no, text, match.group(1), match.group(2) or ""
            )
        else:
            return False
        return True

    def h_nop(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if re.fullmatch(r"nop(?:\s+.*)?", text):
            self.sections.append(f"// sway {text}")
        else:
            return False
        return True

    def h_unsupported_binding(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if re.match(r"(?:un)?bind(?:gesture|switch)(?:\s|$)", text):
            self.refuse_unsupported_binding(path, line_no, text)
        else:
            return False
        return True

    def h_for_window(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.match(
            r'for_window\s*(\[(?:[^"\]]|"(?:\\.|[^"])*")+\])\s+(.+)', text
        ):
            self.translate_for_window(path, line_no, match.group(1), match.group(2))
        elif text.startswith("for_window"):
            self.warn(
                path,
                line_no,
                text,
                "criteria need manual conversion to a window-rule match",
            )
        else:
            return False
        return True

    def h_no_focus(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"no_focus\s+(\[[^]]+\])", text):
            self.translate_no_focus(path, line_no, match.group(1))
        else:
            return False
        return True

    def h_assign(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.match(r"assign\s+(\[[^]]+\])\s+(?:→|->)?\s*(.+)", text):
            self.translate_assign(path, line_no, match.group(1), match.group(2))
        else:
            return False
        return True

    def h_workspace(self, d: Directive) -> bool:
        # The chain tried the case-sensitive `workspace X output` before the
        # gaps branches and `workspace X gaps`, which ignores case, after them.
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"workspace\s+(.+?)\s+output\s+(.+)", text):
            workspace = match.group(1).strip(chr(34))
            outputs = [output.strip(chr(34)) for output in match.group(2).split()]
            # Sway appends every output to one workspace_config in source
            # order (sway/commands/workspace.c:153-161).
            self.workspace_assignments.setdefault(workspace, []).extend(outputs)
        elif match := re.fullmatch(
            r"workspace\s+(.+?)\s+gaps\s+(inner|outer|horizontal|vertical|top|right|bottom|left)\s+(.+)",
            text,
            re.IGNORECASE,
        ):
            self.translate_gaps(
                path,
                line_no,
                text,
                match.group(2),
                match.group(3),
                match.group(1).strip(chr(34)),
            )
        else:
            return False
        return True

    def h_font(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"font\s+(pango:)?(.+)", text):
            self.titlebar_pango_markup = match.group(1) is not None
            self.titlebar_font = match.group(2)
        else:
            return False
        return True

    def h_client_colors(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(
            r"client\.(focused|focused_inactive|focused_tab_title|unfocused|urgent)\s+(.+)",
            text,
        ):
            self.translate_client_colors(path, line_no, text, match.group(1), match.group(2))
        else:
            return False
        return True

    def h_client_ignored(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"(client\.(?:background|placeholder))(?:\s+.*)?", text):
            self.warn(
                path,
                line_no,
                text,
                f"{match.group(1)} is accepted but ignored by sway itself "
                "(sway/sway/commands.c:51,55; sway/sway/commands/client.c:79-81)",
            )
        else:
            return False
        return True

    def h_gaps(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(
            r"gaps\s+(inner|outer|horizontal|vertical|top|right|bottom|left)\s+(.+)",
            text,
            re.IGNORECASE,
        ):
            self.translate_gaps(path, line_no, text, match.group(1), match.group(2))
        elif text.lower().startswith("gaps "):
            self.warn(path, line_no, text, "unsupported runtime or malformed gaps directive")
        else:
            return False
        return True

    def h_default_border(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(
            r"(default_border|default_floating_border|new_window|new_float)\s+(.+)",
            text,
        ):
            self.translate_default_border(
                path, line_no, text, match.group(1), match.group(2)
            )
        else:
            return False
        return True

    def h_floating_size(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(
            r"(floating_minimum_size|floating_maximum_size)\s+(-?\d+)\s+(x)\s+(-?\d+)",
            text,
        ):
            width, height = int(match.group(2)), int(match.group(4))
            if width < -1 or height < -1:
                self.warn(path, line_no, text, "floating size below -1 is unsupported")
            else:
                name = match.group(1).replace("_", "-")
                self.layout_settings.append(f"    {name} {width} {height}")
        else:
            return False
        return True

    def h_default_orientation(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"default_orientation\s+(\S+)", text, re.IGNORECASE):
            value = match.group(1).lower()
            if value in {"horizontal", "vertical", "auto"}:
                self.replace_layout_setting(
                    "default-orientation", f'    default-orientation "{value}"'
                )
                self.sections.append(f"// sway-to-kdl: sway {text}")
            else:
                self.warn(
                    path,
                    line_no,
                    text,
                    "expected default_orientation horizontal|vertical|auto",
                )
        else:
            return False
        return True

    def h_workspace_layout(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"workspace_layout\s+(\S+)", text, re.IGNORECASE):
            value = match.group(1).lower()
            if value in {"default", "stacking", "tabbed"}:
                self.layout_settings.append(f'    workspace-layout "{value}"')
            else:
                self.warn(path, line_no, text, "unsupported workspace layout")
        else:
            return False
        return True

    def h_hide_edge_borders(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"hide_edge_borders\s+(.+)", text):
            arguments = match.group(1).split()
            values = {"none", "vertical", "horizontal", "both", "smart", "smart_no_gaps"}
            if arguments[:1] == ["--i3"] and len(arguments) == 2 and arguments[1] in values:
                self.warn(path, line_no, text, "hide_lone_tab has no exact swayward equivalent")
            elif len(arguments) != 1 or arguments[0] not in values:
                self.warn(
                    path,
                    line_no,
                    text,
                    "expected hide_edge_borders [--i3] none|vertical|horizontal|both|smart|smart_no_gaps",
                )
            else:
                value = arguments[0]
                edge = "none" if value.startswith("smart") else value
                self.replace_layout_setting("hide-edge-borders", f'    hide-edge-borders "{edge}"')
                if value.startswith("smart"):
                    smart = "on" if value == "smart" else "no-gaps"
                    self.replace_layout_setting("smart-borders", f'    smart-borders "{smart}"')
        else:
            return False
        return True

    def h_smart_borders(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"smart_borders\s+(\S+)", text):
            value = match.group(1)
            enabled = {"1", "yes", "on", "true", "enable", "enabled", "active"}
            current = next(
                (
                    setting.rsplit('"', 2)[1]
                    for setting in self.layout_settings
                    if setting.startswith("    smart-borders ")
                ),
                "off",
            )
            if value == "no_gaps":
                smart = "no-gaps"
            elif value.lower() in enabled:
                smart = "on"
            elif value.lower() == "toggle":
                smart = "off" if current == "on" else "on"
            else:
                # sway's parse_boolean treats every other value as false.
                smart = "off"
            self.replace_layout_setting("smart-borders", f'    smart-borders "{smart}"')
        else:
            return False
        return True

    def h_smart_gaps(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"smart_gaps\s+(\S+)", text, re.IGNORECASE):
            value = match.group(1).lower()
            if value == "inverse_outer":
                value = "inverse-outer"
            elif value not in {"on", "off"}:
                self.warn(path, line_no, text, "expected smart_gaps on|off|inverse_outer")
                return True
            self.replace_layout_setting("smart-gaps", f'    smart-gaps "{value}"')
        else:
            return False
        return True

