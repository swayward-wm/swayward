SWAY_TRUE = frozenset({"1", "yes", "on", "true", "enable", "enabled", "active"})


def parse_boolean(value: str, current: bool) -> bool:
    """Sway's parse_boolean (common/util.c:40-54): its true words ignoring
    ASCII case, `toggle` as not current, and every other word false."""
    lowered = ascii_lower(value)
    if lowered == "toggle":
        return not current
    return lowered in SWAY_TRUE


def checkarg(args: list[str], name: str, least: int, most: int) -> str | None:
    """Sway's checkarg message (sway/commands.c:18-41) when the count of
    args is outside least..most, or None."""
    count = len(args)
    if least <= count <= most:
        return None
    bound, value = ("at least ", least) if count < least else ("at most ", most)
    plural = "" if value == 1 else "s"
    return f"Invalid {name} command (expected {bound}{value} argument{plural}, got {count})"


# The decimal forms strtof reads, in ASCII.
DECIMAL = re.compile(r"[+-]?(?:[0-9]+\.?[0-9]*|\.[0-9]+)(?:[eE][+-]?[0-9]+)?")


def unit_fraction(text: str) -> float | None:
    """text as a decimal number from 0 to 1, or None."""
    if DECIMAL.fullmatch(text) is None:
        return None
    value = float(text)  # an exponent past the float range reads as inf
    return value if 0.0 <= value <= 1.0 else None


