@dataclass
class Titlebar:
    """layout's titlebar, set by several directives, rendered in a fixed order."""

    font: str | None = None
    pango_markup: bool = False
    show_marks: bool | None = None
    alignment: str | None = None
    padding: tuple[int, int] | None = None
    border_thickness: int | None = None
    colors: Node = field(default_factory=lambda: Node("colors"))  # put per state

    def node(self) -> Node | None:
        children: list[Node | Comment] = []
        if self.font is not None:
            children.append(Node("font", [self.font]))
            if self.pango_markup:
                children.append(Node("pango-markup", [True]))
        if self.show_marks is not None:
            children.append(Node("show-marks", [self.show_marks]))
        if self.alignment is not None:
            children.append(Node("alignment", [self.alignment]))
        if self.padding is not None:
            horizontal, vertical = self.padding
            children.append(Node("horizontal-padding", [horizontal]))
            children.append(Node("vertical-padding", [vertical]))
        if self.border_thickness is not None:
            children.append(Node("border-thickness", [self.border_thickness]))
        children += self.colors.children
        return Node("titlebar", children=children) if children else None


class Document:
    """The translation: one field per output group, in render order."""

    def __init__(self) -> None:
        # Keyed by key, device, release and mouse regions; legacy_keep_first.
        self.binds: dict[tuple, Node] = {}
        self.modes: list[Node] = []
        # input's own settings. Sway defaults focus_follows_mouse to yes;
        # swayward defaults it off.
        self.input = Node("input", children=[Node("focus-follows-mouse")])
        # input's device classes, rendered after its own settings.
        self.devices: dict[str, Node] = {}
        self.blur = Node("blur")
        self.layout = Node("layout")
        self.titlebar = Titlebar()  # rendered last in layout
        self.body = Node("")  # the top level, in source order
        self.urgent_timeout: Node | None = None  # rendered last in body
        self.workspaces: dict[str, Node] = {}
        self.manual: list[str] = []

    def report(self, report: Report) -> None:
        self.body.report(report, self)

    def note(self, text: str) -> None:
        """A top-level comment that does not reach the manual list."""
        self.body.add(Comment(text))

    def device(self, name: str) -> Node:
        if name not in self.devices:
            self.devices[name] = Node(name, block=True)
        return self.devices[name]

    def workspace(self, name: str) -> Node:
        if name not in self.workspaces:
            self.workspaces[name] = Node("workspace", [name], block=True)
        return self.workspaces[name]

    def workspace_layout(self, name: str) -> Node:
        workspace = self.workspace(name)
        layout = workspace.get("layout")
        if layout is None:
            layout = Node("layout")
            workspace.add(layout)
        return layout


def legacy_add(parent: Node, *children: Node | Comment) -> None:
    parent.children.extend(children)


def legacy_g_float(value: float) -> Raw:
    return Raw(f"{value:g}")


def legacy_workspace_assignment(doc: Document, name: str) -> Node:
    """The workspace's sway-output-assignment node, created on first use.

    Assigned workspaces render first, in assignment order, so a newly
    assigned workspace moves to the end of the assigned ones; its assignment
    renders before its layout.
    """
    workspace = doc.workspace(name)
    assignment = workspace.get("sway-output-assignment")
    if assignment is None:
        assignment = Node("sway-output-assignment")
        workspace.children.insert(0, assignment)
        assigned = [
            other
            for other, node in doc.workspaces.items()
            if other != name and node.get("sway-output-assignment") is not None
        ]
        rest = [other for other in doc.workspaces if other != name and other not in assigned]
        doc.workspaces = {other: doc.workspaces[other] for other in [*assigned, name, *rest]}
    return assignment


# ---------------------------------------------------------------------------
# Renderer
#
# The only code that formats or quotes. Strings are quoted as JSON, floats
# go through kdl_float, and each depth indents four spaces. KDL-correct
# escaping of control characters is a separate fix.
# ---------------------------------------------------------------------------

INDENT = "    "

HEADER = (
    "// Generated by sway-to-kdl.",
    "// swayward uses typed nested KDL so its inherited effects and animations",
    "// keep their full option sets. Review every sway-to-kdl comment below.",
)

BLUR_NOTE = (
    "SwayFX blur settings; swayward keeps unmatched nested controls at their defaults."
)


def quote(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def kdl_float(value: float) -> str:
    rendered = f"{value:g}"
    return rendered if "." in rendered or "e" in rendered.lower() else rendered + ".0"


def render_value(value: Value) -> str:
    if isinstance(value, Raw):
        return value.text
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, float):
        return kdl_float(value)
    return quote(value)


def render_name(name: str) -> str:
    """A node name, bare; one of only digits would read as a number."""
    return quote(name) if name.isdecimal() else name


def render_head(node: Node) -> str:
    parts = [render_name(node.name)]
    parts += [render_value(arg) for arg in node.args]
    parts += [f"{key}={render_value(value)}" for key, value in node.props]
    return " ".join(parts)


def render_item(item: Node | Comment, depth: int) -> list[str]:
    indent = INDENT * depth
    if isinstance(item, Comment):
        return [f"{indent}// {item.text}"]
    head = indent + render_head(item)
    if item.inline:
        inner = "".join(f"{render_head(child)}; " for child in item.children)
        return [f"{head} {{ {inner}}}"]
    if not item.children and not item.block:
        return [head]
    lines = [head + " {"]
    for child in item.children:
        lines += render_item(child, depth + 1)
    lines.append(indent + "}")
    return lines


def render(doc: Document) -> str:
    """The groups in a fixed order, each after a blank line."""
    groups: list[list[Node | Comment]] = []
    if doc.binds:
        groups.append([Node("binds", children=list(doc.binds.values()))])
    groups += [[mode] for mode in doc.modes]
    devices = list(doc.devices.values())
    groups.append(
        [Node("input", children=[*doc.input.children, *devices], block=True)]
    )
    if doc.blur.children:
        groups.append([Comment(BLUR_NOTE), doc.blur])
    titlebar = doc.titlebar.node()
    layout = doc.layout.children + ([titlebar] if titlebar is not None else [])
    if layout:
        groups.append([Node("layout", children=layout)])
    body = doc.body.children + (
        [doc.urgent_timeout] if doc.urgent_timeout is not None else []
    )
    if body:
        groups.append(body)
    groups += [[workspace] for workspace in doc.workspaces.values()]
    lines = list(HEADER)
    for group in groups:
        lines.append("")
        for item in group:
            lines += render_item(item, 0)
    return "\n".join(lines) + "\n"


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("config", type=Path)
    args = parser.parse_args()
    translator = Translator()
    translator.parse(args.config)
    sys.stdout.write(render(translator.doc))
    manual = translator.doc.manual
    if manual:
        print(f"manual attention: {len(manual)} directive(s)", file=sys.stderr)
        for item in manual:
            print(f"  {item}", file=sys.stderr)
    else:
        print("manual attention: none", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
