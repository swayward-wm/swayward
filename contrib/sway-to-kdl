    def h_workspace(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        # The name is the arguments before `output` or `gaps`, joined
        # (sway/commands/workspace.c:130-166).
        args = d.args
        output = next((i for i, arg in enumerate(args) if arg == "output"), 0)
        gaps = next((i for i, arg in enumerate(args) if ascii_lower(arg) == "gaps"), 0)
        if output and len(args) > output + 1:
            workspace = join_args(args[:output])
            # Sway appends every output to one workspace_config in source
            # order (sway/commands/workspace.c:153-161).
            self.doc.workspace_assignment(workspace).args.extend(args[output + 1 :])
        elif gaps and (
            match := re.fullmatch(
                r"(inner|outer|horizontal|vertical|top|right|bottom|left)\s+(.+)",
                " ".join(args[gaps + 1 :]),
                re.IGNORECASE,
            )
        ):
            self.translate_gaps(
                path,
                line_no,
                text,
                match.group(1),
                match.group(2),
                join_args(args[:gaps]),
            )
        else:
            return False
        return True

