    def h_swayfx(self, d: Directive) -> bool:
        return self.translate_swayfx(d.pos.path, d.pos.line, d.text)

    def translate_for_window_commands(
        self, source: Path, line: int, criteria: str, body: list[str]
    ) -> None:
        commands = [
            self.frontend.expand(item.strip()).replace(r"\$", "$")
            for item in body
            if item.strip() and not item.strip().startswith("#")
        ]
        self.translate_for_window(source, line, criteria, ", ".join(commands))

    def translate_default_border(
        self, source: Path, line: int, text: str, directive: str, arguments: str
    ) -> None:
        words = arguments.split()
        style = words[0] if words else ""
        width = None
        if match := re.fullmatch(r"(\d+)pixel", style):
            if len(words) != 1:
                self.warn(source, line, text, "unsupported default border")
                return
            style = "pixel"
            width = match.group(1)
        elif (
            len(words) == 2
            and words[1].isdigit()
            and int(words[1]) <= 65535
            and style in {"normal", "pixel"}
        ):
            width = words[1]
        elif len(words) != 1 or style not in {"none", "normal", "pixel"}:
            self.warn(source, line, text, "unsupported default border")
            return
        if style == "none" and len(words) != 1:
            self.warn(source, line, text, "unsupported default border")
            return

        # These are layout defaults, not per-window rules. Emitting an
        # unmatched window-rule applied the border to every window and could
        # not be overridden by a later rule; layout.default-border is the
        # setting the `default_border` IPC command also writes.
        floating = directive in {"default_floating_border", "new_float"}
        name = "default-floating-border" if floating else "default-border"
        props = [("width", Raw(width))] if width is not None else []
        # A config may set the same default twice, and new_window/new_float
        # are older spellings of the same settings. KDL rejects a duplicate
        # node, and sway's own behaviour is last-wins.
        self.doc.layout.set(Node(name, [style], props))

    def translate_floating_modifier(
        self, source: Path, line: int, text: str, arguments: str
    ) -> None:
        words = arguments.split()
        if not words:
            self.warn(
                source,
                line,
                text,
                "expected floating_modifier <mod> [inverse|normal]",
            )
            return
        modifier = words[0]
        translated = (
            "None" if modifier.lower() == "none" else self.translate_modifier(modifier)
        )
        if translated not in {"None", "Ctrl", "Shift", "Alt", "Super"}:
            self.warn(source, line, text, f"unsupported modifier {modifier}")
            return
        mode = words[1].lower() if len(words) >= 2 else "normal"
        if mode not in {"inverse", "normal"}:
            self.warn(
                source,
                line,
                text,
                "expected floating_modifier <mod> [inverse|normal]",
            )
            return
        props = [("inverse", True)] if mode == "inverse" else []
        self.doc.input.set(Node("floating-modifier", [translated], props))

    def translate_mouse_warping(
        self, source: Path, line: int, text: str, value: str
    ) -> None:
        value = value.lower()
        if value == "none":
            return
        if value in {"container", "output"}:
            # KDL has no mouse-warping spelling, so approximate both enabled
            # modes with the inherited centering option. The note records the
            # narrower output-mode semantics so the conversion is not silent.
            legacy_add(
                self.doc.input,
                Node("warp-mouse-to-focus", props=[("mode", "center-xy")]),
            )
            if value == "output":
                self.doc.note(
                    "sway-to-kdl: mouse_warping output warps to the focused "
                    "output in sway; swayward warps to the focused window"
                )
            return
        self.warn(source, line, text, "expected mouse_warping output|container|none")

    def translate_client_colors(
        self, source: Path, line: int, text: str, state: str, arguments: str
    ) -> None:
        colors = arguments.split()
        if len(colors) < 3 or len(colors) > 5:
            self.warn(source, line, text, "client color requires 3 to 5 colors")
            return
        if any(color.startswith("$") for color in colors[:3]):
            self.warn(source, line, text, "unresolved color variable")
            return
        state = state.replace("_", "-")
        self.doc.titlebar.colors.put(
            Node(
                state,
                children=[
                    Node("border-color", [colors[0]]),
                    Node("background-color", [colors[1]]),
                    Node("text-color", [colors[2]]),
                ],
            )
        )
        ignored = [] if state == "focused-tab-title" else ["indicator", "child_border"]
        if ignored:
            self.warn(
                source,
                line,
                text,
                f"client.{state} {'/'.join(ignored)} colors have no titlebar equivalent",
            )

    def refuse_unsupported_binding(self, source: Path, line: int, text: str) -> None:
        directive = text.split(None, 1)[0]
        if directive in {"bindgesture", "unbindgesture"}:
            reason = (
                "gesture events cannot be bound to sway commands; "
                "only built-in compositor gestures and client forwarding are available"
            )
        else:
            reason = (
                "switch-events cannot preserve sway command bindings, binding modes, "
                "toggle, --locked, or --reload semantics"
            )
        self.warn(source, line, text, reason)

    def translate_exec(
        self, source: Path, line: int, text: str, directive: str, command: str
    ) -> None:
        command = command.strip()
        if command.startswith("--no-startup-id") and (
            len(command) == len("--no-startup-id")
            or command[len("--no-startup-id")].isspace()
        ):
            command = command[len("--no-startup-id") :].strip()
        if not command:
            self.warn(source, line, text, f"Expected '{directive} <command>'")
            return
        command = legacy_exec_unquote(command)
        if directive == "exec_always":
            self.warn(
                source,
                line,
                text,
                "exec_always reload behavior is not preserved; "
                "spawn-sh-at-startup runs only when swayward starts "
                "(sway/sway/commands/exec.c:12-17; exec_always.c:83; "
                "src/main.rs:162,270-275)",
            )
        self.doc.body.add(Node("spawn-sh-at-startup", [command]))

    def translate_mode(
        self, name: str, body: list[Line], pango_markup: bool
    ) -> None:
        mode_binds: dict[tuple, Node] = {}
        for item in body:
            source, line, text = item.pos.path, item.pos.line, item.text
            if match := SET_DIRECTIVE.fullmatch(text):
                self.frontend.define(match.group(1), match.group(2))
                continue
            text = self.frontend.expand(text).replace(r"\$", "$")
            # Mode subcommands are looked up ignoring case too
            # (sway/commands/mode.c:11-21, sway/commands.c:145-149).
            argv = split_args(text)
            text = ascii_lower(argv[0]) + text[len(argv[0]) :] if argv else text
            if match := re.match(r"(bindsym|bindcode)\s+(.+)", text):
                self.translate_bind(
                    source, line, match.group(1), match.group(2), mode_binds
                )
            elif re.match(r"(?:un)?bind(?:gesture|switch)(?:\s|$)", text):
                self.refuse_unsupported_binding(source, line, text)
            else:
                self.warn(source, line, text, f"unhandled directive in mode {name}")
        self.doc.modes.append(
            Node(
                "mode",
                [name],
                [("pango-markup", True)] if pango_markup else [],
                list(mode_binds.values()),
                block=True,
            )
        )

    def translate_bind(
        self,
        source: Path,
        line: int,
        kind: str,
        rest: str,
        binds: dict[tuple, Node] | None = None,
    ) -> None:
        """Add one binding to binds, the default mode's unless given."""
        if binds is None:
            binds = self.doc.binds
        properties: list[tuple[str, Value]] = []
        mouse_regions: set[str] = set()
        exclude_titlebar = False
        region_options = {
            "--whole-window": {"titlebar", "border", "contents"},
            "--border": {"border"},
            "--exclude-titlebar": set(),
        }
        rest = rest.strip()
        while rest.startswith("--"):
            input_match = re.match(r'--input-device=(?:"([^"]*)"|\'([^\']*)\'|(\S+))\s+', rest)
            if input_match:
                device = next(value for value in input_match.groups() if value is not None)
                properties.append(("input-device", device))
                rest = rest[input_match.end() :]
                continue
            option, separator, rest = rest.partition(" ")
            if not separator:
                self.warn(source, line, rest, f"malformed {kind}")
                return
            rest = rest.lstrip()
            if option == "--locked":
                properties.append(("allow-when-locked", True))
            elif option == "--no-repeat":
                properties.append(("repeat", False))
            elif option == "--release":
                properties.extend((("release", True), ("repeat", False)))
            elif option in region_options:
                mouse_regions.update(region_options[option])
                exclude_titlebar |= option == "--exclude-titlebar"
            else:
                self.warn(source, line, rest, f"unsupported {kind} option {option}")
                return

        key, separator, command = rest.partition(" ")
        if not separator or not command.strip():
            self.warn(source, line, rest, f"malformed {kind}")
            return
        if kind == "bindcode":
            parts = key.split("+")
            code = parts.pop()
            if not code.isdecimal():
                self.warn(source, line, rest, "bindcode key must be numeric")
                return
            if not 8 <= int(code) <= 255:
                self.warn(
                    source,
                    line,
                    rest,
                    f"bindcode keycode must be between 8 and 255: {code}",
                )
                return
            key = "+".join([*parts, f"code:{code}"])

        trailing, command = legacy_bind_trailing_options(command.strip())
        for option in trailing:
            if option == "--release":
                properties.extend((("release", True), ("repeat", False)))
            else:
                mouse_regions.update(region_options[option])
                exclude_titlebar |= option == "--exclude-titlebar"
        if exclude_titlebar:
            mouse_regions.discard("titlebar")
            mouse_regions.update(("border", "contents"))
        if mouse_regions:
            ordered_regions = ("titlebar", "border", "contents")
            regions = "+".join(region for region in ordered_regions if region in mouse_regions)
            properties.append(("mouse-regions", regions))
        command = self.translate_command(command)
        if command is None:
            self.warn(
                source,
                line,
                rest,
                "command is outside swayward's current command subset",
            )
            return
        original_key = key
        key = self.translate_key(key)
        if key is None:
            unsupported = next(
                (
                    part
                    for part in original_key.split("+")[:-1]
                    if not part.lower().startswith("button")
                ),
                original_key,
            )
            reason = (
                f"unsupported mouse button {original_key}"
                if original_key.lower().startswith("button")
                else f"unsupported modifier {unsupported}"
            )
            self.warn(source, line, rest, reason)
            return
        # The duplicate check and its report see the key as rendered, so a
        # numeric key and its quoted spelling collide, as they always have.
        shown = render_name(key)
        input_device = next(
            (value for name, value in properties if name == "input-device"), "*"
        )
        binding_key = (
            shown,
            input_device,
            ("release", True) in properties,
            frozenset(mouse_regions),
        )
        node = Node(
            key, props=properties, children=[Node("command", [command])], inline=True
        )
        if not legacy_keep_first(binds, binding_key, node):
            self.warn(source, line, rest, f"duplicate binding for {shown}; kept the first")

    @staticmethod
    def translate_modifier(modifier: str) -> str | None:
        return next(
            (
                translated
                for name, translated in LEGACY_MODIFIER_ALIASES.items()
                if name.lower() == modifier.lower()
            ),
            None,
        )

    @staticmethod
    def translate_key(key: str) -> str | None:
        aliases = {
            "button1": "MouseLeft",
            "button2": "MouseMiddle",
            "button3": "MouseRight",
            "button4": "WheelScrollUp",
            "button5": "WheelScrollDown",
            "button6": "WheelScrollLeft",
            "button7": "WheelScrollRight",
            "button8": "MouseBack",
            "button9": "MouseForward",
            "BTN_LEFT": "MouseLeft",
            "BTN_MIDDLE": "MouseMiddle",
            "BTN_RIGHT": "MouseRight",
            "BTN_SIDE": "MouseBack",
            "BTN_BACK": "MouseBack",
            "BTN_EXTRA": "MouseForward",
            "BTN_FORWARD": "MouseForward",
        }
        parts = key.split("+")
        non_modifiers = [
            index
            for index, part in enumerate(parts)
            if Translator.translate_modifier(part) is None
        ]
        if len(non_modifiers) == 1:
            trigger = parts.pop(non_modifiers[0])
        else:
            trigger = parts.pop()
        translated_modifiers = [Translator.translate_modifier(part) for part in parts]
        if any(part is None for part in translated_modifiers):
            return None
        parts = [part for part in translated_modifiers if part is not None] + [trigger]
        if any(
            (part.lower().startswith("button") or part.startswith("BTN_"))
            and part not in aliases
            for part in parts
        ):
            return None
        return "+".join(aliases.get(part, part) for part in parts)

    @staticmethod
    def translate_command(command: str) -> str | None:
        if match := re.fullmatch(
            r"(exec(?:_always)?\s+(?:--no-startup-id\s+)?)(.+)", command
        ):
            command = match.group(1) + legacy_exec_unquote(match.group(2))
        return legacy_command_spelling(legacy_unescape_at(command))

    def translate_assign(
        self, source: Path, line: int, criteria: str, args: list[str]
    ) -> None:
        match = self.translate_window_criteria(source, line, "assign", criteria)
        if match is None:
            return
        # cmd_assign tests whole arguments for its keywords, then joins the
        # rest (sway/commands/assign.c:26-56).
        if args[:1] == ["->"] or args[:1] and args[0].startswith("→"):
            args = args[1:]
        property_name = "open-on-workspace"
        if args[:1] == ["output"]:
            property_name = "open-on-output"
            args = args[1:]
        else:
            if args[:1] == ["workspace"]:
                args = args[1:]
            if args[:1] == ["number"]:
                args = args[1:]
                if not args or not "0" <= args[0][:1] <= "9":
                    number = args[0] if args else ""
                    self.warn(
                        source,
                        line,
                        f"assign {criteria} number {number}",
                        f"invalid workspace number {number!r}",
                    )
                    return
                property_name = "open-on-workspace-number"
        if not args:
            self.warn(
                source,
                line,
                f"assign {criteria}",
                "missing workspace or output",
            )
            return
        target = join_args(args)
        self.doc.body.add(
            Node(
                "window-rule",
                children=[
                    self.match_node(match),
                    Node(property_name, [target]),
                ],
            )
        )

    def translate_window_criteria(
        self, source: Path, line: int, directive: str, criteria: str
    ) -> list[tuple[str, str | bool]] | None:
        token = re.compile(
            r'(?:(\w+)=(?:"((?:\\.|[^"])*)"|([^ "\]]+))|(tiling|floating))'
        )
        criteria_body = criteria[1:-1].strip()
        matches = list(token.finditer(criteria_body))
        if not matches or " ".join(match.group(0) for match in matches) != criteria_body:
            self.warn(
                source,
                line,
                f"{directive} {criteria}",
                "criteria need manual conversion to a window-rule match",
            )
            return None
        translated = []
        for criterion in matches:
            key = criterion.group(1) or criterion.group(4)
            value = criterion.group(2) or criterion.group(3)
            if key in {"tiling_from", "floating_from"}:
                self.warn(
                    source,
                    line,
                    f"{directive} {criteria}",
                    f"i3-only provenance criterion {key} has no sway equivalent",
                )
                return None
            if key in {"class", "instance", "id", "window_role", "window_type"}:
                # sway matches these against Xwayland properties only: criteria.c
                # reads view_get_class(), which resolves through
                # impl->get_string_prop, and only xwayland.c implements it.
                # xdg_shell.c returns NULL for VIEW_PROP_CLASS, so the criterion
                # never matches a native Wayland window.
                #
                # The whole directive is dropped rather than translated without
                # the criterion. Keeping the other criteria would widen the rule
                # to every Wayland window that matches them, firing on windows
                # sway would never have touched, and silently.
                self.warn(
                    source,
                    line,
                    f"{directive} {criteria}",
                    f"X11-only criterion {key} matches only Xwayland windows in "
                    f"sway; whole directive dropped rather than widened "
                    f"(docs/KNOWN_DEVIATIONS.md#x11-window-identity)",
                )
                return None
            if key == "workspace":
                self.warn(
                    source,
                    line,
                    f"{directive} {criteria}",
                    "workspace criterion has no window-rule equivalent",
                )
                return None
            if key in {"tiling", "floating"}:
                translated.append(("is-floating", key == "floating"))
            elif key == "urgent" and value in {
                "latest", "newest", "last", "recent", "oldest", "first"
            }:
                translated.append(("is-urgent", True))
            elif key in {"app_id", "title"}:
                translated.append(("title" if key == "title" else "app-id", value))
            else:
                self.warn(
                    source,
                    line,
                    f"{directive} {criteria}",
                    "criteria need manual conversion to a window-rule match",
                )
                return None
        return translated

    @staticmethod
    def match_node(match: list[tuple[str, str | bool]]) -> Node:
        return Node("match", props=list(match))

    def translate_no_focus(self, source: Path, line: int, criteria: str) -> None:
        match = self.translate_window_criteria(source, line, "no_focus", criteria)
        if match is None:
            return
        self.doc.body.add(
            Node(
                "window-rule",
                children=[self.match_node(match), Node("open-focused", [False])],
            )
        )

    @staticmethod
    def split_amounts(words: list[str]) -> list[tuple[int, str]] | None:
        """Parse sway size amounts such as `5 px`, `5px`, `5 ppt` or `5`."""
        amounts: list[tuple[int, str]] = []
        index = 0
        while index < len(words):
            found = re.fullmatch(r"(-?\d+)(px|ppt)?", words[index])
            if found is None:
                return None
            unit = found.group(2)
            index += 1
            if unit is None and index < len(words) and words[index] in {"px", "ppt"}:
                unit = words[index]
                index += 1
            amounts.append((int(found.group(1)), unit or "px"))
        return amounts

    def fixed_resize_set(self, words: list[str]) -> tuple[int, int] | None:
        if words[:2] != ["resize", "set"]:
            return None
        amounts = self.split_amounts(words[2:])
        if (
            amounts is None
            or len(amounts) != 2
            or any(unit != "px" or value <= 0 for value, unit in amounts)
        ):
            return None
        return amounts[0][0], amounts[1][0]

    def is_move_position_coordinates(self, words: list[str]) -> bool:
        if words[:2] != ["move", "position"]:
            return False
        amounts = self.split_amounts(words[2:])
        return amounts is not None and len(amounts) == 2

    def translate_for_window(
        self, source: Path, line: int, criteria: str, command: str
    ) -> None:
        match = self.translate_window_criteria(source, line, "for_window", criteria)
        if match is None:
            return
        rule = Node("window-rule", children=[self.match_node(match)])
        try:
            commands = split_command_list(command)
        except CriteriaError as error:
            self.warn(source, line, f"for_window {criteria} {command}", str(error))
            return
        if not commands:
            self.warn(
                source,
                line,
                f"for_window {criteria} {command}",
                "for_window needs a command",
            )
            return
        for listed in commands:
            directive = join_args(listed.argv)
            words = command_words(listed)
            if listed.criteria is not None:
                # Criteria after a `;` select other windows (sway/commands.c:232-251).
                words = [listed.criteria, *words]
                directive = f"{listed.criteria} {directive}"
            if words[:1] == ["border"]:
                if words == ["border", "none"]:
                    legacy_add(rule, Node("sway-border", ["none"]))
                elif words == ["border", "pixel"]:
                    legacy_add(rule, Node("sway-border", ["pixel"]))
                elif (
                    len(words) == 3
                    and words[:2] == ["border", "pixel"]
                    and words[2].isdigit()
                ):
                    legacy_add(
                        rule,
                        Node("sway-border", ["pixel"]),
                        Node("sway-border-width", [Raw(words[2])]),
                    )
                else:
                    self.warn(
                        source,
                        line,
                        f"for_window {criteria} {directive}",
                        "Expected 'border <none|normal|pixel|csd|toggle>' "
                        "or 'border pixel <px>'",
                    )
            elif words in (["floating", "enable"], ["floating", "enabled"]):
                rule.set(Node("open-floating", [True]))
            elif words == ["floating", "disable"]:
                rule.set(Node("open-floating", [False]))
            elif words == ["layout", "tabbed"]:
                legacy_add(rule, Node("default-column-display", ["tabbed"]))
            elif words == ["focus"]:
                legacy_add(rule, Node("open-focused", [True]))
            elif words == ["nofocus"]:
                legacy_add(rule, Node("open-focused", [False]))
            elif (
                len(words) == 2 and words[0] in {"opacity", "opacity_set"}
            ) or (len(words) == 3 and words[:2] == ["opacity", "set"]):
                try:
                    opacity = float(words[-1])
                except ValueError:
                    opacity = -1.0
                if 0.0 <= opacity <= 1.0:
                    rule.set(Node("opacity", [opacity]))
                else:
                    self.warn(
                        source,
                        line,
                        f"for_window {criteria} {directive}",
                        "opacity must be between 0 and 1",
                    )
            elif words == ["shortcuts_inhibitor", "disable"]:
                rule.add(Node("sway-for-window-command", [directive]))
            elif words[:1] == ["title_format"] and len(words) >= 2:
                rule.add(Node("sway-for-window-command", [directive]))
            elif words[:1] == ["nop"]:
                rule.add(Node("sway-for-window-command", [directive]))
            elif words in (["kill"], ["reload"], ["move", "scratchpad"]):
                rule.add(Node("sway-for-window-command", [directive]))
            elif words[:1] == ["mark"]:
                options = words[1:-1]
                if (
                    len(words) < 2
                    or words[-1].startswith("--")
                    or any(
                        option not in {"--add", "--replace", "--toggle"}
                        for option in options
                    )
                ):
                    self.warn(
                        source,
                        line,
                        f"for_window {criteria} {command}",
                        "invalid mark command",
                    )
                    return
                rule.add(Node("sway-for-window-command", [directive]))
            elif words[:2] == ["move", "workspace"] and len(words) == 3:
                legacy_add(rule, Node("open-on-workspace", [words[2]]))
            elif (
                len(words) == 6
                and words[:2] == ["resize", "set"]
                and words[3] == "ppt"
                and words[5] == "ppt"
            ):
                try:
                    width = int(words[2])
                    height = int(words[4])
                except ValueError:
                    width = height = -1
                if width > 0 and height > 0:
                    legacy_add(
                        rule,
                        preset_size(
                            "default-column-width",
                            "proportion",
                            legacy_g_float(width / 100),
                        ),
                        preset_size(
                            "default-window-height",
                            "proportion",
                            legacy_g_float(height / 100),
                        ),
                    )
                else:
                    self.warn(
                        source,
                        line,
                        f"for_window {criteria} {directive}",
                        "resize size needs manual conversion",
                    )
            elif (
                len(words) in {6, 7}
                and words[:3] == ["resize", "set", "width"]
                and words[4] == "height"
                and words[3].isdigit()
                and words[5].isdigit()
                and (len(words) == 6 or words[6] == "px")
            ):
                legacy_add(
                    rule,
                    preset_size("default-column-width", "fixed", Raw(words[3])),
                    preset_size("default-window-height", "fixed", Raw(words[5])),
                )
            elif (
                resized := self.fixed_resize_set(words)
            ) is not None:
                width, height = resized
                legacy_add(
                    rule,
                    preset_size("default-column-width", "fixed", width),
                    preset_size("default-window-height", "fixed", height),
                )
            elif words == ["move", "position", "center"]:
                rule.add(Node("sway-for-window-command", ["move position center"]))
            elif self.is_move_position_coordinates(words):
                # swayward parses sway's relative `move position <x> <y>`
                # with px or ppt units and runs it after the window maps.
                rule.add(Node("sway-for-window-command", [directive]))
            elif len(words) == 2 and words[0] == "sticky" and words[1] in {
                "enable",
                "disable",
                "toggle",
            }:
                rule.add(Node("sway-for-window-command", [directive]))
            elif len(words) == 2 and words[0] == "inhibit_idle" and words[1] in {
                "focus",
                "fullscreen",
                "open",
                "none",
                "visible",
            }:
                # swayward implements sway's five user idle-inhibit policies
                # (sway/sway/commands/inhibit_idle.c:22-35) and runs the
                # command against the window after it maps.
                rule.add(Node("sway-for-window-command", [directive]))
            elif words[:1] == ["dim_inactive"] and len(words) == 2:
                rule.set(Node("opacity", [1.0 - float(words[1])]))
            elif words[:1] == ["corner_radius"] and len(words) == 2:
                legacy_add(
                    rule,
                    Node("geometry-corner-radius", [Raw(words[1])]),
                    Node("clip-to-geometry", [True]),
                )
            elif words[:1] == ["blur"] and len(words) == 2:
                legacy_add(rule, background_effect("blur", words[1]))
            elif words[:1] == ["shadows"] and len(words) == 2:
                legacy_add(rule, shadow(words[1]))
            else:
                self.warn(
                    source,
                    line,
                    f"for_window {criteria} {directive}",
                    "command needs manual conversion to window-rule properties",
                )
        if len(rule.children) > 1:  # an effect besides the match
            self.doc.body.add(rule)

    def translate_gaps(
        self,
        source: Path,
        line: int,
        text: str,
        kind: str,
        raw_amount: str,
        workspace: str | None = None,
    ) -> None:
        match = re.fullmatch(r"([+-]?\d+)(?:px)?", raw_amount, re.IGNORECASE)
        if match is None:
            self.warn(source, line, text, "gap amount must be an integer with optional px suffix")
            return
        amount = int(match.group(1))
        kind = kind.lower()
        settings = (
            self.doc.layout
            if workspace is None
            else self.doc.workspace_layout(workspace)
        )
        if kind == "inner":
            settings.set(Node("gaps", [max(amount, 0)]))
            return
        sides = {
            "outer": ("left", "right", "top", "bottom"),
            "horizontal": ("left", "right"),
            "vertical": ("top", "bottom"),
            "top": ("top",),
            "right": ("right",),
            "bottom": ("bottom",),
            "left": ("left",),
        }[kind]
        # One outer-gaps node per layout: the sides set so far keep their
        # place, and the node moves to the end, as sway's last setting wins.
        existing = settings.get("outer-gaps")
        gaps = Node("outer-gaps", children=list(existing.children) if existing else [])
        for side in sides:
            gaps.put(Node(side, [amount]))
        settings.set(gaps)

    def translate_device_block(
        self, source: Path, line: int, kind: str, selector: str, body: list[str]
    ) -> None:
        if kind == "input":
            self.translate_input_block(source, line, selector, body)
        else:
            self.translate_output_block(source, line, selector, body)

    def translate_input_block(
        self, source: Path, line: int, selector: str, body: list[str]
    ) -> None:
        targets = {
            "type:keyboard": "keyboard",
            "type:pointer": "mouse",
            "type:tablet_tool": "tablet",
            "type:touch": "touch",
            "type:touchpad": "touchpad",
        }
        target = targets.get(selector)
        if selector == "*" and all(
            item.split(None, 1)[0].startswith("xkb_")
            or item.split(None, 1)[0] in {"repeat_delay", "repeat_rate"}
            for item in body
            if item and not item.startswith("#")
        ):
            target = "keyboard"
        if target is None:
            self.warn(
                source,
                line,
                f"input {selector} {{ ... }}",
                "device-specific input selectors cannot be preserved; swayward input "
                "settings apply by device class "
                "(docs/SWAY_CONFIG_MIGRATION.md#convert-device-specific-inputs)",
            )
            return
        mappings = {
            "accel_profile": "accel-profile",
            "click_method": "click-method",
            "drag": "drag",
            "drag_lock": "drag-lock",
            "dwt": "dwt",
            "dwtp": "dwtp",
            "natural_scroll": "natural-scroll",
            "middle_emulation": "middle-emulation",
            "left_handed": "left-handed",
            "pointer_accel": "accel-speed",
            "repeat_delay": "repeat-delay",
            "repeat_rate": "repeat-rate",
            "scroll_button": "scroll-button",
            "scroll_factor": "scroll-factor",
            "scroll_method": "scroll-method",
            "tap": "tap",
            "tap_button_map": "tap-button-map",
            "xkb_layout": "layout",
            "xkb_model": "model",
            "xkb_options": "options",
            "xkb_rules": "rules",
            "xkb_variant": "variant",
        }
        pos = Pos(source, line)
        translated = Node(target)  # this block's settings, merged below
        xkb = Node("xkb")
        for item in body:
            if not item or item.startswith("#"):
                continue
            words = item.split(None, 1)
            unhandled = Report(pos, "unhandled input directive", item)
            if words[0] == "xkb_numlock" and target == "keyboard":
                if len(words) == 1:
                    translated.report(unhandled, self.doc)
                    continue
                value = unquote_args(split_args(words[1]))[0]
                enabled = value.lower() in {
                    "1", "yes", "on", "true", "enable", "enabled", "active", "toggle"
                }
                translated.add(Comment(f"sway-to-kdl: sway {item}"))
                legacy_add(translated, Node("numlock", [] if enabled else [False]))
                continue
            name = mappings.get(words[0])
            if name is None:
                translated.report(unhandled, self.doc)
                continue
            value = words[1] if len(words) > 1 else "enabled"
            enum_values = {
                "accel-profile": {"adaptive": "adaptive", "flat": "flat"},
                "click-method": {
                    "button_areas": "button-areas",
                    "clickfinger": "clickfinger",
                },
                "scroll-method": {
                    "none": "no-scroll",
                    "two_finger": "two-finger",
                    "edge": "edge",
                    "on_button_down": "on-button-down",
                },
                "tap-button-map": {
                    "lrm": "left-right-middle",
                    "lmr": "left-middle-right",
                },
            }
            parent = xkb if words[0].startswith("xkb_") else translated
            if name == "drag":
                legacy_add(parent, Node(name, [value == "enabled"]))
            elif value in {"enabled", "disabled"}:
                # libinput booleans are bare KDL flags that take no argument:
                # presence enables them and absence leaves them off.
                if value == "enabled":
                    legacy_add(parent, Node(name))
                else:
                    parent.add(Comment(f"sway-to-kdl: sway {item}"))
            elif name in enum_values:
                legacy_add(parent, Node(name, [enum_values[name].get(value, value)]))
            elif name in {"layout", "model", "options", "rules", "variant"}:
                value = join_args(unquote_args(split_args(value)))
                legacy_add(parent, Node(name, [value]))
            elif name in {"accel-speed", "scroll-factor"}:
                try:
                    legacy_add(parent, Node(name, [legacy_g_float(float(value))]))
                except ValueError:
                    parent.report(unhandled, self.doc)
            elif name == "scroll-button" and not value.isdecimal():
                button_codes = {
                    "BTN_LEFT": 272,
                    "BTN_RIGHT": 273,
                    "BTN_MIDDLE": 274,
                    "BTN_SIDE": 275,
                    "BTN_EXTRA": 276,
                    "BTN_FORWARD": 277,
                    "BTN_BACK": 278,
                }
                if value not in button_codes:
                    parent.report(unhandled, self.doc)
                else:
                    legacy_add(parent, Node(name, [button_codes[value]]))
            else:
                legacy_add(parent, Node(name, [Raw(value)]))
        if xkb.children:
            legacy_add(translated, xkb)
        legacy_add(self.doc.device(target), *translated.children)

    def translate_output_block(
        self, source: Path, line: int, selector: str, body: list[str]
    ) -> None:
        pos = Pos(source, line)
        translated = Node("output", [selector], block=True)
        words = " ".join(
            item for item in body if item and not item.startswith("#")
        ).split()
        unsupported_argument_counts = {
            "adaptive_sync": 1,
            "bg": 2,
            "dpms": 1,
            "max_render_time": 1,
            "power": 1,
            "render_bit_depth": 1,
            "subpixel": 1,
        }
        index = 0
        while index < len(words):
            name = words[index]
            if name in {"res", "resolution", "mode"} and index + 1 < len(words):
                # sway accepts a trailing Hz on the refresh rate
                # (`sway/sway/commands/output/mode.c`), swayward's parser does
                # not. Strip it so the emitted config loads.
                mode = re.sub(r"(@[0-9.]+)\s*Hz$", r"\1", words[index + 1], flags=re.IGNORECASE)
                legacy_add(translated, Node("mode", [mode]))
                index += 2
            elif name in {"pos", "position"} and index + 1 < len(words):
                if "," in words[index + 1]:
                    x, y = words[index + 1].split(",", 1)
                    consumed = 2
                elif index + 2 < len(words):
                    x, y = words[index + 1 : index + 3]
                    consumed = 3
                else:
                    x = y = ""
                    consumed = 0
                if re.fullmatch(r"-?\d+", x) and re.fullmatch(r"-?\d+", y):
                    legacy_add(
                        translated,
                        Node("position", props=[("x", Raw(x)), ("y", Raw(y))]),
                    )
                    index += consumed
                else:
                    consumed = 1
                    translated.report(
                        Report(pos, "unhandled output directive", name), self.doc
                    )
                    index += consumed
            elif name == "transform" and index + 1 < len(words):
                value = words[index + 1]
                valid = {
                    "normal",
                    "90",
                    "180",
                    "270",
                    "flipped",
                    "flipped-90",
                    "flipped-180",
                    "flipped-270",
                }
                if value in valid:
                    legacy_add(translated, Node("transform", [value]))
                else:
                    translated.report(
                        Report(pos, "unhandled output directive", f"{name} {value}"),
                        self.doc,
                    )
                index += 2
            elif name == "scale" and index + 1 < len(words):
                legacy_add(translated, Node("scale", [Raw(words[index + 1])]))
                index += 2
            elif name in {"enable", "on"}:
                index += 1
            elif name in {"disable", "off"}:
                legacy_add(translated, Node("off"))
                index += 1
            else:
                argument_count = unsupported_argument_counts.get(name)
                if argument_count is None:
                    remainder = " ".join(words[index:])
                    translated.report(
                        Report(pos, "unhandled output directive", remainder), self.doc
                    )
                    break
                end = min(index + argument_count + 1, len(words))
                directive = " ".join(words[index:end])
                translated.report(
                    Report(pos, "unhandled output directive", directive), self.doc
                )
                index = end
        self.doc.body.add(translated)

    def translate_swayfx(self, source: Path, line: int, text: str) -> bool:
        words = text.split()
        if not words:
            return False
        name = words[0]
        if name == "blur":
            state = "off" if len(words) > 1 and words[1] in {"disable", "off"} else "on"
            self.doc.blur.put(Node(state), "on", "off")
            self.doc.note("SwayFX blur -> swayward blur and window background-effect")
            self.doc.body.add(
                Node(
                    "window-rule",
                    children=[
                        Node("background-effect", children=[Node("blur", [state == "on"])])
                    ],
                )
            )
        elif name == "blur_xray" and len(words) == 2:
            self.doc.note("SwayFX blur_xray -> window-rule background-effect xray")
            self.doc.body.add(
                Node("window-rule", children=[background_effect("xray", words[1])])
            )
        elif name == "blur_passes" and len(words) == 2:
            self.doc.blur.put(Node("passes", [Raw(words[1])]))
        elif name == "blur_radius" and len(words) == 2:
            self.doc.blur.put(Node("offset", [Raw(words[1])]))
        elif name == "titlebar_padding" and len(words) >= 2:
            try:
                horizontal = int(words[1])
                vertical = horizontal if len(words) == 2 else int(words[2])
            except ValueError:
                horizontal = vertical = -1
            if horizontal < 0 or vertical < 0 or horizontal > 65535 or vertical > 65535:
                self.warn(source, line, text, "Invalid size specified")
            else:
                titlebar = self.doc.titlebar
                thickness = (
                    1 if titlebar.border_thickness is None else titlebar.border_thickness
                )
                if horizontal < thickness or vertical < thickness:
                    self.warn(source, line, text, "Invalid size specified")
                else:
                    titlebar.padding = (horizontal, vertical)
                    self.doc.note(f"sway-to-kdl: SwayFX {text}")
        elif name == "titlebar_border_thickness" and len(words) == 2:
            try:
                thickness = int(words[1])
            except ValueError:
                thickness = -1
            titlebar = self.doc.titlebar
            vertical = titlebar.padding[1] if titlebar.padding else 4
            if thickness < 0 or thickness > vertical or thickness > 65535:
                self.warn(source, line, text, "Invalid size specified")
            else:
                titlebar.border_thickness = thickness
                self.doc.note(f"sway-to-kdl: SwayFX {text}")
        elif name == "corner_radius" and len(words) == 2:
            self.doc.note("SwayFX corner_radius -> window-rule geometry-corner-radius")
            self.doc.body.add(
                Node(
                    "window-rule",
                    children=[
                        Node("geometry-corner-radius", [Raw(words[1])]),
                        Node("clip-to-geometry", [True]),
                    ],
                )
            )
        elif name == "shadows":
            state = "off" if len(words) > 1 and words[1] in {"disable", "off"} else "on"
            self.doc.layout.add(
                Comment("SwayFX shadows; tune remaining shadow controls as needed")
            )
            legacy_add(self.doc.layout, Node("shadow", children=[Node(state)]))
        elif name == "shadows_on_csd" and len(words) == 2:
            self.warn(
                source,
                line,
                text,
                "SwayFX shadows_on_csd has no exact swayward equivalent; tune layout shadow draw-behind-window",
            )
        elif name in {"dim_inactive", "default_dim_inactive"} and len(words) == 2:
            opacity = 1.0 - float(words[1])
            self.doc.note("SwayFX dim_inactive -> unfocused window opacity")
            self.doc.body.add(
                Node(
                    "window-rule",
                    children=[
                        Node("match", props=[("is-focused", False)]),
                        Node("opacity", [opacity]),
                    ],
                )
            )
        elif name == "layer_effects":
            self.translate_layer_effects(source, line, text)
        else:
            return False
        return True

    def translate_layer_effects(self, source: Path, line: int, text: str) -> None:
        args = Directive.from_line(text, Pos(source, line)).args
        try:
            effects = split_command_list(join_args(args[1:])) if len(args) > 1 else []
        except CriteriaError:
            effects = []
        if not effects:
            self.warn(source, line, text, "cannot parse SwayFX layer_effects")
            return
        namespace = args[0]
        rule = Node(
            "layer-rule",
            children=[
                Node("match", props=[("namespace", "^" + re.escape(namespace) + "$")])
            ],
        )
        for effect in effects:
            words = command_words(effect)
            if words[:1] == ["blur"] and len(words) == 2:
                legacy_add(rule, background_effect("blur", words[1]))
            elif words[:1] == ["blur_xray"] and len(words) == 2:
                legacy_add(rule, background_effect("xray", words[1]))
            elif words[:1] == ["shadows"] and len(words) == 2:
                legacy_add(rule, shadow(words[1]))
            elif words[:1] == ["corner_radius"] and len(words) == 2:
                legacy_add(rule, Node("geometry-corner-radius", [Raw(words[1])]))
            else:
                rule.report(
                    Report(
                        Pos(source, line),
                        "unhandled layer_effects directive",
                        join_args(effect.argv),
                    ),
                    self.doc,
                )
        self.doc.note(f"SwayFX layer_effects -> layer-rule for {namespace}")
        self.doc.body.add(rule)


