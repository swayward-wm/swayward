def sway_mouse_button(name: str) -> str | None:
    """The MOUSE_BUTTONS name sway's get_mouse_bindsym reads name as, or None
    for a keysym.

    `button` is matched ignoring case and `BTN_` exactly
    (sway/input/cursor.c:1203-1226). A result missing from MOUSE_BUTTONS is
    a button sway refuses or swayward cannot bind.
    """
    if ascii_lower(name).startswith("button"):
        return ascii_lower(name)
    if name.startswith("BTN_"):
        return name
    return None


@dataclass
class Binding:
    """A translated binding under sway's identity (Translator.translate_bind)."""

    kdl: tuple  # the identity swayward's KDL gives the node
    node: Node
    pos: Pos
    command: str


class BindError(ValueError):
    """A key combination sway rejects, or one swayward's KDL cannot bind."""


@dataclass
class KeyCombo:
    """A bind's key argument as cmd_bindsym_or_bindcode reads it."""

    modifiers: list[str]  # KDL spellings, in source order
    mask: int  # the wlr modifier bits, as binding_key_compare sees them
    group: int | None  # 1 to 4
    keys: list[str]  # every other part, in source order; Mode_switch included
    mode_switch: bool


def split_key_combo(combo: str) -> KeyCombo:
    """Sway's loop over a bind's `+` parts (sway/commands/bind.c:398-453).

    split_string drops empty parts. A part that starts with "Group" names a
    group, Group1 to Group4 by strtol, and only one group is allowed.
    Mode_switch sets group 2 and then, like every part that is not a
    modifier, is a key. Raises BindError with sway's message for a bad group.
    """
    result = KeyCombo([], 0, None, [], False)
    for part in (p for p in combo.split("+") if p):
        if part.startswith(SWAY_GROUP_PREFIX):
            if result.group is not None:
                raise BindError("only one group can be specified")
            # strtol with nothing left over (bind.c:408-410). The digits
            # are compared as text, so no length reaches int().
            number = re.fullmatch(
                r"[ \f\n\r\t\v]*\+?0*([1-4])", part[len(SWAY_GROUP_PREFIX) :]
            )
            if number is None:
                raise BindError(f"invalid group {part}")
            result.group = int(number.group(1))
            continue
        if part == SWAY_MODE_SWITCH:
            if result.group is not None:
                raise BindError("only one group can be specified")
            result.group = 2
            result.mode_switch = True
        modifier = SWAY_MODIFIERS.get(ascii_lower(part))
        if modifier is not None:
            result.modifiers.append(modifier[0])
            result.mask |= modifier[1]
            continue
        result.keys.append(part)
    return result


# The text of a quoted criteria value: each character matches one way, a
# backslash only with the character after it, so a scan takes time linear in
# the line. The (?<!\w) before a criteria token keeps finditer from retrying
# inside a word.
QUOTED_VALUE = r'(?:[^"\\]|\\.)*'

TRANSLATOR_FAILED = "sway-to-kdl failed on this directive; translate it by hand"
READER_FAILED = (
    "sway-to-kdl failed reading the config and stopped; translate the rest by hand"
)


class Translator:
    def __init__(self) -> None:
        self.frontend = Frontend()
        self.doc = Document()

    def warn(self, source: Path, line: int, text: str, reason: str) -> None:
        self.doc.report(Report(Pos(source, line), reason, text.strip()))

    def satisfied(self, text: str) -> None:
        self.doc.note(f"sway-to-kdl: satisfied by swayward defaults: {text.strip()}")

    def parse(self, path: Path) -> None:
        """Translate the config at path, with every file it includes.

        The directives come from a stack of sources: the file, then each
        block body and included file on top of the source that names it, so
        they run in sway's order (sway/config.c:795-796,
        sway/commands/include.c:11). A loop over the stack rather than
        recursion keeps any include depth off Python's recursion limit;
        sway sets no include depth limit either (sway/config.c:555-624).

        A front-end failure while reading a block body or an included file
        is reported on the directive that opened it, and translation goes
        on after it; one while reading the config itself is reported and
        stops.
        """
        stack: list[tuple[Directive | None, Iterator[Directive]]] = [
            (None, self.frontend.run(path, self))
        ]
        while stack:
            opened_by, source = stack[-1]
            try:
                directive = next(source, None)
            except Exception as error:  # the front end's own failure, unforeseen
                stack.pop()
                if opened_by is None:
                    self.warn(path, 0, repr(error), READER_FAILED)
                else:
                    d = opened_by
                    reason = f"{TRANSLATOR_FAILED} ({error!r})"
                    self.warn(d.pos.path, d.pos.line, d.text, reason)
                continue
            if directive is None:
                stack.pop()
                continue
            nested = self.dispatch(directive)
            if nested is not None:
                stack.append((directive, nested))

    def dispatch(self, d: Directive) -> Iterator[Directive] | None:
        """Run d through the handler for its name, ignoring ASCII case
        (sway/commands.c:145-149).

        A handler returns False when it does not translate the line, which is
        then reported as unhandled. A block goes to its block handler; one
        without, or one its handler declines, runs line by line with the
        block's name as prefix (sway/config.c:719-729,795-796), and its
        header and closing line run nothing (sway/commands.c:355-366).

        Such a block's lines, and an include's files, are returned as the
        source parse runs next.

        Every input a handler refuses gets a report of its own. An exception
        none foresaw becomes one report for the directive that raised it,
        and translation goes on with the next.
        """
        try:
            return self.dispatch_unguarded(d)
        except Exception as error:
            self.warn(d.pos.path, d.pos.line, d.text, f"{TRANSLATOR_FAILED} ({error!r})")
            return None

    def dispatch_unguarded(self, d: Directive) -> Iterator[Directive] | None:
        lowered = d.lowered()
        if d.block is not None:
            block_handler = BLOCK_HANDLERS.get(lowered.name)
            if block_handler is None or not block_handler(self, lowered):
                return self.frontend.walk(d.block.body, self, block_name(d.text))
            return None
        if lowered.name == "include" and d.args:
            return self.frontend.include_files(self, d)
        handler = HANDLERS.get(lowered.name)
        if handler is None or not handler(self, lowered):
            self.warn(d.pos.path, d.pos.line, d.text, "unhandled")
        return None

    def h_bar_block(self, d: Directive) -> bool:
        # One report for the whole block, echoing its source lines.
        echo = " | ".join(line.strip(SWAY_WHITESPACE) for line in d.block.raw)
        self.warn(
            d.pos.path,
            d.pos.line,
            echo,
            "bar blocks are unsupported; use waybar "
            "(docs/SWAY_CONFIG_MIGRATION.md#replace-swaybar)",
        )
        return True

    def h_mode_block(self, d: Directive) -> bool:
        args = d.args[:-1]  # without the "{"
        pango_markup = args[:1] == ["--pango_markup"]
        if pango_markup:
            args = args[1:]
        if len(args) != 1:
            return False
        # cmd_mode strips the quotes from the name itself (sway/commands/mode.c:42).
        self.translate_mode(
            strip_quotes(args[0]), body_lines(d.block.body), pango_markup
        )
        return True

    def h_for_window_block(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(
            rf'for_window\s*(\[(?:[^"\]]|"{QUOTED_VALUE}")+\])\s*\{{', text
        ):
            body = [line.text for line in body_lines(d.block.body)]
            self.translate_for_window_commands(path, line_no, match.group(1), body)
        else:
            return False
        return True

    def h_device_block(self, d: Directive) -> bool:
        if len(d.argv) < 3:
            return False
        body = [line.text for line in body_lines(d.block.body)]
        extra = d.argv[2:-1]  # header words after the selector prefix each line
        if extra:
            body = [expand_line(join_args(extra), item, False) for item in body]
        self.translate_device_block(d, d.args[0], body)
        return True

    def h_device(self, d: Directive) -> bool:
        if len(d.argv) < 3:
            return False
        settings = text_after(d.text, d.argv, 2)
        self.translate_device_block(d, d.args[0], [settings])
        return True

    def h_bind(self, d: Directive) -> bool:
        if not d.args:
            return False
        self.translate_bind(d)
        return True

    def h_exec(self, d: Directive) -> bool:
        self.translate_exec(d)
        return True

    def h_nop(self, d: Directive) -> bool:
        text = d.text
        if re.fullmatch(r"nop(?:\s+.*)?", text):
            self.doc.note(f"sway {text}")
        else:
            return False
        return True

    def h_unsupported_binding(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if re.match(r"(?:un)?bind(?:gesture|switch)(?:\s|$)", text):
            self.refuse_unsupported_binding(path, line_no, text)
        else:
            return False
        return True

    def h_for_window(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.match(
            rf'for_window\s*(\[(?:[^"\]]|"{QUOTED_VALUE}")+\])\s+(.+)', text
        ):
            self.translate_for_window(path, line_no, match.group(1), match.group(2))
        elif text.startswith("for_window"):
            self.warn(
                path,
                line_no,
                text,
                "criteria need manual conversion to a window-rule match",
            )
        else:
            return False
        return True

    def h_no_focus(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"no_focus\s+(\[[^]]+\])", text):
