                    line_no,
                    text,
                    "unknown focus wrapping mode is refused instead of treated as no",
                )
        else:
            return False
        return True

    def h_floating_modifier(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"floating_modifier\s+(.+)", text, re.IGNORECASE):
            self.translate_floating_modifier(path, line_no, text, match.group(1))
        else:
            return False
        return True

    def h_focus_on_window_activation(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"focus_on_window_activation\s+(\S+)", text):
            value = match.group(1)
            if value in {"smart", "urgent", "focus", "none"}:
                legacy_add(
                    self.doc.body, Node("focus-on-window-activation", [value])
                )
            else:
                self.warn(path, line_no, text, "expected focus_on_window_activation smart|urgent|focus|none")
        else:
            return False
        return True

    def h_force_display_urgency_hint(self, d: Directive) -> bool:
        text = d.text
        if match := re.fullmatch(
            r"force_display_urgency_hint\s+(-?\d+)(?:\s*ms)?",
            text,
            re.IGNORECASE,
        ):
            self.doc.urgent_timeout = Node(
                "urgent-timeout-ms", [max(0, int(match.group(1)))]
            )
        else:
            return False
        return True

    def h_primary_selection(self, d: Directive) -> bool:
        text = d.text
        if match := re.fullmatch(r"primary_selection\s+(\S+)", text, re.IGNORECASE):
            enabled = match.group(1).lower() in {
                "1", "yes", "on", "true", "enable", "enabled", "active"
            }
            if not enabled:
                legacy_add(
                    self.doc.body,
                    Node("clipboard", children=[Node("disable-primary")], inline=True),
                )
        else:
            return False
        return True

    def h_xwayland(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"xwayland\s+(\S+)", text, re.IGNORECASE):
            # sway's force means start Xwayland immediately rather than
            # lazily; swayward runs xwayland-satellite, which is on unless
            # switched off, so only the disabled case emits anything.
            value = match.group(1).lower()
            if value in {"disable", "disabled", "no", "false", "0"}:
                legacy_add(
                    self.doc.body, Node("xwayland-satellite", children=[Node("off")])
                )
            elif value in {"enable", "enabled", "yes", "true", "1", "force"}:
                self.satisfied(text)
            else:
                self.warn(
                    path, line_no, text, "expected xwayland enable|disable|force"
                )
        else:
            return False
        return True

    def h_mouse_warping(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"mouse_warping\s+(\S+)", text, re.IGNORECASE):
            self.translate_mouse_warping(path, line_no, text, match.group(1))
        else:
            return False
        return True

    def h_swaybg_command(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"swaybg_command\s+(.+)", text):
            if match.group(1).strip() == "-":
                self.satisfied(text)
            else:
                self.warn(
                    path,
                    line_no,
                    text,
                    "custom swaybg launch command is unsupported",
                )
