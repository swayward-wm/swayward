# ---------------------------------------------------------------------------
# KDL IR
#
# What the handlers build: nodes holding typed values, gathered on a Document
# with one field per output group. Nothing here formats text; render() does.
# ---------------------------------------------------------------------------


@dataclass(frozen=True)
class Raw:
    """Source text emitted verbatim and unchecked: a gap in typed validation.

    Used for output `scale`, `position`, `geometry-corner-radius`, blur
    `passes` and `offset`, generic input values, and digit strings that are
    emitted as written (`width=007`).
    """

    text: str


# A module-level alias is evaluated at import, so it spells the union with
# typing.Union for Python 3.9. Annotations may use `|`: they stay strings.
Value = Union[str, int, float, bool, Raw]


@dataclass
class Comment:
    text: str  # without the leading "// "


@dataclass
class Node:
    """A KDL node. add, set and put say how a child joins its parent.

    add appends a repeatable child or a comment. set and put take a
    singular child, last wins: set drops any child of that name and appends;
    put replaces the first such child in place, and appends only when there
    is none.
    """

    name: str  # rendered bare, except that an all-digit name is quoted
    args: list[Value] = field(default_factory=list)
    props: list[tuple[str, Value]] = field(default_factory=list)  # repeats allowed
    children: list[Node | Comment] = field(default_factory=list)
    inline: bool = False  # `{ fixed 100; }`, bind lines
    block: bool = False  # braces even with no children: `output "x" {` `}`

    def add(self, child: Node | Comment) -> None:
        self.children.append(child)

    def set(self, child: Node) -> None:
        self.remove(child.name)
        self.children.append(child)

    def put(self, child: Node, *aliases: str) -> None:
        """Replace in place the first child named child.name or an alias.

        Aliases name one setting spelled as different nodes: blur `on`/`off`.
        """
        names = {child.name, *aliases}
        for index, existing in enumerate(self.children):
            if isinstance(existing, Node) and existing.name in names:
                self.children[index] = child
                return
        self.children.append(child)

    def get(self, name: str) -> Node | None:
        return next(
            (
                child
                for child in self.children
                if isinstance(child, Node) and child.name == name
            ),
            None,
        )

    def remove(self, name: str) -> None:
        self.children = [
            child
            for child in self.children
            if not (isinstance(child, Node) and child.name == name)
        ]

    def report(self, report: Report, doc: Document) -> None:
        doc.manual.append(report.item)
        self.add(Comment(f"sway-to-kdl: {report.item}"))


