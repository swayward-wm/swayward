from dataclasses import dataclass, field, replace
from pathlib import Path
from typing import Callable, Iterator, Union


# ---------------------------------------------------------------------------
# Legacy helpers
#
# Each one departs from sway; its entry names the rule it departs from.
#
# - LEGACY_MODIFIER_ALIASES: one table of modifiers and XKB groups (keyboard.c:24-50, bind.c:398-449).
# - legacy_keep_first: a duplicate binding keeps the first; sway keeps the last (bind.c:280-300).
# - legacy_bind_trailing_options: reads options after the key; sway only before (bind.c:353-383).
# - legacy_exec_unquote: strips one pair of outer quotes from an exec command (exec_always.c:39-44).
# - legacy_unescape_at: turns `\@` into `@` in a bind command.
# - legacy_command_spelling: respells some bind commands.
# - legacy_add: appends a SINGULAR child without dropping an earlier one.
# - legacy_g_float: formats a float with `:g`, so 1.0 renders as `1`.
# - legacy_workspace_assignment: assigned workspaces render first.
#
# Most handlers parse Directive.text with regexes and str.split rather
# than Directive.args, so their arguments are not unescaped.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Lexer
#
# Ports of sway 1.12's argument primitives, one function per C function, with
# their quirks kept: a backslash toggles the escape state, brackets nest one
# level deep, and unescape_string's "\0" truncates. The C functions work on
# NUL-terminated bytes, so every port first cuts its input at the first NUL.
# Python strings hold code points rather than bytes; every character sway
# treats specially is ASCII, so the two agree except where noted.
# ---------------------------------------------------------------------------

# `whitespace` in common/stringop.c:13, and isspace() in the C locale.
SWAY_WHITESPACE = " \f\n\r\t\v"


def _c_string(s: str) -> str:
    return s.split("\0", 1)[0]


def split_args(s: str) -> list[str]:
    """Sway's `split_args` (common/stringop.c:92-143).

    Splits on runs of whitespace outside '...', "..." and one level of [...].
    Quote characters and backslashes stay in the tokens, and a backslash makes
    the next character literal, including whitespace.
    """
    s = _c_string(s)
    argv: list[str] = []
    in_token = in_string = in_char = in_brackets = escaped = False
    start = end = 0
    while start < len(s):
        if not in_token:
            while end < len(s) and s[end] in SWAY_WHITESPACE:
                end += 1
            start = end
            in_token = True
        ch = s[end] if end < len(s) else ""
        if ch == '"' and not in_char and not escaped:
            in_string = not in_string
        elif ch == "'" and not in_string and not escaped:
            in_char = not in_char
        elif (
            ch == "["
            and not in_string
            and not in_char
            and not in_brackets
            and not escaped
        ):
            in_brackets = True
        elif (
            ch == "]" and not in_string and not in_char and in_brackets and not escaped
        ):
            in_brackets = False
        elif ch == "\\":
            escaped = not escaped
        elif ch == "" or (
            not in_string
            and not in_char
            and not in_brackets
            and not escaped
            and ch in SWAY_WHITESPACE
        ):
            if end > start:
                argv.append(s[start:end])
            in_token = False
            escaped = False
            continue
        if ch != "\\":
            escaped = False
        end += 1
    return argv


def strip_quotes(s: str) -> str:
    """Sway's `strip_quotes` (common/stringop.c:26-50).

    Deletes every unescaped quote character that opens or closes a quoted
    run, wherever it is; a ' inside "..." stays, and so do backslashes.
    """
    out: list[str] = []
    in_str = in_chr = escaped = False
    for ch in _c_string(s):
        if ch == "'" and not in_str and not escaped:
            in_chr = not in_chr
            continue
        if ch == '"' and not in_chr and not escaped:
            in_str = not in_str
            continue
        if ch == "\\":
            escaped = not escaped
        else:
            escaped = False
        out.append(ch)
    return "".join(out)


def argsep(s: str, delims: str) -> tuple[str, str, str | None]:
    r"""Sway's `argsep` (common/stringop.c:267-312), without the in-place edit.

    Returns (segment, matched, rest): the text before the first delimiter
    outside quotes, that delimiter ("" at the end of input), and the text
    after it (None at the end of input, where C sets *stringp to NULL).
    Delimiters before any other character are skipped. An escape lasts while
    the characters sway inspects are adjacent, so in `\";` the ';' is
    escaped too.
    """
    s = _c_string(s)
    start = end = 0
    in_string = in_char = escaped = False
    while True:
        # argsep_next_interesting (:255-265): the first quote, backslash or
        # delimiter at or after end.
        interesting = next(
            (i for i in range(end, len(s)) if s[i] in "\"'\\" or s[i] in delims),
            None,
        )
        if interesting is None:
            return s[start:], "", None
        if escaped and interesting != end:
            escaped = False
        ch = s[interesting]
        if ch == '"' and not in_char and not escaped:
            in_string = not in_string
            end = interesting + 1
        elif ch == "'" and not in_string and not escaped:
            in_char = not in_char
            end = interesting + 1
        elif ch == "\\":
            escaped = not escaped
            end = interesting + 1
        elif not in_string and not in_char and not escaped:
            end = interesting
            if end - start:
                return s[start:end], ch, s[end + 1 :]
            start += 1
            end = start
        else:
            end += 1


_UNESCAPES = {
    "a": "\a",
    "b": "\b",
    "f": "\f",
    "n": "\n",
    "r": "\r",
    "t": "\t",
    "v": "\v",
    "'": "'",
    '"': '"',
    "?": "?",
}


def unescape_string(s: str) -> str:
    r"""Sway's `unescape_string` (common/stringop.c:152-234).

    C overwrites each escape with NUL holes and shifts them out at the end,
    which this port mirrors with "\0" in a list. Hence the quirks:

    - `\0` returns at once, before the shift, so the result ends at the first
      hole: `a\tb\0` gives "a\t".
    - `\x` reads at most two decimal digits as hex. A digit leaves a hole
      where the scan continues, so no escape after it is processed.
    - An unknown escape stays as written, and `\\` becomes one backslash.

    A trailing backslash makes C read past the terminator (undefined); the
    port keeps the backslash. `\x80` to `\x99` yield one byte in C and the
    code point of that value here.
    """
    buf = list(_c_string(s))
    n = len(buf)
    i = 0
    while i < n and buf[i] != "\0":
        if buf[i] == "\\":
            i += 1
            if i == n:
                break
            ch = buf[i]
            if ch == "0":
                buf[i - 1] = "\0"
                return "".join(buf).split("\0", 1)[0]
            if ch in _UNESCAPES:
                buf[i - 1] = _UNESCAPES[ch]
                buf[i] = "\0"
            elif ch == "\\":
                buf[i] = "\0"
            elif ch == "x":
                value = 0
                if i + 1 < n and "0" <= buf[i + 1] <= "9":
                    value = ord(buf[i + 1]) - ord("0")
                    if i + 2 < n and "0" <= buf[i + 2] <= "9":
                        value = value * 0x10 + ord(buf[i + 2]) - ord("0")
                        buf[i + 2] = "\0"
                    buf[i + 1] = "\0"
                buf[i] = "\0"
                buf[i - 1] = chr(value)
        i += 1
    return "".join(ch for ch in buf if ch != "\0")


def join_args(args: list[str]) -> str:
    """Sway's `join_args` (common/stringop.c:236-253).

    C asserts argc > 0 and returns NULL; this raises ValueError instead.
    """
    if not args:
        raise ValueError("argc should be positive")
    return " ".join(args)


@dataclass
class Command:
    criteria: str | None  # raw "[...]" token, valid for its ';' segment
    argv: list[str]  # split_args tokens, quotes kept


class CriteriaError(ValueError):
    """A criteria block sway's criteria_parse rejects; sway runs nothing."""


def criteria_length(s: str) -> int:
    """Length of the raw "[...]" at the start of s, as criteria_parse scans it
    (sway/criteria.c:780-871).

    Only the extent is ported. Token names and values are not validated, so
    `[foo=bar]` passes here while sway rejects it; an empty name stops the scan
    with sway's error, since C would make no progress on it either.
    """
    head = 0

    def skip_spaces() -> None:  # :746-750, spaces only
        nonlocal head
        while head < len(s) and s[head] == " ":
            head += 1

    skip_spaces()
    if not s.startswith("[", head):
        raise CriteriaError("No criteria")
    head += 1
    tokens = 0
    while head < len(s) and s[head] != "]":
        skip_spaces()
        name_start = head
        while head < len(s) and ("a" <= s[head] <= "z" or s[head] == "_"):
            head += 1
        name = s[name_start:head]
        skip_spaces()
        if s.startswith("=", head):
            head += 1
            skip_spaces()
            in_quotes = s.startswith('"', head)
            if in_quotes:
                head += 1
                while head < len(s) and (s[head] != '"' or s[head - 1] == "\\"):
                    head += 1
                if head == len(s):
                    raise CriteriaError("Quote mismatch in criteria")
                head += 1
            else:
                while head < len(s) and s[head] not in " ]":
                    head += 1
        if not name:
            raise CriteriaError(f"Token '{name}' is not recognized")
        tokens += 1
        skip_spaces()
    if head == len(s):
        raise CriteriaError("No closing brace found in criteria")
    if not tokens:
        raise CriteriaError("Criteria is empty")
    return head + 1


def split_command_list(s: str) -> list[Command]:
    """The command-list loop of sway's `execute_command`
    (sway/commands.c:205-335).

    Criteria are parsed only at the start of a ';' segment and apply to every
    ',' command in it. Segments are cut with argsep(";,") and empty ones are
    skipped. Quotes are not stripped: sway does that per command, after
    looking at argv[0] (:264-272).
    """
    commands: list[Command] = []
    head: str | None = _c_string(s)
    matched = ";"
    criteria: str | None = None
    while head is not None:
        head = head.lstrip(SWAY_WHITESPACE)
        if matched == ";":
            criteria = None
            if head.startswith("["):
                length = criteria_length(head)
                criteria = head[:length]
                head = head[length:].lstrip(SWAY_WHITESPACE)
        segment, matched, head = argsep(head, ";,")
        segment = segment.lstrip(SWAY_WHITESPACE)
        if not segment:
            continue
        commands.append(Command(criteria, split_args(segment)))
    return commands


# ---------------------------------------------------------------------------
# Reader
#
# read_config segments a file into logical lines and blocks by sway 1.12's
# rules (sway/config.c:666-869). It expands no variables and runs no
# includes: sway runs both as directives, in source order, so the front end
# does.
# ---------------------------------------------------------------------------


@dataclass(frozen=True)
class Pos:
    path: Path
    line: int  # first physical line; 0 = the whole file


@dataclass(frozen=True)
class Line:
    text: str  # logical line: continuation joined, stripped
    raw: tuple[str, ...]  # the physical lines it came from, unstripped
    pos: Pos


@dataclass
class Block:
    header: Line  # text without the trailing "{"
    body: list[Line | Block]
    raw: tuple[str, ...]  # header through closing line
    end: Line | None = None  # the closing line; None if the file ended first


# The block read_config hands to config_commands_command (sway/config.c:805-807).
COMMANDS_BLOCK = "<commands>"


def _physical_lines(data: str) -> list[str]:
    """getline's view of a file: split after each "\\n", which stays."""
    lines = data.split("\n")
    physical = [line + "\n" for line in lines[:-1]]
    if lines[-1]:
        physical.append(lines[-1])
    return physical


def read_config(path: Path) -> list[Line | Block]:
    r"""Sway's line and block rules (`read_config`, sway/config.c:732-869).

    - A physical line ending in `\` and a newline is joined with the next,
      whose leading whitespace stays, unless its first byte is `#`
      (`getline_with_cont`, :666-694). The result is cut at a NUL, stripped,
      and skipped when blank or starting with `#`; a later `#` is text.
    - A line opens a block when the last `split_args` token of the line as
      config_command sees it is `{` and there are at least two tokens
      (sway/commands.c:355-360). Inside a block the header prefix supplies
      the first token (`expand_line`, config.c:719-729), so a lone `{`
      opens one.
    - A line whose last character is neither `{` nor `}` takes " {" from the
      next nonblank physical line when that line is exactly `{`
      (`detect_brace`, :696-717). Blank lines before it are consumed; a
      comment stops the search. The " {" joins the line before it is split,
      so `x "abc` swallows the `{` into its open quote and opens nothing.
    - A last token of `}` closes the innermost block
      (sway/commands.c:362-366), whatever precedes it: `X { a }` closes the
      enclosing block, and at top level it is an unmatched `}`
      (config.c:842-846) that this returns as a Line. A block still open at
      the end of the file ends there with no `end`, as sway's stack is
      dropped silently.
    - A top-level block named exactly `<commands>` sends every later line to
      config_commands_command (config.c:805-807). That never returns
      CMD_BLOCK, nor CMD_BLOCK_END, since each line's first token is the
      prefix `<commands>` (sway/commands.c:452-481): the block takes the rest
      of the file as its body, as Lines, and has no end.

    Bytes are decoded as UTF-8 with surrogateescape and only "\n" ends a line,
    as with getline. A header's text drops the `{` token and the whitespace
    before it, unless escaped (`\ {`); join_args over its split_args tokens
    is sway's block name. A header's raw includes the blank and `{` lines
    detect_brace consumed, and Block.raw every physical line from the header
    through the closing line, comments included.
    """
    physical = _physical_lines(path.read_bytes().decode("utf-8", "surrogateescape"))
    raw = [line[:-1] if line.endswith("\n") else line for line in physical]
    top: list[Line | Block] = []
    stack: list[tuple[Block, int]] = []  # open blocks, with their first index
    commands: Block | None = None
    index = 0
    while index < len(physical):
        start = index
        buffer = physical[index]
        index += 1
        while (
            buffer.endswith("\\\n")
            and not buffer.startswith("#")
            and index < len(physical)
        ):
            buffer = buffer[:-2] + physical[index]
            index += 1
        text = _c_string(buffer).strip(SWAY_WHITESPACE)
        if not text or text.startswith("#"):
            continue
        if text[-1] not in "{}":
            probe = index
            while probe < len(physical):
                candidate = _c_string(physical[probe]).strip(SWAY_WHITESPACE)
                probe += 1
                if candidate:
                    if candidate == "{":
                        text += " {"
                        index = probe
                    break
        line = Line(text, tuple(raw[start:index]), Pos(path, start + 1))
        if commands is not None:
            commands.body.append(line)
            continue
        parent = stack[-1][0].body if stack else top
        tokens = split_args(text)
        if tokens and tokens[-1] == "{" and (len(tokens) > 1 or stack):
            name = text[:-1].rstrip(SWAY_WHITESPACE)
            if (len(name) - len(name.rstrip("\\"))) % 2:
                name = text[: len(name) + 1]  # `\ {`: the space is escaped
            block = Block(Line(name, line.raw, line.pos), [], ())
            parent.append(block)
            stack.append((block, start))
            if len(stack) == 1 and tokens[:-1] == [COMMANDS_BLOCK]:
                commands = block
        elif tokens and tokens[-1] == "}" and stack:
            block, first = stack.pop()
            block.end = line
            block.raw = tuple(raw[first:index])
        else:
            parent.append(line)
    for block, first in stack:
        block.raw = tuple(raw[first:])
    return top


def expand_line(block: str | None, line: str, add_brace: bool) -> str:
    """Sway's `expand_line` (sway/config.c:719-729)."""
    prefix = f"{block} " if block is not None else ""
    return prefix + line + (" {" if add_brace else "")


def block_name(text: str) -> str | None:
    """The block a line opens, as config_command names it: join_args over its
    split_args tokens without the last `{` (sway/commands.c:355-358)."""
    tokens = split_args(text)
    if tokens[-1:] == ["{"]:
        tokens = tokens[:-1]
    return join_args(tokens) if tokens else None


def flatten(
    nodes: list[Line | Block], block: str | None = None
) -> Iterator[tuple[Line, str]]:
    """The lines read_config hands config_command, with sway's prefix.

    Yields (line, expanded) for every node in read order: a block's header
    (with " {"), its body, and its closing line. Inside a block the prefix is
    the block name, and it accumulates: `bar {` + `colors {` + `a` runs
    `bar colors a`. Tokens match sway's; whitespace inside an explicit
    header line is collapsed.
    """
    for node in nodes:
        if isinstance(node, Line):
            yield node, expand_line(block, node.text, False)
            continue
        yield node.header, expand_line(block, node.header.text, True)
        name = join_args(split_args(expand_line(block, node.header.text, False)))
        yield from flatten(node.body, name)
        if node.end is not None:
            yield node.end, expand_line(name, node.end.text, False)


def body_lines(nodes: list[Line | Block], prefix: str | None = None) -> list[Line]:
    """A block body as the lines sway runs, without the block's own prefix.

    A nested block contributes its body lines, prefixed with its name
    (sway/config.c:719-729); its header and closing line run nothing.
    """
    lines: list[Line] = []
    for node in nodes:
        if isinstance(node, Line):
            if prefix is not None:
                node = Line(expand_line(prefix, node.text, False), node.raw, node.pos)
            lines.append(node)
        else:
            name = block_name(expand_line(prefix, node.header.text, False))
            lines += body_lines(node.body, name)
    return lines


# ---------------------------------------------------------------------------
# Front end
#
# Variables, includes and the set of files already read, handled in source
# order as sway does. run() reads each file with read_config, handles set
# and include itself, and yields a Directive for every other line and for
# every block, expanded.
# ---------------------------------------------------------------------------

# config_command keeps quotes in these handlers' arguments
# (sway/commands.c:409-423).
QUOTED_ARGUMENT_COMMANDS = frozenset(
    {
        "exec",
        "exec_always",
        "mode",
        "bindsym",
        "bindcode",
        "bindswitch",
        "bindgesture",
        "set",
        "for_window",
    }
)

_ASCII_LOWER = str.maketrans(
    "ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz"
)


def ascii_lower(s: str) -> str:
    """Lower case as strcasecmp compares in the C locale: ASCII letters only."""
    return s.translate(_ASCII_LOWER)


def unquote_args(args: list[str], strip: bool = True) -> list[str]:
    """config_command's per-argument step (sway/commands.c:409-423): quotes
    stripped from an argument that starts with one, unless strip is False,
    then unescaped."""
    return [
        unescape_string(strip_quotes(arg) if strip and arg[:1] in "\"'" else arg)
        for arg in args
    ]


def command_words(command: Command) -> list[str]:
    """A listed command's argv as its handler sees it: quotes stripped from
    every argument that starts with one, except under exec, exec_always and
    mode (sway/commands.c:264-272)."""
    argv = command.argv
    if argv[0] in {"exec", "exec_always", "mode"}:
        return list(argv)
    return [argv[0], *(strip_quotes(a) if a[:1] in "\"'" else a for a in argv[1:])]


def text_after(text: str, argv: list[str], count: int) -> str:
    """text after its first count split_args tokens (argv), stripped."""
    index = 0
    for token in argv[:count]:
        index = text.index(token, index) + len(token)
    return text[index:].strip(SWAY_WHITESPACE)


@dataclass
class Directive:
    name: str  # argv[0] as written
    argv: list[str]  # split_args after expansion, quotes kept
    # config_command's view of argv[1:]: unescaped, with quotes stripped
    # except under QUOTED_ARGUMENT_COMMANDS; set's variable name is left alone.
    args: list[str]
    text: str  # expanded logical text, used in messages
    pos: Pos
    block: Block | None = None  # the block this line opens; text ends in " {"

    @classmethod
    def from_line(cls, text: str, pos: Pos, block: Block | None = None) -> Directive:
        argv = split_args(text)
        name = argv[0] if argv else ""
        command = ascii_lower(name)  # find_core_handler ignores case
        first = 2 if command == "set" else 1
        args = argv[1:first] + unquote_args(
            argv[first:], command not in QUOTED_ARGUMENT_COMMANDS
        )
        return cls(name, argv, args, text, pos, block)

    def lowered(self) -> Directive:
        """This directive with its name in lower case, as the handler tables
        and patterns spell it: sway looks handlers up with strcasecmp
        (sway/commands.c:145-149)."""
        name = ascii_lower(self.name)
        if name == self.name:
            return self
        return replace(
            self,
            name=name,
            argv=[name, *self.argv[1:]],
            text=name + self.text[len(self.name) :],
        )


SET_DIRECTIVE = re.compile(r"(?i:set)\s+(\$+[^\s]+)\s+(.+)")

UNMATCHED_BLOCK_END = (
    "sway rejects a line whose last token is `}` outside a block; a block "
    "opened and closed on one line is unsupported (sway/sway/config.c:842-846)"
)
INNER_BLOCK_END = (
    "sway ends the block at a line whose last token is `}` and runs nothing on "
    "it; a block opened and closed on one line is unsupported "
    "(sway/sway/commands.c:362-366)"
)
COMMANDS_BLOCK_REFUSED = (
    "sway reads the rest of the file as the body of a <commands> block and "
    "rejects every line of it (sway/sway/config.c:805-807, "
    "sway/sway/commands.c:452-481)"
)


class Frontend:
    def __init__(self) -> None:
        self.variables: dict[str, str] = {}
        self.visited: set[Path] = set()

    def expand(self, text: str) -> str:
        variables = sorted(self.variables, key=len, reverse=True)
        output: list[str] = []
        index = 0
        while index < len(text):
            if text[index : index + 2] == "$$":
                output.append(r"\$")
                index += 2
                continue
            if text[index : index + 2] == r"\$":
                output.append(r"\$")
                index += 2
                continue
            name = next(
                (name for name in variables if text.startswith(name, index)), None
            )
            if name is not None:
                output.append(self.variables[name])
                index += len(name)
                continue
            output.append(text[index])
            index += 1
        return "".join(output)

    def define(self, name: str, value: str) -> None:
        """`set name value`: the value is expanded once, when it is set."""
        self.variables[name] = self.expand(value.strip()).replace(r"\$", "$")

    def run(self, path: Path, doc: Translator) -> Iterator[Directive]:
        path = path.expanduser().resolve()
        if path in self.visited:
            return
        try:
            nodes = read_config(path)
        except OSError as error:
            doc.warn(path, 0, "include", f"cannot read include: {error}")
            return
        self.visited.add(path)
        for node in nodes:
            if isinstance(node, Block) and split_args(node.header.text) == [
                COMMANDS_BLOCK
            ]:
                header = node.header
                doc.warn(path, header.pos.line, f"{header.text} {{", COMMANDS_BLOCK_REFUSED)
                continue
            yield from self.walk([node], doc)
            if isinstance(node, Block):
                self.report_block_ends(node, doc)

    def walk(
        self, nodes: list[Line | Block], doc: Translator, prefix: str | None = None
    ) -> Iterator[Directive]:
        """The directives of nodes; prefix is the enclosing block's expanded name."""
        for node in nodes:
            if isinstance(node, Block):
                header = self.expand(node.header.text).replace(r"\$", "$")
                text = expand_line(prefix, header, True)
                yield Directive.from_line(text, node.header.pos, node)
                continue
            if prefix is None and split_args(node.text)[-1:] == ["}"]:
                doc.warn(node.pos.path, node.pos.line, node.text, UNMATCHED_BLOCK_END)
                continue
            if match := SET_DIRECTIVE.fullmatch(expand_line(prefix, node.text, False)):
                self.define(match.group(1), match.group(2))
                continue
            expanded = self.expand(node.text).replace(r"\$", "$")
            directive = Directive.from_line(
                expand_line(prefix, expanded, False), node.pos
            )
            if ascii_lower(directive.name) == "include" and directive.args:
                yield from self.translate_include(doc, directive)
                continue
            yield directive

    def report_block_ends(self, block: Block, doc: Translator) -> None:
        if block.end is not None and block.end.text != "}":
            end = block.end
            doc.warn(end.pos.path, end.pos.line, end.text, INNER_BLOCK_END)
        for node in block.body:
            if isinstance(node, Block):
                self.report_block_ends(node, doc)

    def translate_include(self, doc: Translator, d: Directive) -> Iterator[Directive]:
        # cmd_include joins its arguments (sway/commands/include.c:9).
        source, line, text = d.pos.path, d.pos.line, d.text
        pattern = join_args(d.args)
        if "`" in pattern or "$(" in pattern:
            doc.warn(source, line, text, "include command substitution is refused")
            return
        pattern_path = Path(pattern).expanduser()
        if not pattern_path.is_absolute():
            pattern_path = source.parent / pattern_path
        matches = sorted(glob.glob(str(pattern_path)))
        if not matches:
            doc.warn(source, line, text, "include matched no files")
        for included in matches:
            yield from self.run(Path(included), doc)


# ---------------------------------------------------------------------------
# Handlers
#
# Report, the handlers' own helpers, and Translator: dispatch, the handlers
# and the translate_* helpers they call. They build nodes on a Document (see
# KDL IR); render() turns it into text. The handler tables follow the class.
# ---------------------------------------------------------------------------


@dataclass(frozen=True)
class Report:
    """A directive that needs manual attention.

    It becomes one manual-list item, `{pos}: {reason}: {text}`, and one
    `// sway-to-kdl:` comment where the translation would have gone: at top
    level through Document.report, inside a node through Node.report.
    """

    pos: Pos
    reason: str
    text: str

    @property
    def item(self) -> str:
        location = (
            f"{self.pos.path}:{self.pos.line}" if self.pos.line else str(self.pos.path)
        )
        return f"{location}: {self.reason}: {self.text}"


def preset_size(name: str, kind: str, value: Value) -> Node:
    """`default-column-width { fixed 100; }` and its kin."""
    return Node(name, children=[Node(kind, [value])], inline=True)


def background_effect(name: str, value: str) -> Node:
    """`background-effect { blur true }` from a SwayFX enable/disable word."""
    return Node("background-effect", children=[Node(name, [value in {"enable", "on"}])])


def shadow(value: str) -> Node:
    """`shadow { on }` from a SwayFX enable/disable word."""
    return Node("shadow", children=[Node("on" if value in {"enable", "on"} else "off")])


def legacy_keep_first(binds: dict[tuple, Node], key: tuple, node: Node) -> bool:
    """Bind node under key unless key is bound already; False when it is."""
    if key in binds:
        return False
    binds[key] = node
    return True


LEGACY_TRAILING_BIND_OPTIONS = {
    "--release",
    "--whole-window",
    "--border",
    "--exclude-titlebar",
}


def legacy_bind_trailing_options(command: str) -> tuple[list[str], str]:
    """The options that open a bind command, and the command without them."""
    options: list[str] = []
    while command.startswith("--"):
        option, separator, remainder = command.partition(" ")
        if not separator or option not in LEGACY_TRAILING_BIND_OPTIONS:
            break
        options.append(option)
        command = remainder.lstrip()
    return options, command


def legacy_exec_unquote(command: str) -> str:
    """An exec command with one matching pair of outer quotes stripped."""
    if command[:1] in {"\"", "'"} and command[-1:] == command[0]:
        return command[1:-1]
    return command


def legacy_unescape_at(command: str) -> str:
    """A bind command with every `\\@` replaced by `@`."""
    return command.replace(r"\@", "@")


def legacy_command_spelling(command: str) -> str:
    """A bind command in the spellings swayward's parser once required."""
    command = re.sub(
        r"^move\s+container\s+to\s+workspace", "move to workspace", command
    )
    command = re.sub(r"^splith$", "split h", command)
    command = re.sub(r"^splitv$", "split v", command)
    return re.sub(
        r"^(resize\s+(?:grow|shrink)\s+(?:width|height))\s+(\d+)px$",
        r"\1 \2 px",
        command,
    )


LEGACY_MODIFIER_ALIASES = {
    "Mod4": "Super",
    "Mod1": "Alt",
    "Shift": "Shift",
    "Lock": "Lock",
    "Control": "Control",
    "Ctrl": "Ctrl",
    "Alt": "Alt",
    "Mod2": "Num",
    # Sway's default XKB map assigns Mod5 to ISO_Level3_Shift. swayward's
    # compatibility spelling keeps that semantic name instead of the X11 bit.
    "Mod5": "ISO_Level3_Shift",
    "Super": "Super",
    # sway spells an XKB group qualifier Group1..Group4, with Mode_switch
    # as an alias for Group2. The typed KDL parser accepts the same names.
    "Group1": "Group1",
    "Group2": "Group2",
    "Group3": "Group3",
    "Group4": "Group4",
    "Mode_switch": "Mode_switch",
}


class Translator:
    def __init__(self) -> None:
        self.frontend = Frontend()
        self.doc = Document()

    def warn(self, source: Path, line: int, text: str, reason: str) -> None:
        self.doc.report(Report(Pos(source, line), reason, text.strip()))

    def satisfied(self, text: str) -> None:
        self.doc.note(f"sway-to-kdl: satisfied by swayward defaults: {text.strip()}")

    def parse(self, path: Path) -> None:
        for directive in self.frontend.run(path, self):
            self.dispatch(directive)

    def dispatch(self, d: Directive) -> None:
        """Run d through the handler for its name, ignoring ASCII case
        (sway/commands.c:145-149).

        A handler returns False when it does not translate the line, which is
        then reported as unhandled. A block goes to its block handler; one
        without, or one its handler declines, runs line by line with the
        block's name as prefix (sway/config.c:719-729,795-796), and its
        header and closing line run nothing (sway/commands.c:355-366).
        """
        lowered = d.lowered()
        if d.block is not None:
            block_handler = BLOCK_HANDLERS.get(lowered.name)
            if block_handler is None or not block_handler(self, lowered):
                prefix = block_name(d.text)
                for directive in self.frontend.walk(d.block.body, self, prefix):
                    self.dispatch(directive)
            return
        handler = HANDLERS.get(lowered.name)
        if handler is None or not handler(self, lowered):
            self.warn(d.pos.path, d.pos.line, d.text, "unhandled")

    def h_bar_block(self, d: Directive) -> bool:
        # One report for the whole block, echoing its source lines.
        echo = " | ".join(line.strip(SWAY_WHITESPACE) for line in d.block.raw)
        self.warn(
            d.pos.path,
            d.pos.line,
            echo,
            "bar blocks are unsupported; use waybar "
            "(docs/SWAY_CONFIG_MIGRATION.md#replace-swaybar)",
        )
        return True

    def h_mode_block(self, d: Directive) -> bool:
        args = d.args[:-1]  # without the "{"
        pango_markup = args[:1] == ["--pango_markup"]
        if pango_markup:
            args = args[1:]
        if len(args) != 1:
            return False
        # cmd_mode strips the quotes from the name itself (sway/commands/mode.c:42).
        self.translate_mode(
            strip_quotes(args[0]), body_lines(d.block.body), pango_markup
        )
        return True

    def h_for_window_block(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(
            r'for_window\s*(\[(?:[^"\]]|"(?:\\.|[^"])*")+\])\s*\{', text
        ):
            body = [line.text for line in body_lines(d.block.body)]
            self.translate_for_window_commands(path, line_no, match.group(1), body)
        else:
            return False
        return True

    def h_device_block(self, d: Directive) -> bool:
        if len(d.argv) < 3:
            return False
        body = [line.text for line in body_lines(d.block.body)]
        extra = d.argv[2:-1]  # header words after the selector prefix each line
        if extra:
            body = [expand_line(join_args(extra), item, False) for item in body]
        self.translate_device_block(d.pos.path, d.pos.line, d.name, d.args[0], body)
        return True

    def h_device(self, d: Directive) -> bool:
        if len(d.argv) < 3:
            return False
        settings = text_after(d.text, d.argv, 2)
        self.translate_device_block(
            d.pos.path, d.pos.line, d.name, d.args[0], [settings]
        )
        return True

    def h_bind(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.match(r"(bindsym|bindcode)\s+(.+)", text):
            self.translate_bind(path, line_no, match.group(1), match.group(2))
        else:
            return False
        return True

    def h_exec(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"(exec|exec_always)(?:\s+(.*))?", text):
            self.translate_exec(
                path, line_no, text, match.group(1), match.group(2) or ""
            )
        else:
            return False
        return True

    def h_nop(self, d: Directive) -> bool:
        text = d.text
        if re.fullmatch(r"nop(?:\s+.*)?", text):
            self.doc.note(f"sway {text}")
        else:
            return False
        return True

    def h_unsupported_binding(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if re.match(r"(?:un)?bind(?:gesture|switch)(?:\s|$)", text):
            self.refuse_unsupported_binding(path, line_no, text)
        else:
            return False
        return True

    def h_for_window(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.match(
            r'for_window\s*(\[(?:[^"\]]|"(?:\\.|[^"])*")+\])\s+(.+)', text
        ):
            self.translate_for_window(path, line_no, match.group(1), match.group(2))
        elif text.startswith("for_window"):
            self.warn(
                path,
                line_no,
                text,
                "criteria need manual conversion to a window-rule match",
            )
        else:
            return False
        return True

    def h_no_focus(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"no_focus\s+(\[[^]]+\])", text):
            self.translate_no_focus(path, line_no, match.group(1))
        else:
            return False
        return True

    def h_assign(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        match = re.match(r"assign\s+(\[[^]]+\])\s+(?:→|->)?\s*(.+)", text)
        if match is None:
            return False
        # The target is config_command's arguments after the criteria.
        target = unquote_args(split_args(text[match.end(1) :]))
        self.translate_assign(path, line_no, match.group(1), target)
        return True

    def h_workspace(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        # The name is the arguments before `output` or `gaps`, joined
        # (sway/commands/workspace.c:130-166).
        args = d.args
        output = next((i for i, arg in enumerate(args) if arg == "output"), 0)
        gaps = next((i for i, arg in enumerate(args) if ascii_lower(arg) == "gaps"), 0)
        if output and len(args) > output + 1:
            workspace = join_args(args[:output])
            # Sway appends every output to one workspace_config in source
            # order (sway/commands/workspace.c:153-161).
            assignment = legacy_workspace_assignment(self.doc, workspace)
            assignment.args.extend(args[output + 1 :])
        elif gaps and (
            match := re.fullmatch(
                r"(inner|outer|horizontal|vertical|top|right|bottom|left)\s+(.+)",
                " ".join(args[gaps + 1 :]),
                re.IGNORECASE,
            )
        ):
            self.translate_gaps(
                path,
                line_no,
                text,
                match.group(1),
                match.group(2),
                join_args(args[:gaps]),
            )
        else:
            return False
        return True

    def h_font(self, d: Directive) -> bool:
        text = d.text
        if match := re.fullmatch(r"font\s+(pango:)?(.+)", text):
            self.doc.titlebar.pango_markup = match.group(1) is not None
            self.doc.titlebar.font = match.group(2)
        else:
            return False
        return True

    def h_client_colors(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(
            r"client\.(focused|focused_inactive|focused_tab_title|unfocused|urgent)\s+(.+)",
            text,
        ):
            self.translate_client_colors(path, line_no, text, match.group(1), match.group(2))
        else:
            return False
        return True

    def h_client_ignored(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"(client\.(?:background|placeholder))(?:\s+.*)?", text):
            self.warn(
                path,
                line_no,
                text,
                f"{match.group(1)} is accepted but ignored by sway itself "
                "(sway/sway/commands.c:51,55; sway/sway/commands/client.c:79-81)",
            )
        else:
            return False
        return True

    def h_gaps(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(
            r"gaps\s+(inner|outer|horizontal|vertical|top|right|bottom|left)\s+(.+)",
            text,
            re.IGNORECASE,
        ):
            self.translate_gaps(path, line_no, text, match.group(1), match.group(2))
        elif text.lower().startswith("gaps "):
            self.warn(path, line_no, text, "unsupported runtime or malformed gaps directive")
        else:
            return False
        return True

    def h_default_border(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(
            r"(default_border|default_floating_border|new_window|new_float)\s+(.+)",
            text,
        ):
            self.translate_default_border(
                path, line_no, text, match.group(1), match.group(2)
            )
        else:
            return False
        return True

    def h_floating_size(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(
            r"(floating_minimum_size|floating_maximum_size)\s+(-?\d+)\s+(x)\s+(-?\d+)",
            text,
        ):
            width, height = int(match.group(2)), int(match.group(4))
            if width < -1 or height < -1:
                self.warn(path, line_no, text, "floating size below -1 is unsupported")
            else:
                name = match.group(1).replace("_", "-")
                legacy_add(self.doc.layout, Node(name, [width, height]))
        else:
            return False
        return True

    def h_default_orientation(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"default_orientation\s+(\S+)", text, re.IGNORECASE):
            value = match.group(1).lower()
            if value in {"horizontal", "vertical", "auto"}:
                self.doc.layout.set(Node("default-orientation", [value]))
                self.doc.note(f"sway-to-kdl: sway {text}")
            else:
                self.warn(
                    path,
                    line_no,
                    text,
                    "expected default_orientation horizontal|vertical|auto",
                )
        else:
            return False
        return True

    def h_workspace_layout(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"workspace_layout\s+(\S+)", text, re.IGNORECASE):
            value = match.group(1).lower()
            if value in {"default", "stacking", "tabbed"}:
                legacy_add(self.doc.layout, Node("workspace-layout", [value]))
            else:
                self.warn(path, line_no, text, "unsupported workspace layout")
        else:
            return False
        return True

    def h_hide_edge_borders(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"hide_edge_borders\s+(.+)", text):
            arguments = match.group(1).split()
            values = {"none", "vertical", "horizontal", "both", "smart", "smart_no_gaps"}
            if arguments[:1] == ["--i3"] and len(arguments) == 2 and arguments[1] in values:
                self.warn(path, line_no, text, "hide_lone_tab has no exact swayward equivalent")
            elif len(arguments) != 1 or arguments[0] not in values:
                self.warn(
                    path,
                    line_no,
                    text,
                    "expected hide_edge_borders [--i3] none|vertical|horizontal|both|smart|smart_no_gaps",
                )
            else:
                value = arguments[0]
                edge = "none" if value.startswith("smart") else value
                self.doc.layout.set(Node("hide-edge-borders", [edge]))
                if value.startswith("smart"):
                    smart = "on" if value == "smart" else "no-gaps"
                    self.doc.layout.set(Node("smart-borders", [smart]))
        else:
            return False
        return True

    def h_smart_borders(self, d: Directive) -> bool:
        text = d.text
        if match := re.fullmatch(r"smart_borders\s+(\S+)", text):
            value = match.group(1)
            enabled = {"1", "yes", "on", "true", "enable", "enabled", "active"}
            setting = self.doc.layout.get("smart-borders")
            current = setting.args[0] if setting is not None else "off"
            if value == "no_gaps":
                smart = "no-gaps"
            elif value.lower() in enabled:
                smart = "on"
            elif value.lower() == "toggle":
                smart = "off" if current == "on" else "on"
            else:
                # sway's parse_boolean treats every other value as false.
                smart = "off"
            self.doc.layout.set(Node("smart-borders", [smart]))
        else:
            return False
        return True

    def h_smart_gaps(self, d: Directive) -> bool:
        path, line_no, text = d.pos.path, d.pos.line, d.text
        if match := re.fullmatch(r"smart_gaps\s+(\S+)", text, re.IGNORECASE):
            value = match.group(1).lower()
            if value == "inverse_outer":
                value = "inverse-outer"
            elif value not in {"on", "off"}:
                self.warn(path, line_no, text, "expected smart_gaps on|off|inverse_outer")
                return True
            self.doc.layout.set(Node("smart-gaps", [value]))
        else:
            return False
        return True

