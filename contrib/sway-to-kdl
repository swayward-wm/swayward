    def h_seat(self, d: Directive) -> bool:
        """cmd_seat (sway/commands/seat.c:53-81): a seat name, then a
        subcommand looked up ignoring ASCII case. swayward has one seat, and
        the cursor block holds its hide_cursor and xcursor_theme settings
        (swayward-config/src/misc.rs:103-113).

        A later setting wins, as sway merges each seat directive into the
        seat's config and `seat *` into every seat's (sway/config/seat.c:41-85).
        """

        def report(reason: str) -> None:
            self.warn(d.pos.path, d.pos.line, d.text, reason)

        args = d.args
        error = checkarg(args, "seat", 2, len(args))
        if error is not None:
            report(error)
            return True
        seat, subcommand, rest = args[0], ascii_lower(args[1]), args[2:]
        if seat == "-":
            report("Current seat alias (-) cannot be used in the config")
        elif subcommand not in SEAT_SUBCOMMANDS:
            report(f"Unknown/invalid command '{args[1]}'")
        elif subcommand not in {"hide_cursor", "xcursor_theme"}:
            report("unsupported seat directive")
        elif seat not in {"*", "seat0"}:
            # seat0 is the default seat (sway/input/input-manager.c:28).
            report("swayward has one seat; only seat * and seat seat0 translate")
        elif subcommand == "hide_cursor":
            self.translate_hide_cursor(rest, report)
        else:
            self.translate_xcursor_theme(rest, report)
        return True

    def translate_hide_cursor(
        self, args: list[str], report: Callable[[str], None]
    ) -> None:
        """seat_cmd_hide_cursor (sway/commands/seat/hide_cursor.c:10-48)."""
        cursor = self.doc.cursor
        error = checkarg(args, "hide_cursor", 1, 2)
        if error is not None:
            report(error)
        elif len(args) == 1:
            number = strtol_text(args[0])
            if number is None:
                report("Expected an integer timeout")
                return
            try:
                timeout = c_int("".join(number))
            except NumberError as out_of_range:
                report(str(out_of_range))
                return
            # A timeout below 100 ms other than 0 is raised to 100 ms, and 0
            # turns hiding off (:24-32), as no hide-after-inactive-ms does.
            if timeout == 0:
                cursor.remove("hide-after-inactive-ms")
            else:
                cursor.put(Node("hide-after-inactive-ms", [max(timeout, 100)]))
        elif args[0] != "when-typing":
            report("Expected 'hide_cursor <timeout>|when-typing [enable|disable]'")
        elif parse_boolean(args[1], True):
            cursor.put(Node("hide-when-typing"))
        else:
            cursor.remove("hide-when-typing")

    def translate_xcursor_theme(
        self, args: list[str], report: Callable[[str], None]
    ) -> None:
        """seat_cmd_xcursor_theme (sway/commands/seat/xcursor_theme.c:5-32):
        a theme and a size, 24 when none is given."""
        error = checkarg(args, "xcursor_theme", 1, 2)
        if error is not None:
            report(error)
            return
        size = 24
        if len(args) == 2:
            number = strtoul_size(args[1])
            if number is None:
                report("Expected a positive integer size")
                return
            size = number
        if not 1 <= size <= 255:
            report(
                "cursor size must be between 1 and 255; swayward stores it in "
                "a u8 (swayward-config/src/misc.rs:108)"
            )
            return
        self.doc.cursor.put(Node("xcursor-theme", [args[0]]))
        self.doc.cursor.put(Node("xcursor-size", [size]))

