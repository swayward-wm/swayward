    def translate_default_border(
        self, source: Path, line: int, text: str, directive: str, arguments: str
    ) -> None:
        words = arguments.split()
        style = words[0] if words else ""
        width = None
        if match := re.fullmatch(r"([0-9]+)pixel", style):
            width = border_width(match.group(1))
            if len(words) != 1 or width is None:
                self.warn(source, line, text, "unsupported default border")
                return
            style = "pixel"
        elif len(words) == 2 and style in {"normal", "pixel"}:
            width = border_width(words[1])
            if width is None:
                self.warn(source, line, text, "unsupported default border")
                return
        elif len(words) != 1 or style not in {"none", "normal", "pixel"}:
            self.warn(source, line, text, "unsupported default border")
            return
        if style == "none" and len(words) != 1:
            self.warn(source, line, text, "unsupported default border")
            return

        # These are layout defaults, not per-window rules: an unmatched
        # window-rule would apply the border to every window and no later
        # rule could override it. layout.default-border is the setting the
        # `default_border` IPC command also writes.
        floating = directive in {"default_floating_border", "new_float"}
        name = "default-floating-border" if floating else "default-border"
        props = [("width", width)] if width is not None else []
        # A config may set the same default twice, and new_window/new_float
        # are i3's aliases of the same settings. KDL rejects a duplicate
        # node, and sway's own behaviour is last-wins.
        self.doc.layout.set(Node(name, [style], props))

    def translate_floating_modifier(
        self, source: Path, line: int, text: str, arguments: str
    ) -> None:
        words = arguments.split()
        if not words:
            self.warn(
                source,
                line,
                text,
                "expected floating_modifier <mod> [inverse|normal]",
            )
            return
        modifier = words[0]
        # cmd_floating_modifier takes a modifier name or none
        # (sway/commands/floating_modifier.c:12-20).
        translated = (
            "None"
            if modifier.lower() == "none"
            else SWAY_MODIFIERS.get(ascii_lower(modifier), (None, 0))[0]
        )
        if translated not in {"None", "Ctrl", "Shift", "Alt", "Super"}:
            self.warn(source, line, text, f"unsupported modifier {modifier}")
            return
        mode = words[1].lower() if len(words) >= 2 else "normal"
        if mode not in {"inverse", "normal"}:
            self.warn(
                source,
                line,
                text,
                "expected floating_modifier <mod> [inverse|normal]",
            )
            return
        props = [("inverse", True)] if mode == "inverse" else []
        self.doc.input.set(Node("floating-modifier", [translated], props))

    def translate_mouse_warping(
        self, source: Path, line: int, text: str, value: str
    ) -> None:
        value = value.lower()
        # The last mouse_warping wins (sway/commands/mouse_warping.c:9-14).
        if value == "none":
            self.doc.input.remove("warp-mouse-to-focus")
            return
        if value in {"container", "output"}:
            # KDL has no mouse-warping spelling, so approximate both enabled
            # modes with the inherited centering option. The note records the
            # narrower output-mode semantics so the conversion is not silent.
            self.doc.input.set(
                Node("warp-mouse-to-focus", props=[("mode", "center-xy")])
            )
            if value == "output":
                self.doc.note(
                    "sway-to-kdl: mouse_warping output warps to the focused "
                    "output in sway; swayward warps to the focused window"
                )
            return
        self.warn(source, line, text, "expected mouse_warping output|container|none")

    def translate_client_colors(
        self, source: Path, line: int, text: str, state: str, arguments: str
    ) -> None:
        colors = arguments.split()
        if len(colors) < 3 or len(colors) > 5:
            self.warn(source, line, text, "client color requires 3 to 5 colors")
            return
        if any(color.startswith("$") for color in colors[:3]):
            self.warn(source, line, text, "unresolved color variable")
            return
        state = state.replace("_", "-")
        self.doc.titlebar.colors.put(
            Node(
                state,
                children=[
                    Node("border-color", [colors[0]]),
                    Node("background-color", [colors[1]]),
                    Node("text-color", [colors[2]]),
                ],
            )
        )
        ignored = [] if state == "focused-tab-title" else ["indicator", "child_border"]
        if ignored:
            self.warn(
                source,
                line,
                text,
                f"client.{state} {'/'.join(ignored)} colors have no titlebar equivalent",
            )

    def refuse_unsupported_binding(self, source: Path, line: int, text: str) -> None:
        directive = text.split(None, 1)[0]
        if directive in {"bindgesture", "unbindgesture"}:
            reason = (
                "gesture events cannot be bound to sway commands; "
                "only built-in compositor gestures and client forwarding are available"
            )
        else:
            reason = (
                "switch-events cannot preserve sway command bindings, binding modes, "
                "toggle, --locked, or --reload semantics"
            )
        self.warn(source, line, text, reason)

    def translate_exec(self, d: Directive) -> None:
        """exec and exec_always as cmd_exec_process builds the shell command
        (sway/commands/exec_always.c:28-45): a leading --no-startup-id is
        dropped, a single argument that starts with a quote loses its quotes,
        and anything else is joined with single spaces."""
        source, line, text, directive = d.pos.path, d.pos.line, d.text, d.name
        args = d.args
        if args[:1] == ["--no-startup-id"]:
            args = args[1:]
        if not args:
            self.warn(source, line, text, f"Expected '{directive} <command>'")
            return
        if len(args) == 1 and args[0][:1] in {"'", '"'}:
            command = strip_quotes(args[0])
        else:
            command = join_args(args)
        if directive == "exec_always":
            self.warn(
                source,
                line,
                text,
                "exec_always reload behavior is not preserved; "
                "spawn-sh-at-startup runs only when swayward starts "
                "(sway/sway/commands/exec.c:12-17; exec_always.c:83; "
                "src/main.rs:162,270-275)",
            )
        self.doc.body.add(Node("spawn-sh-at-startup", [command]))

    def translate_mode(
        self, name: str, body: list[Line], pango_markup: bool
    ) -> None:
        mode_binds: dict[tuple, Binding] = {}
        for item in body:
            source, line, text = item.pos.path, item.pos.line, item.text
            if match := SET_DIRECTIVE.fullmatch(text):
                self.frontend.define(match.group(1), match.group(2))
                continue
            text = self.frontend.expand(text).replace(r"\$", "$")
            # Mode subcommands are looked up ignoring case too
            # (sway/commands/mode.c:11-21, sway/commands.c:145-149).
            directive = Directive.from_line(text, item.pos).lowered()
            text = directive.text
            if directive.name in {"bindsym", "bindcode"} and directive.args:
                self.translate_bind(directive, mode_binds)
            elif re.match(r"(?:un)?bind(?:gesture|switch)(?:\s|$)", text):
                self.refuse_unsupported_binding(source, line, text)
            else:
                self.warn(source, line, text, f"unhandled directive in mode {name}")
        self.doc.modes.append(
            Node(
                "mode",
                [name],
                [("pango-markup", True)] if pango_markup else [],
                [binding.node for binding in mode_binds.values()],
                block=True,
            )
        )

    def translate_bind(
        self, d: Directive, binds: dict[tuple, Binding] | None = None
    ) -> None:
        """Add one binding to binds, the default mode's unless given.

        Follows cmd_bindsym_or_bindcode (sway/commands/bind.c:323-491): the
        options come before the key, the key is the next argument, and the
        command is every argument after it, joined with single spaces. The
        arguments are config_command's, unescaped with their quotes kept
        (sway/commands.c:409-423), so the command reaches swayward's command
        parser as sway's reaches execute_command.
        """
        if binds is None:
            binds = self.doc.binds
        source, line, kind, args = d.pos.path, d.pos.line, d.name, d.args

        def echo(consumed: int) -> str:
            # The directive's text after its name and the consumed arguments.
            return text_after(d.text, d.argv, 1 + consumed)

        properties: list[tuple[str, Value]] = []
        mouse_regions: set[str] = set()
        exclude_titlebar = False
        locked = False
        warn = True
        input_device = "*"
        region_options = {
            "--whole-window": {"titlebar", "border", "contents"},
            "--border": {"border"},
            "--exclude-titlebar": set(),
        }
        index = 0
        while index < len(args) and args[index].startswith("--"):
            option = args[index]
            index += 1
            if option.startswith("--input-device="):
                # The last --input-device is the binding's (bind.c:370-373).
                input_device = strip_quotes(option[len("--input-device=") :])
                properties = [p for p in properties if p[0] != "input-device"]
                properties.append(("input-device", input_device))
            elif index == len(args):
                self.warn(source, line, echo(index), f"malformed {kind}")
                return
            elif option == "--locked":
                properties.append(("allow-when-locked", True))
                locked = True
            elif option == "--no-repeat":
                properties.append(("repeat", False))
            elif option == "--release":
                properties.extend((("release", True), ("repeat", False)))
            elif option == "--no-warn":
                warn = False
            elif option in region_options:
                mouse_regions.update(region_options[option])
                exclude_titlebar |= option == "--exclude-titlebar"
            else:
                self.warn(
                    source, line, echo(index), f"unsupported {kind} option {option}"
                )
                return

        rest = echo(index)
        if len(args) - index < 2:
            self.warn(source, line, rest, f"malformed {kind}")
            return
        combo_text = args[index]
        command = join_args(args[index + 1 :])
        try:
            combo = split_key_combo(combo_text)
        except BindError as error:
            self.warn(source, line, rest, str(error))
            return
        keycode = None
        if kind == "bindcode" and combo.keys:  # no key: translate_key reports it
            code = combo.keys[-1]
            if not re.fullmatch(r"[0-9]+", code):
                self.warn(source, line, rest, "bindcode key must be numeric")
                return
            # Sway compares the number strtol reads (bind.c:166), so 024 and
            # 24 are one key; the digits are compared as text, so no length
            # reaches int().
            digits = code.lstrip("0") or "0"
            keycode = int(digits) if len(digits) <= 3 else 256
            if not 8 <= keycode <= 255:
                self.warn(
                    source,
                    line,
                    rest,
                    f"bindcode keycode must be between 8 and 255: {code}",
                )
                return
            combo.keys[-1] = f"code:{keycode}"
        try:
            key = self.translate_key(combo_text, combo)
        except BindError as error:
            self.warn(source, line, rest, str(error))
            return
        trigger = key.rsplit("+", 1)[-1]
        # Only the bindsym key's sway spelling makes a mouse binding
        # (sway/commands/bind.c:177-192).
        button = sway_mouse_button(combo.keys[0]) if kind == "bindsym" else None
        mouse = button is not None

        # Sway's region flags (bind.c:359-369,384-388,459-464): a region
        # option or --exclude-titlebar makes a mouse binding, which then
        # covers the titlebar unless --exclude-titlebar removes it. A plain
        # mouse binding emits no mouse-regions and --border emits border
        # alone, without the titlebar sway adds; --exclude-titlebar emits
        # sway's flags exactly.
        sway_regions = set(mouse_regions)
        if exclude_titlebar:
            sway_regions.discard("titlebar")
            mouse_regions = set(sway_regions)
            if not sway_regions:
                # get_active_mouse_binding skips a binding that shares no
                # region with the click (sway/input/seatop_default.c:128-139),
                # and swayward's KDL reads no mouse-regions as every region.
                self.warn(
                    source,
                    line,
                    rest,
                    "--exclude-titlebar without --whole-window or --border "
                    "leaves the binding no region, so sway never runs it "
                    "(sway/commands/bind.c:459-464, "
                    "sway/input/seatop_default.c:128-139); swayward's KDL "
                    "has no binding that never runs",
                )
                return
        elif mouse or mouse_regions:
            sway_regions.add("titlebar")
        regions = ""
        if mouse_regions:
            ordered_regions = ("titlebar", "border", "contents")
            regions = "+".join(region for region in ordered_regions if region in mouse_regions)
            properties.append(("mouse-regions", regions))

        # binding_key_compare's identity (sway/commands/bind.c:64-104): the
        # device, the binding type, the conflict flags, the group, the
        # modifier bits and the key. A keycode and a mouse button are
        # numbers; keysyms are looked up ignoring case (bind.c:194-195).
        if keycode is not None:
            sway_key: tuple = ("keycode", keycode)
        elif mouse:
            sway_key = ("mouse", MOUSE_BUTTONS[button][0])
        else:
            sway_key = ("keysym", ascii_lower(trigger))
        release = ("release", True) in properties
        flags = (input_device, release, locked, combo.group, combo.mask)
        sway_identity = (*flags, frozenset(sway_regions), sway_key)
        # swayward's BindIdentity (swayward-config/src/binds/mod.rs:79-102):
        # the KDL trigger and the emitted regions. Sway-distinct bindings
        # can share it, and KDL rejects a duplicate identity.
        kdl_key = trigger if mouse else sway_key
        kdl_identity = (*flags, frozenset(mouse_regions), kdl_key)
        node = Node(
            key, props=properties, children=[Node("command", [command])], inline=True
        )
        previous = binds.get(sway_identity)
        if previous is None:
            clash = next(
                (entry for entry in binds.values() if entry.kdl == kdl_identity),
                None,
            )
            if clash is not None:
                self.warn(
                    source,
                    line,
                    rest,
                    f"sway keeps this apart from the binding at {clash.pos.path}:"
                    f"{clash.pos.line} (`{clash.command}`), but both translate "
                    f"to {key}{f' mouse-regions={regions}' if regions else ''}, "
                    "which swayward's KDL binds only once "
                    "(sway/commands/bind.c:64-104, "
                    "swayward-config/src/binds/decode.rs:24-40)",
                )
                return
        # binding_upsert replaces an equal binding in place, and binding_add
        # warns through swaynag unless --no-warn (bind.c:266-302). The later
        # binding wins here too, so the comment that carries sway's warning
        # asks for nothing, and an overwrite that changes nothing has none.
        binds[sway_identity] = Binding(kdl_identity, node, d.pos, command)
        if previous is not None and previous.node != node and warn:
            self.doc.note(
                f"sway-to-kdl: {source}:{line}: overwriting binding "
                f"{combo_text} for device '{input_device}' to `{command}` "
                f"from `{previous.command}`, as sway does "
                "(sway/commands/bind.c:280-292)"
            )

    @staticmethod
    def translate_key(combo_text: str, combo: KeyCombo) -> str:
        """The KDL key for a bind's combo, or BindError with the reason
        swayward's KDL cannot bind it.

        swayward binds one trigger with modifiers and at most one group
        (swayward-config/src/binds/decode.rs:177-201,240-259). It reads every
        Mode_switch part as Group2 and none as a key, so a sway binding that
        holds Mode_switch has no KDL spelling.
        """
        if combo.mode_switch:
            raise BindError(
                "Mode_switch selects XKB group 2 and is also a key of the "
                "binding in sway (sway/commands/bind.c:417-427); swayward's "
                "KDL reads it only as Group2"
            )
        if not combo.keys:
            # Every part was a modifier, which sway adds to the binding's
            # mask (sway/commands/bind.c:428-433).
            raise BindError(
                "binding has no key; sway binds modifiers alone, swayward "
                "needs a trigger key (docs/KNOWN_DEVIATIONS.md#modifier-only-bindings)"
            )
        if len(combo.keys) > 1:
            extra = next(
                (k for k in combo.keys[:-1] if not ascii_lower(k).startswith("button")),
                None,
            )
            if extra is None:
                raise BindError(f"unsupported mouse button {combo_text}")
            raise BindError(f"unsupported modifier {extra}")
        trigger = combo.keys[0]
        button = sway_mouse_button(trigger)
        if button is not None:
            if button not in MOUSE_TRIGGERS:
                raise BindError(f"unsupported mouse button {trigger}")
            trigger = MOUSE_TRIGGERS[button]
        elif ascii_lower(trigger) in KDL_POINTER_TRIGGERS:
            raise BindError(
                f"Unknown key or button '{trigger}': sway has no such keysym "
                "(sway/commands/bind.c:194-199), and swayward's KDL would read "
                "it as a pointer trigger (swayward-config/src/binds/key.rs:118-148)"
            )
        if combo.group is not None and button is not None:
            raise BindError(
                "swayward binds an XKB group only to a keyboard key "
                "(swayward-config/src/binds/decode.rs:254-259)"
            )
        group = [f"Group{combo.group}"] if combo.group is not None else []
        return "+".join([*group, *combo.modifiers, trigger])

    def translate_assign(
        self, source: Path, line: int, criteria: str, args: list[str]
    ) -> None:
        match = self.translate_window_criteria(source, line, "assign", criteria)
        if match is None:
            return
        # cmd_assign tests whole arguments for its keywords, then joins the
        # rest (sway/commands/assign.c:26-56). It skips one argument that
        # starts with `→`, which needs a target after it (:26-33).
        if args[:1] and args[0].startswith("→"):
            if len(args) < 2:
                self.warn(
                    source,
                    line,
                    f"assign {criteria} {args[0]}",
                    "missing workspace",
                )
                return
            args = args[1:]
        property_name = "open-on-workspace"
        if args[:1] == ["output"]:
            property_name = "open-on-output"
            args = args[1:]
        else:
            if args[:1] == ["workspace"]:
                args = args[1:]
            if args[:1] == ["number"]:
                args = args[1:]
                if not args or not "0" <= args[0][:1] <= "9":
                    number = args[0] if args else ""
                    self.warn(
                        source,
                        line,
                        f"assign {criteria} number {number}",
                        f"invalid workspace number {number!r}",
                    )
                    return
                property_name = "open-on-workspace-number"
        if not args:
            self.warn(
                source,
                line,
                f"assign {criteria}",
                "missing workspace or output",
            )
            return
        target = join_args(args)
        self.doc.body.add(
            Node(
                "window-rule",
                children=[
                    self.match_node(match),
                    Node(property_name, [target]),
                ],
            )
        )

    def translate_window_criteria(
        self, source: Path, line: int, directive: str, criteria: str
    ) -> list[tuple[str, str | bool]] | None:
        token = re.compile(
            rf'(?<!\w)(?:(\w+)=(?:"({QUOTED_VALUE})"|([^ "\]]+))|(tiling|floating))'
        )
        criteria_body = criteria[1:-1].strip()
        matches = list(token.finditer(criteria_body))
        if not matches or " ".join(match.group(0) for match in matches) != criteria_body:
            self.warn(
                source,
                line,
                f"{directive} {criteria}",
                "criteria need manual conversion to a window-rule match",
            )
            return None
        translated = []
        for criterion in matches:
            key = criterion.group(1) or criterion.group(4)
            value = criterion.group(2) or criterion.group(3)
            if key in {"tiling_from", "floating_from"}:
                self.warn(
                    source,
                    line,
                    f"{directive} {criteria}",
                    f"i3-only provenance criterion {key} has no sway equivalent",
                )
                return None
            if key in {"class", "instance", "id", "window_role", "window_type"}:
                # sway matches these against Xwayland properties only: criteria.c
                # reads view_get_class(), which resolves through
                # impl->get_string_prop, and only xwayland.c implements it.
                # xdg_shell.c returns NULL for VIEW_PROP_CLASS, so the criterion
                # never matches a native Wayland window.
                #
                # The whole directive is dropped rather than translated without
                # the criterion. Keeping the other criteria would widen the rule
                # to every Wayland window that matches them, firing on windows
                # sway would never have touched, and silently.
                self.warn(
                    source,
                    line,
                    f"{directive} {criteria}",
                    f"X11-only criterion {key} matches only Xwayland windows in "
                    f"sway; whole directive dropped rather than widened "
                    f"(docs/KNOWN_DEVIATIONS.md#x11-window-identity)",
                )
                return None
            if key == "workspace":
                self.warn(
                    source,
                    line,
                    f"{directive} {criteria}",
                    "workspace criterion has no window-rule equivalent",
                )
                return None
            if key in {"tiling", "floating"}:
                translated.append(("is-floating", key == "floating"))
            elif key == "urgent" and value in {
                "latest", "newest", "last", "recent", "oldest", "first"
            }:
                translated.append(("is-urgent", True))
            elif key in {"app_id", "title"}:
                translated.append(("title" if key == "title" else "app-id", value))
            else:
                self.warn(
                    source,
                    line,
                    f"{directive} {criteria}",
                    "criteria need manual conversion to a window-rule match",
                )
                return None
        return translated

    @staticmethod
    def match_node(match: list[tuple[str, str | bool]]) -> Node:
        return Node("match", props=list(match))

    def translate_no_focus(self, source: Path, line: int, criteria: str) -> None:
        match = self.translate_window_criteria(source, line, "no_focus", criteria)
        if match is None:
            return
        self.doc.body.add(
            Node(
                "window-rule",
                children=[self.match_node(match), Node("open-focused", [False])],
            )
        )

    @staticmethod
    def split_amounts(words: list[str]) -> list[tuple[int, str]] | None:
        """Parse sway size amounts such as `5 px`, `5px`, `5 ppt` or `5`.

        None when a word is no amount; NumberError for an amount sway's int
        cannot hold (common/util.c:89).
        """
        amounts: list[tuple[int, str]] = []
        index = 0
        while index < len(words):
            found = re.fullmatch(r"(-?[0-9]+)(px|ppt)?", words[index])
            if found is None:
                return None
            unit = found.group(2)
            index += 1
            if unit is None and index < len(words) and words[index] in {"px", "ppt"}:
                unit = words[index]
                index += 1
            amounts.append((c_int(found.group(1)), unit or "px"))
        return amounts

    @staticmethod
    def resize_set_amounts(words: list[str]) -> list[tuple[int, str]] | None:
        """`resize set`'s width and height amounts, as cmd_resize_set reads
        them (sway/commands/resize.c:421-448): `[width] <w> [px|ppt]
        [height] <h> [px|ppt]`, each amount a strtol number with its unit
        attached or as the next word (common/util.c:80-104).

        None when the words are not a width and a height; NumberError for an
        amount sway's int cannot hold. An amount without a unit is px.
        """
        if len(words) >= 2 and words[0] == "width" and words[1] != "height":
            words = words[1:]
        amounts: list[tuple[int, str]] = []
        for axis in ("width", "height"):
            if axis == "height" and len(words) >= 2 and words[0] == "height":
                words = words[1:]
            found = re.fullmatch(r"([+-]?[0-9]+)(px|ppt)?", words[0]) if words else None
            if found is None:
                return None
            unit, consumed = found.group(2), 1
            if unit is None and words[1:2] in (["px"], ["ppt"]):
                unit, consumed = words[1], 2
            amounts.append((c_int(found.group(1)), unit or "px"))
            words = words[consumed:]
        return amounts if not words else None

    def translate_for_window(
        self, source: Path, line: int, criteria: str, command: str
    ) -> None:
        match = self.translate_window_criteria(source, line, "for_window", criteria)
        if match is None:
            return
        rule = Node("window-rule", children=[self.match_node(match)])
        try:
            commands = split_command_list(command)
        except CriteriaError as error:
            self.warn(source, line, f"for_window {criteria} {command}", str(error))
            return
        if not commands:
            self.warn(
                source,
                line,
                f"for_window {criteria} {command}",
                "for_window needs a command",
            )
            return
        for listed in commands:
            directive = join_args(listed.argv)
            words = command_words(listed)
            if listed.criteria is not None:
                # Criteria after a `;` select other windows (sway/commands.c:232-251).
                words = [listed.criteria, *words]
                directive = f"{listed.criteria} {directive}"
            amounts = None
            if words[:2] in (["resize", "set"], ["move", "position"]):
                parse = (
                    self.resize_set_amounts
                    if words[1] == "set"
                    else self.split_amounts
                )
                try:
                    amounts = parse(words[2:])
                except NumberError as error:
                    self.warn(
                        source, line, f"for_window {criteria} {directive}", str(error)
                    )
                    continue
            if words[:1] == ["border"]:
                if words == ["border", "none"]:
                    rule.set(Node("sway-border", ["none"]))
                elif words == ["border", "pixel"]:
                    rule.set(Node("sway-border", ["pixel"]))
                elif (
                    len(words) == 3
                    and words[:2] == ["border", "pixel"]
                    and (width := border_width(words[2])) is not None
                ):
                    rule.set(Node("sway-border", ["pixel"]))
                    rule.set(Node("sway-border-width", [width]))
                else:
                    self.warn(
                        source,
                        line,
                        f"for_window {criteria} {directive}",
                        "Expected 'border <none|normal|pixel|csd|toggle>' "
                        "or 'border pixel <px>'",
                    )
            elif words in (["floating", "enable"], ["floating", "enabled"]):
                rule.set(Node("open-floating", [True]))
            elif words == ["floating", "disable"]:
                rule.set(Node("open-floating", [False]))
            elif words == ["layout", "tabbed"]:
                rule.set(Node("default-column-display", ["tabbed"]))
            elif words == ["focus"]:
                rule.set(Node("open-focused", [True]))
            elif words == ["nofocus"]:
                rule.set(Node("open-focused", [False]))
            elif (
                len(words) == 2 and words[0] in {"opacity", "opacity_set"}
            ) or (len(words) == 3 and words[:2] == ["opacity", "set"]):
                try:
                    opacity = float(words[-1])
                except ValueError:
                    opacity = -1.0
                if 0.0 <= opacity <= 1.0:
                    rule.set(Node("opacity", [opacity]))
                else:
                    self.warn(
                        source,
                        line,
                        f"for_window {criteria} {directive}",
                        "opacity must be between 0 and 1",
                    )
            elif words == ["shortcuts_inhibitor", "disable"]:
                rule.add(Node("sway-for-window-command", [directive]))
            elif words[:1] == ["title_format"] and len(words) >= 2:
                rule.add(Node("sway-for-window-command", [directive]))
            elif words[:1] == ["nop"]:
                rule.add(Node("sway-for-window-command", [directive]))
            elif words in (["kill"], ["reload"], ["move", "scratchpad"]):
                rule.add(Node("sway-for-window-command", [directive]))
            elif words[:1] == ["mark"]:
                options = words[1:-1]
                if (
                    len(words) < 2
                    or words[-1].startswith("--")
                    or any(
                        option not in {"--add", "--replace", "--toggle"}
                        for option in options
                    )
                ):
                    self.warn(
                        source,
                        line,
                        f"for_window {criteria} {directive}",
                        "invalid mark command",
                    )
                    continue
                rule.add(Node("sway-for-window-command", [directive]))
            elif words[:2] == ["move", "workspace"] and len(words) == 3:
                rule.set(Node("open-on-workspace", [words[2]]))
            elif words[:2] == ["resize", "set"] and amounts is not None:
                (width, width_unit), (height, height_unit) = amounts
                # PresetSize holds a fixed size as an i32 and a proportion as
                # an f64 (swayward-config/src/layout.rs:198-201); a C int
                # (c_int) fits the first, and a C int over 100 is finite.
                kind = {("px", "px"): "fixed", ("ppt", "ppt"): "proportion"}.get(
                    (width_unit, height_unit)
                )
                if kind is None or width <= 0 or height <= 0:
                    self.warn(
                        source,
                        line,
                        f"for_window {criteria} {directive}",
                        "resize size needs manual conversion",
                    )
                    continue
                if kind == "proportion":
                    width, height = width / 100, height / 100
                rule.set(preset_size("default-column-width", kind, width))
                rule.set(preset_size("default-window-height", kind, height))
            elif words == ["move", "position", "center"]:
                rule.add(Node("sway-for-window-command", ["move position center"]))
            elif (
                words[:2] == ["move", "position"]
                and amounts is not None
                and len(amounts) == 2
            ):
                # swayward parses sway's relative `move position <x> <y>`
                # with px or ppt units and runs it after the window maps.
                rule.add(Node("sway-for-window-command", [directive]))
            elif len(words) == 2 and words[0] == "sticky" and words[1] in {
                "enable",
                "disable",
                "toggle",
            }:
                rule.add(Node("sway-for-window-command", [directive]))
            elif len(words) == 2 and words[0] == "inhibit_idle" and words[1] in {
                "focus",
                "fullscreen",
                "open",
                "none",
                "visible",
            }:
                # swayward implements sway's five user idle-inhibit policies
                # (sway/sway/commands/inhibit_idle.c:22-35) and runs the
                # command against the window after it maps.
                rule.add(Node("sway-for-window-command", [directive]))
            elif words[:1] == ["dim_inactive"] and len(words) == 2:
                # As the top-level dim_inactive (translate_swayfx).
                amount = unit_fraction(words[1])
                if amount is None:
                    self.warn(
                        source,
                        line,
                        f"for_window {criteria} {directive}",
                        "dim_inactive takes a number from 0 to 1",
                    )
                else:
                    rule.set(Node("opacity", [1.0 - amount]))
            elif words[:1] == ["corner_radius"] and len(words) == 2:
                rule.set(Node("geometry-corner-radius", [Raw(words[1])]))
                rule.set(Node("clip-to-geometry", [True]))
            elif words[:1] == ["blur"] and len(words) == 2:
                set_background_effect(rule, "blur", words[1])
            elif words[:1] == ["shadows"] and len(words) == 2:
                rule.set(shadow(words[1]))
            else:
                self.warn(
                    source,
                    line,
                    f"for_window {criteria} {directive}",
                    "command needs manual conversion to window-rule properties",
                )
        if len(rule.children) > 1:  # an effect besides the match
            self.doc.body.add(rule)

    def translate_gaps(
        self,
        source: Path,
        line: int,
        text: str,
        kind: str,
        raw_amount: str,
        workspace: str | None = None,
    ) -> None:
        match = re.fullmatch(r"([+-]?[0-9]+)(?:px)?", raw_amount, re.IGNORECASE)
        if match is None:
            self.warn(source, line, text, "gap amount must be an integer with optional px suffix")
            return
        try:
            amount = c_int(match.group(1))
        except NumberError as error:
            self.warn(source, line, text, str(error))
            return
        kind = kind.lower()
        settings = (
            self.doc.layout
            if workspace is None
            else self.doc.workspace_layout(workspace)
        )
        if kind == "inner":
            settings.set(Node("gaps", [max(amount, 0)]))
            return
        sides = {
            "outer": ("left", "right", "top", "bottom"),
            "horizontal": ("left", "right"),
            "vertical": ("top", "bottom"),
            "top": ("top",),
            "right": ("right",),
            "bottom": ("bottom",),
            "left": ("left",),
        }[kind]
        # One outer-gaps node per layout, merged as sway's last setting wins.
        set_merged(
            settings, Node("outer-gaps", children=[Node(side, [amount]) for side in sides])
        )

    def translate_device_block(
        self, d: Directive, selector: str, body: list[str]
    ) -> None:
        if d.name == "input":
            self.translate_input_block(d.pos.path, d.pos.line, selector, body)
        else:
            self.translate_output_block(d, selector, body)

    def translate_input_block(
        self, source: Path, line: int, selector: str, body: list[str]
    ) -> None:
        targets = {
            "type:keyboard": "keyboard",
            "type:pointer": "mouse",
            "type:tablet_tool": "tablet",
            "type:touch": "touch",
            "type:touchpad": "touchpad",
        }
        target = targets.get(selector)
        # A setting is the item's first word by sway's whitespace
        # (common/stringop.c:13); Python's split also breaks at Unicode
        # spaces, so an item of only those would have no word.
        if selector == "*" and all(
            sway_split(item, 1)[0].startswith("xkb_")
            or sway_split(item, 1)[0] in {"repeat_delay", "repeat_rate"}
            for item in body
            if item and not item.startswith("#")
        ):
            target = "keyboard"
        if target is None:
            self.warn(
                source,
                line,
                f"input {selector} {{ ... }}",
                "device-specific input selectors cannot be preserved; swayward input "
                "settings apply by device class "
                "(docs/SWAY_CONFIG_MIGRATION.md#convert-device-specific-inputs)",
            )
            return
        mappings = {
            "accel_profile": "accel-profile",
            "click_method": "click-method",
            "drag": "drag",
            "drag_lock": "drag-lock",
            "dwt": "dwt",
            "dwtp": "dwtp",
            "natural_scroll": "natural-scroll",
            "middle_emulation": "middle-emulation",
            "left_handed": "left-handed",
            "pointer_accel": "accel-speed",
            "repeat_delay": "repeat-delay",
            "repeat_rate": "repeat-rate",
            "scroll_button": "scroll-button",
            "scroll_factor": "scroll-factor",
            "scroll_method": "scroll-method",
            "tap": "tap",
            "tap_button_map": "tap-button-map",
            "xkb_layout": "layout",
            "xkb_model": "model",
            "xkb_options": "options",
            "xkb_rules": "rules",
            "xkb_variant": "variant",
        }
        pos = Pos(source, line)
        # Later settings replace earlier ones, as sway merges input configs
        # field by field (sway/config/input.c:52-189). The xkb settings of
        # one block are merged at its end.
        device = self.doc.device(target)
        xkb = Node("xkb")
        for item in body:
            if not item or item.startswith("#"):
                continue
            words = sway_split(item, 1)
            unhandled = Report(pos, "unhandled input directive", item)
            if words[0] == "xkb_numlock" and target == "keyboard":
                if len(words) == 1:
                    device.report(unhandled, self.doc)
                    continue
                value = unquote_args(split_args(words[1]))[0]
                enabled = value.lower() in {
                    "1", "yes", "on", "true", "enable", "enabled", "active", "toggle"
                }
                device.add(Comment(f"sway-to-kdl: sway {item}"))
                device.set(Node("numlock", [] if enabled else [False]))
                continue
            name = mappings.get(words[0])
            if name is None:
                device.report(unhandled, self.doc)
                continue
            value = words[1] if len(words) > 1 else "enabled"
            enum_values = {
                "accel-profile": {"adaptive": "adaptive", "flat": "flat"},
                "click-method": {
                    "button_areas": "button-areas",
                    "clickfinger": "clickfinger",
                },
                "scroll-method": {
                    "none": "no-scroll",
                    "two_finger": "two-finger",
                    "edge": "edge",
                    "on_button_down": "on-button-down",
                },
                "tap-button-map": {
                    "lrm": "left-right-middle",
                    "lmr": "left-middle-right",
                },
            }
            parent = xkb if words[0].startswith("xkb_") else device
            if name == "drag":
                parent.set(Node(name, [value == "enabled"]))
            elif value in {"enabled", "disabled"}:
                # libinput booleans are bare KDL flags that take no argument:
                # presence enables them and absence leaves them off.
                if value == "enabled":
                    parent.set(Node(name))
                else:
                    parent.remove(name)
                    parent.add(Comment(f"sway-to-kdl: sway {item}"))
            elif name in enum_values:
                parent.set(Node(name, [enum_values[name].get(value, value)]))
            elif name in {"layout", "model", "options", "rules", "variant"}:
                value = join_args(unquote_args(split_args(value)))
                parent.set(Node(name, [value]))
            elif name in {"accel-speed", "scroll-factor"}:
                # Both are FloatOrInt (swayward-config/src/input/libinput.rs:
                # 11,46). Sway refuses NaN (sway/commands/input/pointer_accel.c:
                # 19-22, scroll_factor.c:20-23), and KDL has no infinity.
                try:
                    number = float(value)
                except ValueError:
                    number = math.nan
                if math.isfinite(number):
                    parent.set(Node(name, [number]))
                else:
                    parent.report(unhandled, self.doc)
            elif name == "scroll-button" and not value.isdecimal():
                button_codes = {
                    "BTN_LEFT": 272,
                    "BTN_RIGHT": 273,
                    "BTN_MIDDLE": 274,
                    "BTN_SIDE": 275,
                    "BTN_EXTRA": 276,
                    "BTN_FORWARD": 277,
                    "BTN_BACK": 278,
                }
                if value not in button_codes:
                    parent.report(unhandled, self.doc)
                else:
                    parent.set(Node(name, [button_codes[value]]))
            else:
                parent.set(Node(name, [Raw(value)]))
        if xkb.children:
            set_merged(device, xkb)

    def translate_output_block(
        self, d: Directive, selector: str, body: list[str]
    ) -> None:
        """One output directive or block, merged into the output's node.

        Sway merges an output config into the earlier one of the same name,
        compared exactly, field by field: a later setting wins
        (sway/config/output.c:164-239,258-262). swayward-config keeps every
        output node and uses the first whose name matches, ignoring ASCII
        case (swayward-config/src/decode.rs:114-116, output.rs:150-151,
        196-199), so each name has one node, at its first mention. Names
        that differ only in case are one output to swayward and two to
        sway; a later one is reported. Selectors swayward cannot combine as
        sway does are reported by report_output_selectors.
        """
        pos = d.pos
        translated = self.doc.outputs.get(selector)
        if translated is None:
            clash = next(
                (
                    name
                    for name in self.doc.outputs
                    if ascii_lower(name) == ascii_lower(selector)
                ),
                None,
            )
            if clash is not None:
                text = d.text if d.block is None else f"{d.text} ... }}"
                self.warn(
                    pos.path,
                    pos.line,
                    text,
                    f"sway keeps output {selector} apart from output {clash}, "
                    "as it compares output names exactly "
                    "(sway/sway/config/output.c:258), but swayward matches "
                    "them ignoring case and uses the first "
                    "(swayward-config/src/output.rs:150-151,196-199)",
                )
                return
            translated = Node("output", [selector], block=True)
            self.doc.outputs[selector] = translated
            self.doc.body.add(translated)
        words = " ".join(
            item for item in body if item and not item.startswith("#")
        ).split()
        unsupported_argument_counts = {
            "adaptive_sync": 1,
            "bg": 2,
            "dpms": 1,
            "max_render_time": 1,
            "power": 1,
            "render_bit_depth": 1,
            "subpixel": 1,
        }
        fields: set[str] = set()  # the settings this directive translates
        index = 0
        while index < len(words):
            name = words[index]
            if name in {"res", "resolution", "mode"} and index + 1 < len(words):
                # sway accepts a trailing Hz on the refresh rate
                # (`sway/sway/commands/output/mode.c`), swayward's parser does
                # not. Strip it so the emitted config loads.
                mode = re.sub(r"(@[0-9.]+)\s*Hz$", r"\1", words[index + 1], flags=re.IGNORECASE)
                translated.set(Node("mode", [mode]))
                fields.add("mode")
                index += 2
            elif name in {"pos", "position"} and index + 1 < len(words):
                if "," in words[index + 1]:
                    x, y = words[index + 1].split(",", 1)
                    consumed = 2
                elif index + 2 < len(words):
                    x, y = words[index + 1 : index + 3]
                    consumed = 3
                else:
                    x = y = ""
                    consumed = 0
                if re.fullmatch(r"-?\d+", x) and re.fullmatch(r"-?\d+", y):
                    translated.set(
                        Node("position", props=[("x", Raw(x)), ("y", Raw(y))])
                    )
                    fields.add("position")
                    index += consumed
                else:
                    consumed = 1
                    translated.report(
                        Report(pos, "unhandled output directive", name), self.doc
                    )
                    index += consumed
            elif name == "transform" and index + 1 < len(words):
                value = words[index + 1]
                valid = {
                    "normal",
                    "90",
                    "180",
                    "270",
                    "flipped",
                    "flipped-90",
                    "flipped-180",
                    "flipped-270",
                }
                if value in valid:
                    translated.set(Node("transform", [value]))
                    fields.add("transform")
                else:
                    translated.report(
                        Report(pos, "unhandled output directive", f"{name} {value}"),
                        self.doc,
                    )
                index += 2
            elif name == "scale" and index + 1 < len(words):
                translated.set(Node("scale", [Raw(words[index + 1])]))
                fields.add("scale")
                index += 2
            elif name in {"enable", "on"}:
                # The last enable or disable wins
                # (sway/commands/output/enable.c:9, disable.c:8).
                translated.remove("off")
                fields.add("enabled")
                index += 1
            elif name in {"disable", "off"}:
                translated.set(Node("off"))
                fields.add("enabled")
                index += 1
            else:
                argument_count = unsupported_argument_counts.get(name)
                if argument_count is None:
                    remainder = " ".join(words[index:])
                    translated.report(
                        Report(pos, "unhandled output directive", remainder), self.doc
                    )
                    break
                end = min(index + argument_count + 1, len(words))
                directive = " ".join(words[index:end])
                translated.report(
                    Report(pos, "unhandled output directive", directive), self.doc
                )
                index = end
        self.report_output_selectors(d, selector, translated, fields)
        self.doc.output_fields.setdefault(selector, set()).update(fields)

    def report_output_selectors(
        self, d: Directive, selector: str, translated: Node, fields: set[str]
    ) -> None:
        """Report output settings whose effect in sway no KDL node can hold.

        Sway builds an output's config from the `*` config, then the
        connector's, then the "make model serial" identifier's, each merged
        over the last (find_output_config_from_list, sway/config/output.c:
        716-728), and an `output *` setting replaces the same setting of
        every output stored before it (store_output_config, :264-268).
        swayward-config has no wildcard output: Outputs::find takes the
        first node whose name matches the connector, ignoring case, or the
        identifier (swayward-config/src/output.rs:150-152,196-237), so an
        `output "*"` node matches only a connector named `*`, and one output
        never combines a connector node with an identifier node.

        So each translated setting of `output *` is reported, naming the
        outputs whose earlier setting sway replaces. A setting given through
        both an identifier selector and a connector selector is reported on
        the later one: the translator cannot tell whether the two name one
        output, and if they do, sway and swayward apply different values.
        Different settings through the two kinds are not reported: a
        connector for one output and an identifier for another is the usual
        multi-output config, and each node then holds its output's settings.
        If the two do name one output, swayward reads only the first node,
        and that case goes unreported.
        """
        if not fields:
            return
        text = d.text if d.block is None else f"{d.text} ... }}"
        settings = ", ".join(sorted(fields))
        if selector == "*":
            replaced = [
                f"{field} of output {name}"
                for name, earlier in self.doc.output_fields.items()
                if name != "*"
                for field in sorted(earlier & fields)
            ]
            reason = (
                f"sway applies this {settings} to every output "
                "(sway/sway/config/output.c:716-728)"
            )
            if replaced:
                reason += (
                    f" and replaces the earlier {', '.join(replaced)} "
                    "(sway/sway/config/output.c:264-268)"
                )
            reason += (
                ", but swayward-config has no wildcard output: an output "
                '"*" node matches only a connector named * '
                "(swayward-config/src/output.rs:150-152,196-199); set it in "
                "each output's node"
            )
            translated.report(Report(d.pos, reason, text), self.doc)
            return
        # An identifier is "make model serial" (output_get_identifier,
        # sway/config/output.c:31-38); a connector name has no space.
        identifier = " " in selector
        shared = [
            (name, sorted(earlier & fields))
            for name, earlier in self.doc.output_fields.items()
            if name not in {"*", selector}
            and (" " in name) != identifier
            and earlier & fields
        ]
        for name, both in shared:
            connector, ident = (name, selector) if identifier else (selector, name)
            reason = (
                f"output {selector} and output {name} both set "
                f"{', '.join(both)}; if {ident} is the output on {connector}, "
                "sway applies the identifier's value over the connector's "
                "(sway/sway/config/output.c:716-728), but swayward uses only "
                "the first output node that matches it "
                "(swayward-config/src/output.rs:150-152,196-237); combine "
                "them by hand"
            )
            translated.report(Report(d.pos, reason, text), self.doc)

    def translate_swayfx(self, source: Path, line: int, text: str) -> bool:
        words = text.split()
        if not words:
            return False
        name = words[0]
        if name == "blur":
            state = "off" if len(words) > 1 and words[1] in {"disable", "off"} else "on"
            self.doc.blur.put(Node(state), "on", "off")
            self.doc.note("SwayFX blur -> swayward blur and window background-effect")
            self.doc.body.add(
                Node(
                    "window-rule",
                    children=[
                        Node("background-effect", children=[Node("blur", [state == "on"])])
                    ],
                )
            )
        elif name == "blur_xray" and len(words) == 2:
            self.doc.note("SwayFX blur_xray -> window-rule background-effect xray")
            self.doc.body.add(
                Node("window-rule", children=[background_effect("xray", words[1])])
            )
        elif name == "blur_passes" and len(words) == 2:
            self.doc.blur.put(Node("passes", [Raw(words[1])]))
        elif name == "blur_radius" and len(words) == 2:
            self.doc.blur.put(Node("offset", [Raw(words[1])]))
        elif name == "titlebar_padding" and len(words) >= 2:
            try:
                horizontal = int(words[1])
                vertical = horizontal if len(words) == 2 else int(words[2])
            except ValueError:
                horizontal = vertical = -1
            if horizontal < 0 or vertical < 0 or horizontal > 65535 or vertical > 65535:
                self.warn(source, line, text, "Invalid size specified")
            else:
                titlebar = self.doc.titlebar
                thickness = (
                    1 if titlebar.border_thickness is None else titlebar.border_thickness
                )
                if horizontal < thickness or vertical < thickness:
                    self.warn(source, line, text, "Invalid size specified")
                else:
                    titlebar.padding = (horizontal, vertical)
                    self.doc.note(f"sway-to-kdl: SwayFX {text}")
        elif name == "titlebar_border_thickness" and len(words) == 2:
            try:
                thickness = int(words[1])
            except ValueError:
                thickness = -1
            titlebar = self.doc.titlebar
            vertical = titlebar.padding[1] if titlebar.padding else 4
            if thickness < 0 or thickness > vertical or thickness > 65535:
                self.warn(source, line, text, "Invalid size specified")
            else:
                titlebar.border_thickness = thickness
                self.doc.note(f"sway-to-kdl: SwayFX {text}")
        elif name == "corner_radius" and len(words) == 2:
            self.doc.note("SwayFX corner_radius -> window-rule geometry-corner-radius")
            self.doc.body.add(
                Node(
                    "window-rule",
                    children=[
                        Node("geometry-corner-radius", [Raw(words[1])]),
                        Node("clip-to-geometry", [True]),
                    ],
                )
            )
        elif name == "shadows":
            state = "off" if len(words) > 1 and words[1] in {"disable", "off"} else "on"
            self.doc.layout.add(
                Comment("SwayFX shadows; tune remaining shadow controls as needed")
            )
            self.doc.layout.set(Node("shadow", children=[Node(state)]))
        elif name == "shadows_on_csd" and len(words) == 2:
            self.warn(
                source,
                line,
                text,
                "SwayFX shadows_on_csd has no exact swayward equivalent; tune layout shadow draw-behind-window",
            )
        elif name in {"dim_inactive", "default_dim_inactive"} and len(words) == 2:
            # The unfocused opacity, 1 - amount, is a fraction
            # (swayward-config/src/window_rule.rs:76).
            amount = unit_fraction(words[1])
            if amount is None:
                self.warn(source, line, text, f"{name} takes a number from 0 to 1")
                return True
            opacity = 1.0 - amount
            self.doc.note("SwayFX dim_inactive -> unfocused window opacity")
            self.doc.body.add(
                Node(
                    "window-rule",
                    children=[
                        Node("match", props=[("is-focused", False)]),
                        Node("opacity", [opacity]),
                    ],
                )
            )
        elif name == "layer_effects":
            self.translate_layer_effects(source, line, text)
        else:
            return False
        return True

    def translate_layer_effects(self, source: Path, line: int, text: str) -> None:
        args = Directive.from_line(text, Pos(source, line)).args
        try:
            effects = split_command_list(join_args(args[1:])) if len(args) > 1 else []
        except CriteriaError:
            effects = []
        if not effects:
            self.warn(source, line, text, "cannot parse SwayFX layer_effects")
            return
        namespace = args[0]
        rule = Node(
            "layer-rule",
            children=[
                Node("match", props=[("namespace", "^" + re.escape(namespace) + "$")])
            ],
        )
        for effect in effects:
            words = command_words(effect)
            if words[:1] == ["blur"] and len(words) == 2:
                set_background_effect(rule, "blur", words[1])
            elif words[:1] == ["blur_xray"] and len(words) == 2:
                set_background_effect(rule, "xray", words[1])
            elif words[:1] == ["shadows"] and len(words) == 2:
                rule.set(shadow(words[1]))
            elif words[:1] == ["corner_radius"] and len(words) == 2:
                rule.set(Node("geometry-corner-radius", [Raw(words[1])]))
            else:
                rule.report(
                    Report(
                        Pos(source, line),
                        "unhandled layer_effects directive",
                        join_args(effect.argv),
                    ),
                    self.doc,
                )
        self.doc.note(f"SwayFX layer_effects -> layer-rule for {namespace}")
        self.doc.body.add(rule)


# ---------------------------------------------------------------------------
# Handler tables
#
# Keyed by directive name. A handler returns False when the line is not one
# it translates; dispatch then reports it as unhandled.
# ---------------------------------------------------------------------------

