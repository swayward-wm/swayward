==== sway-to-kdl golden: stdout ====
// Generated by sway-to-kdl.
// swayward uses typed nested KDL so its inherited effects and animations
// keep their full option sets. Review every sway-to-kdl comment below.

input {
    focus-follows-mouse
    tiling-drag true
    tiling-drag-threshold 9
    workspace-auto-back-and-forth false
    touchpad {
        accel-profile "adaptive"
        // sway-to-kdl: sway tap disabled
    }
    keyboard {
        xkb {
            layout "de"
            options "caps:escape"
        }
        // sway-to-kdl: sway xkb_numlock disabled
        // sway-to-kdl: sway xkb_numlock enabled
        numlock
    }
}

layout {
    workspace-layout "stacking"
    focus-wrapping "force"
    floating-minimum-size 20 20
    // SwayFX shadows; tune remaining shadow controls as needed
    // SwayFX shadows; tune remaining shadow controls as needed
    shadow {
        off
    }
}

popup-during-fullscreen "smart"
focus-on-window-activation "none"
// sway-to-kdl: satisfied by swayward defaults: xwayland enable
output "DP-1" {
    mode "1920x1080"
    scale 2
}
window-rule {
    match app-id="a"
    sway-border-width 2
    sway-border "none"
    open-focused false
}
window-rule {
    match app-id="b"
    background-effect {
        blur true
    }
    shadow {
        off
    }
    open-on-workspace "2"
}
// SwayFX layer_effects -> layer-rule for rofi
layer-rule {
    match namespace="^rofi$"
    background-effect {
        blur false
        xray true
    }
}
