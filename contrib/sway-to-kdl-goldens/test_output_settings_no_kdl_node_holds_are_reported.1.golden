// Generated by sway-to-kdl.
// swayward uses typed nested KDL so its inherited effects and animations
// keep their full option sets. Review every sway-to-kdl comment below.

input {
    focus-follows-mouse
}

output "DP-1" {
    scale 1
    position x=5 y=6
}
output "*" {
    scale 2
    // sway-to-kdl: <tmp>/config:2: sway applies this scale to every output (sway/sway/config/output.c:716-728) and replaces the earlier scale of output DP-1 (sway/sway/config/output.c:264-268), but swayward-config has no wildcard output: an output "*" node matches only a connector named * (swayward-config/src/output.rs:150-152,196-199); set it in each output's node: output * scale 2
    // sway-to-kdl: <tmp>/config:4: unhandled output directive: bg /wallpaper fill
}
output "Dell Inc. U2720Q ABC" {
    scale 2
    // sway-to-kdl: <tmp>/config:5: output Dell Inc. U2720Q ABC and output DP-1 both set scale; if Dell Inc. U2720Q ABC is the output on DP-1, sway applies the identifier's value over the connector's (sway/sway/config/output.c:716-728), but swayward uses only the first output node that matches it (swayward-config/src/output.rs:150-152,196-237); combine them by hand: output "Dell Inc. U2720Q ABC" scale 2
    transform "90"
}
output "HDMI-A-1" {
    position x=0 y=0
    scale 1
    // sway-to-kdl: <tmp>/config:7: output HDMI-A-1 and output Dell Inc. U2720Q ABC both set scale; if Dell Inc. U2720Q ABC is the output on HDMI-A-1, sway applies the identifier's value over the connector's (sway/sway/config/output.c:716-728), but swayward uses only the first output node that matches it (swayward-config/src/output.rs:150-152,196-237); combine them by hand: output HDMI-A-1 scale 1
}
