==== sway-to-kdl golden: input <tmp>/config ====
font pango:DejaVu Sans Mono 10
mode --pango_markup "<b>resize</b>" {
    bindsym Escape mode default
}
==== sway-to-kdl golden: stdout ====
// Generated by sway-to-kdl.
// swayward uses typed nested KDL so its inherited effects and animations
// keep their full option sets. Review every sway-to-kdl comment below.

mode "<b>resize</b>" pango-markup=true {
    Escape { command "mode default"; }
}

input {
    focus-follows-mouse
}

layout {
    titlebar {
        font "DejaVu Sans Mono 10"
        pango-markup true
    }
}
