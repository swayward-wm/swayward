// Generated by sway-to-kdl.
// swayward uses typed nested KDL so its inherited effects and animations
// keep their full option sets. Review every sway-to-kdl comment below.

input {
    focus-follows-mouse
}

window-rule {
    match app-id="foo"
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.6; }
    sway-for-window-command "move position center"
}
