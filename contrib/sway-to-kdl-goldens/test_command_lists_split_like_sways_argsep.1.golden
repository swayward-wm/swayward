==== sway-to-kdl golden: input <tmp>/config ====
for_window [app_id="a"] title_format "a, b"
layer_effects waybar blur enable, shadows enable
==== sway-to-kdl golden: stdout ====
// Generated by sway-to-kdl.
// swayward uses typed nested KDL so its inherited effects and animations
// keep their full option sets. Review every sway-to-kdl comment below.

input {
    focus-follows-mouse
}

window-rule {
    match app-id="a"
    sway-for-window-command "title_format \"a, b\""
}
// SwayFX layer_effects -> layer-rule for waybar
layer-rule {
    match namespace="^waybar$"
    background-effect {
        blur true
    }
    shadow {
        on
    }
}
