==== sway-to-kdl golden: input <tmp>/config ====

set $mod Mod4
set $term foot
bindsym --locked $mod+Return exec $term
bindcode 24 kill
input type:touchpad {
    tap enabled
    natural_scroll disabled
}
input type:keyboard {
    xkb_layout us
    repeat_delay 300
}
output DP-1 resolution 1920x1080 position 10,20 scale 1.5
for_window [app_id="firefox"] floating enable
assign [app_id="^mail$"] → 2: mail
bar {
    position top
}
blur enable
corner_radius 8
shadows enable
dim_inactive 0.5
default_dim_inactive 0.0
layer_effects "waybar" blur enable
mystery value
bindsym $missing+x nop
==== sway-to-kdl golden: stdout ====
// Generated by sway-to-kdl.
// swayward uses typed nested KDL so its inherited effects and animations
// keep their full option sets. Review every sway-to-kdl comment below.

binds {
    Super+Return allow-when-locked=true { command "exec foot"; }
    code:24 { command "kill"; }
}

input {
    focus-follows-mouse
    touchpad {
        tap
        // sway-to-kdl: sway natural_scroll disabled
    }
    keyboard {
        repeat-delay 300
        xkb {
            layout "us"
        }
    }
}

// SwayFX blur settings; swayward keeps unmatched nested controls at their defaults.
blur {
    on
}

layout {
    // SwayFX shadows; tune remaining shadow controls as needed
    shadow {
        on
    }
}

output "DP-1" {
    mode "1920x1080"
    position x=10 y=20
    scale 1.5
}
window-rule {
    match app-id="firefox"
    open-floating true
}
window-rule {
    match app-id="^mail$"
    open-on-workspace "2: mail"
}
// sway-to-kdl: <tmp>/config:17: bar blocks are unsupported; use waybar (docs/SWAY_CONFIG_MIGRATION.md#replace-swaybar): bar { | position top | }
// SwayFX blur -> swayward blur and window background-effect
window-rule {
    background-effect {
        blur true
    }
}
// SwayFX corner_radius -> window-rule geometry-corner-radius
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}
// SwayFX dim_inactive -> unfocused window opacity
window-rule {
    match is-focused=false
    opacity 0.5
}
// SwayFX dim_inactive -> unfocused window opacity
window-rule {
    match is-focused=false
    opacity 1.0
}
// SwayFX layer_effects -> layer-rule for waybar
layer-rule {
    match namespace="^waybar$"
    background-effect {
        blur true
    }
}
// sway-to-kdl: <tmp>/config:26: unhandled: mystery value
// sway-to-kdl: <tmp>/config:27: unsupported modifier $missing: $missing+x nop
