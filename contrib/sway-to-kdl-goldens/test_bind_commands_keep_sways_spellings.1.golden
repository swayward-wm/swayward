// Generated by sway-to-kdl.
// swayward uses typed nested KDL so its inherited effects and animations
// keep their full option sets. Review every sway-to-kdl comment below.

binds {
    Super+1 { command "move container to workspace number 1"; }
    Super+h { command "splith"; }
    Super+v { command "splitv"; }
    Super+r { command "resize grow width 10px"; }
    Super+s { command "resize shrink height 5px"; }
}

input {
    focus-follows-mouse
}
