// Generated by sway-to-kdl.
// swayward uses typed nested KDL so its inherited effects and animations
// keep their full option sets. Review every sway-to-kdl comment below.

binds {
    Control+Print { command "nop key-press"; }
    Control+Print release=true repeat=false { command "nop key-release"; }
    MouseLeft release=true repeat=false { command "nop mouse-release"; }
}

mode "test" {
    code:27 release=true repeat=false { command "nop mode-release"; }
}

input {
    focus-follows-mouse
}
