==== sway-to-kdl golden: input <tmp>/config ====

set {
    $mod Mod4
    $left h
    $gnome-schema org.gnome.desktop.interface
}
bindsym --no-repeat {
    $mod+$left focus left
    $mod+Return exec foot
}
mode "resize" {
    bindsym {
        $left resize shrink width 10px
        Escape mode "default"
    }
}
exec {
    mako
    kanshi
}
exec_always {
    gsettings set org.gnome.desktop.interface gtk-theme Adwaita
}
for_window {
    [app_id="firefox"] floating enable
    [app_id="mpv"] border pixel 2
}
for_window [app_id="foot"] {
    floating enable
    border none
}
for_window [ app_id="pavucontrol" ] floating enable
for_window [app_id="browser"] opacity 0.9
for_window [app_id="game"] shortcuts_inhibitor disable
for_window [app_id="sharing"] nofocus
for_window [app_id="calendar"] opacity set 0.8
for_window [app_id="dialog"] floating enabled
for_window [app_id="video"] resize set width 640 height 480
bindsym Mod4+shift+x kill
bindsym Print+Ctrl+Shift exec grim
bindsym Mod5+q workspace 1
==== sway-to-kdl golden: stdout ====
// Generated by sway-to-kdl.
// swayward uses typed nested KDL so its inherited effects and animations
// keep their full option sets. Review every sway-to-kdl comment below.

binds {
    Super+h repeat=false { command "focus left"; }
    Super+Return repeat=false { command "exec foot"; }
    Super+Shift+x { command "kill"; }
    Ctrl+Shift+Print { command "exec grim"; }
    ISO_Level3_Shift+q { command "workspace 1"; }
}

mode "resize" {
    h { command "resize shrink width 10px"; }
    Escape { command "mode \"default\""; }
}

input {
    focus-follows-mouse
}

spawn-sh-at-startup "mako"
spawn-sh-at-startup "kanshi"
// sway-to-kdl: <tmp>/config:22: exec_always reload behavior is not preserved; spawn-sh-at-startup runs only when swayward starts (sway/sway/commands/exec.c:12-17; exec_always.c:83; src/main.rs:162,270-275): exec_always gsettings set org.gnome.desktop.interface gtk-theme Adwaita
spawn-sh-at-startup "gsettings set org.gnome.desktop.interface gtk-theme Adwaita"
window-rule {
    match app-id="firefox"
    open-floating true
}
window-rule {
    match app-id="mpv"
    sway-border "pixel"
    sway-border-width 2
}
window-rule {
    match app-id="foot"
    open-floating true
    sway-border "none"
}
window-rule {
    match app-id="pavucontrol"
    open-floating true
}
window-rule {
    match app-id="browser"
    opacity 0.9
}
window-rule {
    match app-id="game"
    sway-for-window-command "shortcuts_inhibitor disable"
}
window-rule {
    match app-id="sharing"
    open-focused false
}
window-rule {
    match app-id="calendar"
    opacity 0.8
}
window-rule {
    match app-id="dialog"
    open-floating true
}
window-rule {
    match app-id="video"
    default-column-width { fixed 640; }
    default-window-height { fixed 480; }
}
