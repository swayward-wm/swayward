for_window [app_id="^demo$"] title_format %title %app_id %class %instance %shell %sandbox_engine %sandbox_app_id %sandbox_instance_id
==== sway-to-kdl golden: stdout ====
// Generated by sway-to-kdl.
// swayward uses typed nested KDL so its inherited effects and animations
// keep their full option sets. Review every sway-to-kdl comment below.

input {
    focus-follows-mouse
}

window-rule {
    match app-id="^demo$"
    sway-for-window-command "title_format %title %app_id %class %instance %shell %sandbox_engine %sandbox_app_id %sandbox_instance_id"
}
