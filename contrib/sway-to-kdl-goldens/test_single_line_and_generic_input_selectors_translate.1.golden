==== sway-to-kdl golden: input <tmp>/config ====
input type:keyboard xkb_layout us
input * xkb_options caps:escape
input type:pointer {
    accel_profile flat
    pointer_accel 0.3
    scroll_method on_button_down
}
input type:touchpad {
    click_method clickfinger
    drag enabled
    drag_lock enabled
    tap_button_map lrm
    scroll_factor .2
    scroll_button 274
}
==== sway-to-kdl golden: stdout ====
// Generated by sway-to-kdl.
// swayward uses typed nested KDL so its inherited effects and animations
// keep their full option sets. Review every sway-to-kdl comment below.

input {
    focus-follows-mouse
    keyboard {
        xkb {
            layout "us"
            options "caps:escape"
        }
    }
    mouse {
        accel-profile "flat"
        accel-speed 0.3
        scroll-method "on-button-down"
    }
    touchpad {
        click-method "clickfinger"
        drag true
        drag-lock
        tap-button-map "left-right-middle"
        scroll-factor 0.2
        scroll-button 274
    }
}
