==== sway-to-kdl golden: input <tmp>/config ====
include <tmp>/absolute
include nested
include ~/tilde
include fragments/*
set $file variable
include $file
==== sway-to-kdl golden: input <tmp>/absolute ====
bindsym Mod4+a nop absolute
==== sway-to-kdl golden: input <tmp>/fragments/one ====
bindsym Mod4+g nop glob
==== sway-to-kdl golden: input <tmp>/home/tilde ====
bindsym Mod4+t nop tilde
==== sway-to-kdl golden: input <tmp>/nested ====
include relative
==== sway-to-kdl golden: input <tmp>/relative ====
bindsym Mod4+r nop relative
==== sway-to-kdl golden: input <tmp>/variable ====
bindsym Mod4+v nop variable
==== sway-to-kdl golden: stdout ====
// Generated by sway-to-kdl.
// swayward uses typed nested KDL so its inherited effects and animations
// keep their full option sets. Review every sway-to-kdl comment below.

binds {
    Super+a { command "nop absolute"; }
    Super+r { command "nop relative"; }
    Super+t { command "nop tilde"; }
    Super+g { command "nop glob"; }
    Super+v { command "nop variable"; }
}

input {
    focus-follows-mouse
}
==== sway-to-kdl golden: stderr ====
manual attention: none
