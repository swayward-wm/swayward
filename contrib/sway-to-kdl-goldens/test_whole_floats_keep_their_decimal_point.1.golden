// Generated by sway-to-kdl.
// swayward uses typed nested KDL so its inherited effects and animations
// keep their full option sets. Review every sway-to-kdl comment below.

input {
    focus-follows-mouse
    mouse {
        accel-speed 1.0
        scroll-factor 2.0
    }
    touchpad {
        // sway-to-kdl: <tmp>/config:5: unhandled input directive: pointer_accel nan
    }
}

window-rule {
    match app-id="a"
    default-column-width { proportion 1.0; }
    default-window-height { proportion 0.5; }
}
