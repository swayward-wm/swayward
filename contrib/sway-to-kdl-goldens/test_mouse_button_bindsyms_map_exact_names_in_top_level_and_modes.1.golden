binds {
    MouseLeft { command "nop left"; }
    MouseMiddle { command "nop middle"; }
    MouseRight { command "nop right"; }
    WheelScrollUp { command "nop up"; }
    WheelScrollDown { command "nop down"; }
}

mode "test" {
    MouseLeft { command "nop mode-left"; }
}

input {
    focus-follows-mouse
}
