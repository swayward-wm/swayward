// Generated by sway-to-kdl.
// swayward uses typed nested KDL so its inherited effects and animations
// keep their full option sets. Review every sway-to-kdl comment below.

binds {
    Super+x { command "exec echo $HOME"; }
}

input {
    focus-follows-mouse
}

layout {
    floating-minimum-size 100 50
    smart-borders "no-gaps"
    focus-wrapping "yes"
}

// sway-to-kdl: <tmp>/config:5: floating size below -1 is unsupported: floating_maximum_size -2 x 10
// sway-to-kdl: <tmp>/config:7: expected smart_gaps on|off|inverse_outer: smart_gaps bogus
// sway-to-kdl: <tmp>/config:10: expected focus_on_window_activation smart|urgent|focus|none: focus_on_window_activation bogus
// sway-to-kdl: <tmp>/config:11: unsupported default border: default_border none 2
// sway-to-kdl: <tmp>/config:12: Expected 'exec <command>': exec --no-startup-id

workspace "1" {
    sway-output-assignment "DP-1" "HDMI-A-1"
}

workspace "2" {
    sway-output-assignment "DP-2"
}
