==== sway-to-kdl golden: stdout ====
// Generated by sway-to-kdl.
// swayward uses typed nested KDL so its inherited effects and animations
// keep their full option sets. Review every sway-to-kdl comment below.

input {
    focus-follows-mouse
}

window-rule {
    match app-id="foo"
    open-floating true
    default-column-width { fixed 760; }
    default-window-height { fixed 420; }
    sway-for-window-command "move position 75 ppt 75 ppt"
}
window-rule {
    match app-id="bar"
    open-floating true
    default-column-width { fixed 640; }
    default-window-height { fixed 480; }
    sway-for-window-command "move position 10px 20 px"
}
