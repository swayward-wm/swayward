// Generated by sway-to-kdl.
// swayward uses typed nested KDL so its inherited effects and animations
// keep their full option sets. Review every sway-to-kdl comment below.

input {
    focus-follows-mouse
}

window-rule {
    match app-id="a"
    open-floating false
}
window-rule {
    match app-id="b"
    default-column-display "tabbed"
}
window-rule {
    match app-id="c"
    opacity 0.25
}
// sway-to-kdl: <tmp>/config:4: opacity must be between 0 and 1: for_window [app_id="d"] opacity abc
// sway-to-kdl: <tmp>/config:5: opacity must be between 0 and 1: for_window [app_id="e"] opacity 2
window-rule {
    match app-id="f"
    open-on-workspace "3"
}
// sway-to-kdl: <tmp>/config:7: command needs manual conversion to window-rule properties: for_window [app_id="g"] resize set a ppt b ppt
// sway-to-kdl: <tmp>/config:8: resize size needs manual conversion: for_window [app_id="h"] resize set 0 ppt 0 ppt
// sway-to-kdl: <tmp>/config:9: command needs manual conversion to window-rule properties: for_window [app_id="i"] resize set 10 abc
window-rule {
    match app-id="j"
    opacity 0.8
}
window-rule {
    match app-id="k"
    geometry-corner-radius 5
    clip-to-geometry true
    background-effect {
        blur true
    }
    shadow {
        on
    }
}
window-rule {
    match app-id="l"
    background-effect {
        blur false
    }
    shadow {
        off
    }
}
