bindsym Mod1+Shift+a nop one
bindsym shift+Alt+A nop two
bindsym --locked Mod1+Shift+a nop locked
mode m {
    bindsym x nop x1
    bindsym --no-warn x nop x2
    bindsym y nop y
    bindsym y nop y
}
