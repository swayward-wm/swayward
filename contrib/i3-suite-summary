#!/usr/bin/env python3
"""Summarize the pinned oracle's swayward results and generate the doc blocks.

    contrib/i3-suite-summary [ORACLE]                 print the summary
    contrib/i3-suite-summary [ORACLE] --write [FILE...]  rewrite generated blocks
    contrib/i3-suite-summary [ORACLE] --check [FILE...]  exit 1 if a block is stale

FILE defaults to every published doc that embeds a block (DOCS below).

ORACLE defaults to .cache/sway-ipc-oracle (./contrib/fetch-oracle). --write and
--check require it to be checked out at the commit in tests/oracle.toml, so
every generated figure comes from committed results at the pin.

A generated block sits between

    <!-- i3-suite-summary:NAME generated from the pinned oracle; do not edit by hand -->
    <!-- end i3-suite-summary:NAME -->

NAME is `i3-suite` (swayward's i3-suite outcomes), `sway-ipc` (the sway IPC
corpora in full) or `sway-compat` (the README's front-page table: one row per
sway IPC corpus with swayward's `[run]` match and mismatch counts, plus
unstable and n.a. columns only when one is nonzero). --check fails when a block differs from its rendering, when a file
has no block, or when a block name is unknown.

The i3-suite figures use the oracle's stable filter (contrib/validate): every
assertion of a file listed in i3/flaky.toml counts as `flaky`, every assertion
listed for the compositor in i3/unstable.toml counts as `unstable`, and the
rest count as their recorded outcome. The six columns sum to the suite size.
The i3-suite table has a swayward row and a sway reference row from the same
oracle and the same filter; the sway IPC tables are swayward's, with sway's
replay of its own captures as the self-check.
Cells from a result listed in the oracle's pending.toml carry a dagger.
"""

import argparse
import collections
import re
import subprocess
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DEFAULT_ORACLE = ROOT / ".cache" / "sway-ipc-oracle"
ORACLE_URL = "https://github.com/swayward-wm/sway-ipc-oracle"
RAW = ["pass", "skip", "fail", "unreached", "unstable", "flaky"]
DAGGER = "†"
PENDING_NOTE = (
    f"{DAGGER} From a result listed in the oracle's `pending.toml`: it awaits "
    "regeneration, and the figure is its last measured value."
)
CORPORA = {
    "": "Hand-picked state scenarios",
    "events": "Events",
    "i3-derived": "i3-derived states",
    "random": "Random sequences",
    "command-fuzz": "Command fuzz",
    "wire-fuzz": "Wire fuzz",
}
# Front-page labels for the sway-compat block; {steps} comes from the run.
COMPAT = {
    "": "Hand-picked state scenarios",
    "events": "Event streams",
    "i3-derived": "States reached by i3's test sequences",
    "random": "Random {steps}-step sequences",
    "command-fuzz": "Malformed commands",
    "wire-fuzz": "Broken IPC framing",
}
# Published docs that embed generated blocks; --write and --check default to these.
DOCS = [
    "README.md",
    "docs/I3_SUITE_RESULTS.md",
    "docs/wiki/Testing-and-Conformance.md",
    "docs/RELEASE-NOTES-beta1.md",
]
BEGIN = "<!-- i3-suite-summary:{} generated from the pinned oracle; do not edit by hand -->"
END = "<!-- end i3-suite-summary:{} -->"
BLOCK = re.compile(
    r"^<!-- i3-suite-summary:(?P<name>[a-z0-9-]+) generated from the pinned oracle; "
    r"do not edit by hand -->\n(?P<body>.*?)^<!-- end i3-suite-summary:(?P=name) -->$",
    re.S | re.M,
)


def load(path):
    with path.open("rb") as file:
        return tomllib.load(file)


def n(value):
    return f"{value:,}"


def git_head(oracle):
    # A linked worktree has a .git text file, so ask Git rather than reading it.
    return subprocess.run(
        ["git", "-C", oracle, "rev-parse", "HEAD"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()


def pinned_commit():
    text = (ROOT / "tests" / "oracle.toml").read_text()
    return tomllib.loads(text)["commit"]


class Oracle:
    def __init__(self, path, swayward=None):
        self.path = path
        self.commit = git_head(path)
        self.pins = load(path / "pins.toml")
        self.snapshot = swayward or self.pins["snapshot"]["swayward"]
        self.reference = self.pins["snapshot"]["sway"]
        pending = path / "pending.toml"
        self.pending = (
            {row["path"] for row in load(pending).get("pending", [])}
            if pending.exists()
            else set()
        )
        result = path / "i3" / "results" / f"{self.snapshot}.toml"
        if not result.exists():
            raise SystemExit(f"snapshot does not exist: {result}")

    def mark(self, relative):
        return DAGGER if relative in self.pending else ""

    def i3_result(self):
        return f"i3/results/{self.snapshot}.toml"

    def stable_outcomes(self, compositor, name):
        """The oracle's stable filter: one raw outcome per assertion."""
        files = load(self.path / "i3" / "results" / f"{name}.toml")["files"]
        unstable = {
            (item["file"], number)
            for item in load(self.path / "i3" / "unstable.toml").get("unstable", [])
            if item["compositor"] == compositor
            for number in item["assertions"]
        }
        counts = collections.Counter()
        for file, entry in files.items():
            if entry.get("flaky"):
                counts["flaky"] += entry["assertions"]
                continue
            seen = set()
            for outcome in ("pass", "skip", "fail", "unreached"):
                for number in entry.get(f"{outcome}_assertions", []):
                    seen.add(number)
                    counts["unstable" if (file, number) in unstable else outcome] += 1
            if seen != set(range(1, entry["assertions"] + 1)):
                raise SystemExit(f"{name}: {file} outcomes do not cover its assertions")
        total = sum(entry["assertions"] for entry in files.values())
        if sum(counts.values()) != total:
            raise SystemExit(f"{name}: stable outcomes do not sum to {total}")
        return counts, total

    def review(self):
        path = self.path / "i3" / "classifications" / f"{self.snapshot}.toml"
        rows = load(path)["classification"]
        verified = sum(row.get("reason_verified") is True for row in rows)
        unclassified = sum(row.get("reason") == "unclassified" for row in rows)
        return len(rows), verified, unclassified

    def corpus(self, name, suffix):
        stem = f"{name}-{suffix}" if suffix else name
        relative = f"sway-ipc/results/{stem}.toml"
        path = self.path / relative
        if not path.exists():
            return None
        doc = load(path)
        rows = doc.get("result", [])
        verdicts = collections.Counter(
            row["verdict"].replace(" ", "_") for row in rows
        )
        run = doc["run"]
        for verdict, count in verdicts.items():
            if run.get(verdict, count) != count:
                raise SystemExit(f"{relative}: [run] {verdict} disagrees with its rows")
        reasons = collections.Counter(
            row.get("reason", "no reason recorded")
            for row in rows
            if row["verdict"].replace(" ", "_") == "not_applicable"
        )
        return {
            "relative": relative,
            "doc": doc,
            "verdicts": verdicts,
            "reasons": reasons,
            "mark": self.mark(relative),
        }

    def corpora(self):
        found = {
            path.stem.removeprefix(self.snapshot).lstrip("-")
            for path in (self.path / "sway-ipc" / "results").glob(f"{self.snapshot}*.toml")
            if path.stem == self.snapshot or path.stem.startswith(f"{self.snapshot}-")
        }
        known = [suffix for suffix in CORPORA if suffix in found]
        return known + sorted(found - set(CORPORA))

    def untriaged(self, suffix, result):
        """Measured mismatches with no triage row, by the oracle's rule."""
        stem = f"{self.snapshot}-{suffix}" if suffix else self.snapshot
        measured = set()
        for row in result["doc"].get("result", []):
            if row["verdict"] != "mismatch":
                continue
            if "seed" in row or "seeds" in row:
                measured.update(row.get("seeds") or [row["seed"]])
            elif "case" in row:
                measured.add(row["case"])
            else:
                measured.add(f"{row['scenario']}.{row['request']}")
        path = self.path / "sway-ipc" / "classifications" / f"{stem}.toml"
        if not path.exists():
            return len(measured)
        doc = load(path)
        triaged = set(doc.get("basis", {}).get("match", []))
        for row in doc.get("classification", []):
            for key in ("case", "rows", "seeds"):
                value = row.get(key)
                triaged.update(value if isinstance(value, list) else [value] if value else [])
        return len(measured - triaged)


def scope(suffix, result):
    run, rows = result["doc"]["run"], result["doc"].get("result", [])
    if "seeds" in run:
        return f"{n(run['seeds'])} seeds × {run['steps']} steps"
    if "cases" in run:
        return f"{n(run['cases'])} cases"
    scenarios = {row["scenario"] for row in rows}
    if suffix == "i3-derived":
        return f"{n(len(scenarios))} states, {n(len(rows))} rows"
    # A scenario can capture several named states (captures and probes), so
    # this counts captures; the oracle README counts scenario definitions.
    return f"{n(len(scenarios))} captures, {n(len(rows))} rows"


def render_i3_suite(oracle):
    commit = oracle.pins["swayward"][:8]
    version = oracle.reference.removeprefix("sway-")
    # One compositor per table (maintainer decision 2): sway's figures are in
    # its own block on the oracle's results page, linked below.
    rows = [("swayward", oracle.snapshot, f"swayward `{commit}`")]
    table, marks, size = [], [], None
    for compositor, name, label in rows:
        counts, total = oracle.stable_outcomes(compositor, name)
        if size not in (None, total):
            raise SystemExit(f"{name}: {total} assertions, swayward has {size}")
        size = total
        mark = oracle.mark(f"i3/results/{name}.toml")
        marks.append(mark)
        table.append(
            f"| {label} | " + " | ".join(n(counts[outcome]) + mark for outcome in RAW)
            + f" | {n(total)} |"
        )
    mark = marks[0]
    review, verified, unclassified = oracle.review()
    lines = [
        f"Oracle [`{oracle.commit[:8]}`]({ORACLE_URL}/tree/{oracle.commit}), swayward "
        f"snapshot `{oracle.snapshot}`, stable filter over {n(size)} assertions:",
        "",
        "| Compositor | " + " | ".join(RAW) + " | total |",
        "|---|" + " ---: |" * (len(RAW) + 1),
        *table,
        "",
        f"swayward review: {n(review)}{mark} non-pass rows; "
        f"{n(verified)}{mark} verified, {n(review - verified)}{mark} "
        f"unverified, {n(unclassified)}{mark} of them unclassified.",
    ]
    if (oracle.path / "docs" / "results.md").exists():
        lines += [
            "",
            "Each compositor, sway "
            f"{version} included, has its own block on the oracle's "
            f"[results page]({ORACLE_URL}/blob/{oracle.commit}/docs/results.md).",
        ]
    if any(marks):
        lines += ["", PENDING_NOTE]
    return "\n".join(lines)


def render_sway_ipc(oracle):
    reference = oracle.reference
    version = reference.removeprefix("sway-")
    lines = [
        f"Oracle [`{oracle.commit[:8]}`]({ORACLE_URL}/tree/{oracle.commit}), swayward "
        f"snapshot `{oracle.snapshot}`. The sway {version} column replays sway's own "
        "captures as a self-check.",
        "",
        f"| Corpus | Scope | sway {version} self-check | swayward match | swayward mismatch "
        "| swayward unstable | swayward n.a. |",
        "|---|---|---|---:|---:|---:|---:|",
    ]
    notes, pending, untriaged = [], [], []
    for suffix in oracle.corpora():
        result = oracle.corpus(oracle.snapshot, suffix)
        sway = oracle.corpus(reference, suffix)
        label = CORPORA.get(suffix, suffix)
        mark = result["mark"]
        if mark:
            pending.append(result["relative"])
        if sway is None:
            self_check = "not measured"
        else:
            v = sway["verdicts"]
            parts = [f"{n(v['match'])} match"]
            for key, word in (("mismatch", "mismatch"), ("unstable", "unstable"),
                              ("not_applicable", "n.a.")):
                if v[key]:
                    parts.append(f"{n(v[key])} {word}")
            self_check = ", ".join(parts) + sway["mark"]
            if sway["mark"]:
                pending.append(sway["relative"])
            for reason, count in sorted(sway["reasons"].items()):
                notes.append(f"- sway {version}, {label}: {n(count)} rows not applicable: {reason}.")
        v = result["verdicts"]
        for reason, count in sorted(result["reasons"].items()):
            notes.append(f"- swayward, {label}: {n(count)} rows not applicable: {reason}.")
        cells = [n(v[key]) + mark for key in ("match", "mismatch", "unstable", "not_applicable")]
        count = oracle.untriaged(suffix, result)
        if count:
            untriaged.append(f"{label} {n(count)}{mark}")
        lines.append(
            f"| {label} | {scope(suffix, result)} | {self_check} | " + " | ".join(cells) + " |"
        )
    classifications = "the oracle's `sway-ipc/classifications/`"
    if untriaged:
        sentence = (
            f"Swayward mismatches with no row yet in {classifications}: "
            + ", ".join(untriaged) + "."
        )
    else:
        sentence = f"Every swayward mismatch is classified in {classifications}."
    lines += ["", sentence]
    if notes:
        lines += [""] + notes
    if pending:
        lines += ["", PENDING_NOTE]
    return "\n".join(lines)


def render_sway_compat(oracle):
    """The front-page table: swayward's [run] counts per corpus, no totals."""
    version = oracle.reference.removeprefix("sway-")
    rows, pending = [], False
    for suffix in oracle.corpora():
        result = oracle.corpus(oracle.snapshot, suffix)
        run = result["doc"]["run"]
        counts = {key: run.get(key, 0) for key in ("match", "mismatch", "unstable",
                                                   "not_applicable")}
        label = COMPAT.get(suffix, suffix).format(steps=run.get("steps", ""))
        rows.append((label, counts, result["mark"]))
        pending = pending or bool(result["mark"])
    columns = [("match", "Match"), ("mismatch", "Mismatch")] + [
        (key, title)
        for key, title in (("unstable", "Unstable"), ("not_applicable", "n.a."))
        if any(counts[key] for _, counts, _ in rows)
    ]
    lines = [
        f"Swayward snapshot `{oracle.snapshot}` against sway {version}, from oracle "
        f"[`{oracle.commit[:8]}`]({ORACLE_URL}/tree/{oracle.commit}).",
        "",
        f"| Sway-compatibility corpus (reference: sway {version}) | "
        + " | ".join(title for _, title in columns) + " |",
        "|---|" + "---:|" * len(columns),
    ]
    for label, counts, mark in rows:
        lines.append(
            f"| {label} | " + " | ".join(n(counts[key]) + mark for key, _ in columns) + " |"
        )
    if pending:
        lines += ["", PENDING_NOTE]
    return "\n".join(lines)


RENDERERS = {
    "i3-suite": render_i3_suite,
    "sway-ipc": render_sway_ipc,
    "sway-compat": render_sway_compat,
}


def rewrite(text, oracle, path):
    """Return (new text, problems) with every generated block re-rendered."""
    problems = []
    found = list(BLOCK.finditer(text))
    if not found:
        problems.append(f"{path}: no generated i3-suite-summary block")
    rendered = {}

    def replace(match):
        name = match["name"]
        if name not in RENDERERS:
            problems.append(f"{path}: unknown generated block {name!r}")
            return match[0]
        if name not in rendered:
            rendered[name] = RENDERERS[name](oracle)
        body = rendered[name] + "\n"
        if match["body"] != body:
            problems.append(f"{path}: generated block {name!r} differs from the pinned oracle")
        return BEGIN.format(name) + "\n" + body + END.format(name)

    return BLOCK.sub(replace, text), problems


def display(path):
    path = Path(path).resolve()
    return path.relative_to(ROOT) if path.is_relative_to(ROOT) else path


def summary(oracle):
    print(f"oracle commit: {oracle.commit}")
    print(f"swayward snapshot: {oracle.snapshot} ({oracle.pins['swayward']})")
    for compositor, name in oracle.pins["snapshot"].items():
        # The oracle pins compositors (swayfx, scroll, ...) that only have
        # sway IPC results; the i3 suite runs against some of them only.
        if not (oracle.path / "i3" / "results" / f"{name}.toml").exists():
            continue
        counts, total = oracle.stable_outcomes(compositor, name)
        mark = oracle.mark(f"i3/results/{name}.toml")
        figures = ", ".join(f"{counts[outcome]:,} {outcome}" for outcome in RAW)
        print(f"i3 suite, {name}{mark}: {figures} (of {total:,})")
    rows, verified, unclassified = oracle.review()
    print(
        f"classification: {rows:,} non-pass rows, {verified:,} verified, "
        f"{unclassified:,} unclassified"
    )
    print("sway IPC corpora:")
    for suffix in oracle.corpora():
        result = oracle.corpus(oracle.snapshot, suffix)
        v = result["verdicts"]
        print(
            f"  {suffix or 'hand-picked'}{result['mark']}: {v['match']:,} match, "
            f"{v['mismatch']:,} mismatch, {v['unstable']:,} unstable, "
            f"{v['not_applicable']:,} not applicable, "
            f"{oracle.untriaged(suffix, result):,} untriaged"
        )


def main():
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("oracle", type=Path, nargs="?", default=DEFAULT_ORACLE,
                        help="sway-ipc-oracle checkout (default: .cache/sway-ipc-oracle)")
    parser.add_argument("--swayward", help="swayward snapshot label (default: pins.toml)")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--write", nargs="*", type=Path, metavar="FILE",
                      help="rewrite generated blocks (default: the published docs)")
    mode.add_argument("--check", nargs="*", type=Path, metavar="FILE",
                      help="fail on a stale generated block (default: the published docs)")
    args = parser.parse_args()

    if not (args.oracle / "pins.toml").exists():
        raise SystemExit(f"{args.oracle} is not an oracle checkout; run ./contrib/fetch-oracle")
    oracle = Oracle(args.oracle, args.swayward)
    files = args.write if args.write is not None else args.check
    if files is None:
        summary(oracle)
        return 0
    writing = args.write is not None
    files = files or [ROOT / path for path in DOCS]
    if args.swayward and args.swayward != oracle.pins["snapshot"]["swayward"]:
        parser.error("--write and --check use the pinned swayward snapshot")
    pin = pinned_commit()
    if oracle.commit != pin:
        print(
            f"{args.oracle} is at {oracle.commit}, but tests/oracle.toml pins {pin}; "
            "run ./contrib/fetch-oracle",
            file=sys.stderr,
        )
        return 2
    failed = False
    for path in files:
        text = path.read_text()
        new, problems = rewrite(text, oracle, display(path))
        if writing:
            unknown = [p for p in problems if "differs" not in p]
            if unknown:
                print("\n".join(unknown), file=sys.stderr)
                failed = True
            elif new != text:
                path.write_text(new)
        elif problems:
            print("\n".join(problems), file=sys.stderr)
            failed = True
    if failed and not writing:
        print(
            "regenerate with ./contrib/i3-suite-summary --write",
            file=sys.stderr,
        )
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
